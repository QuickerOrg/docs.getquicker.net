{
  "key": "sys:customwindow",
  "slug": "customwindow",
  "legacySlug": "customwindow",
  "ownsLegacyContent": true,
  "name": "自定义窗口",
  "description": "创建和显示自定义窗口",
  "category": "Ui",
  "categoryName": "界面组件",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/customwindow",
  "inputs": [
    {
      "key": "type",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "ShowAndWaitClose",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "windowMarkup",
      "name": "窗口XAML代码",
      "type": "Text",
      "description": "窗口定义XAML代码",
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "<Window xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\r\n        xmlns:d=\"http://schemas.microsoft.com/expression/blend/2008\"\r\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\r\n        xmlns:hc=\"https://handyorg.github.io/handycontrol\"\r\n        xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\"\r\n        xmlns:qk=\"https://getquicker.net\"\r\n        Width=\"637\"\r\n        Height=\"556\"\r\n        Title=\"Test Window\"\r\n        mc:Ignorable=\"d\">\r\n  <Grid Margin=\"10\">\r\n    <StackPanel>\r\n      <TextBlock Margin=\"10,50,10,50\" Text=\"Hello World！\" FontSize=\"20\" />\r\n     \r\n      <Button Margin=\"10\" qk:Att.Action=\"close:result\" Style=\"{StaticResource ButtonPrimary}\" Width=\"50\">\r\n        关闭\r\n      </Button>\r\n    </StackPanel>\r\n  </Grid>\r\n</Window>",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "dataMapping",
      "name": "数据映射",
      "type": "Text",
      "description": "将变量与窗口上下文数据进行映射。每行一个，格式为:\"窗口数据项名称:{动作变量名}\" 或 \"窗口数据项:=表达式\"",
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "events",
      "name": "事件",
      "type": "Text",
      "description": "详细说明请参考模块文档",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "cscode",
      "name": "辅助C#代码",
      "type": "Text",
      "description": "辅助处理窗口事件的代码，详见文档。",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "csReference",
      "name": "辅助C#引用DLL库",
      "type": "Text",
      "description": "辅助 C# 代码要引用的 DLL 文件，每行一个。也可以在代码中使用 #r 指令。",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowId",
      "name": "窗口标识",
      "type": "Text",
      "description": "如需单独的步骤关闭窗口，需使用标识查找窗口。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "autoCloseTime",
      "name": "自动关闭时间(S)",
      "type": "Number",
      "description": "自动关闭窗口的时间（秒数）。需大于0.5秒。",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "winLocation",
      "name": "窗口位置",
      "type": "Enum",
      "description": "窗口显示的位置",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "CenterScreen",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "mouseOffset",
      "name": "鼠标定位偏移",
      "type": "Text",
      "description": "仅用于跟随鼠标。填写水平、垂直偏移（逻辑像素），如 10,10 表示向右、向下各偏移 10；负数反向，留空使用默认位置。",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "winSize",
      "name": "窗口尺寸/位置",
      "type": "Text",
      "description": "最大宽度,高度：逻辑像素或屏幕工作区百分比；自定义位置填坐标。",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "activateMode",
      "name": "激活模式",
      "type": "Enum",
      "isAdvanced": true,
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "AutoActivate",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "closeWhenDeactivate",
      "name": "失去焦点后关闭窗口",
      "type": "Text",
      "description": "仅在窗口支持激活（获取焦点）的情况下有效。",
      "validForList": [
        "ShowAndWaitClose",
        "Show"
      ],
      "condition": "仅：ShowAndWaitClose, Show",
      "defaultValue": "false",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "result",
      "name": "窗口结果",
      "type": "Text",
      "description": "通过close:result返回的结果",
      "validForList": [
        "ShowAndWaitClose",
        "Close"
      ],
      "condition": "仅：ShowAndWaitClose, Close"
    },
    {
      "key": "windowList",
      "name": "窗口对象列表",
      "type": "Object",
      "description": "IList<Window>对象",
      "validForList": [
        "GetWindows"
      ],
      "condition": "仅：GetWindows"
    },
    {
      "key": "windowHandle",
      "name": "窗口句柄",
      "type": "Integer",
      "validForList": [
        "Show"
      ],
      "condition": "仅：Show"
    },
    {
      "key": "windowLocation",
      "name": "关闭时窗口位置",
      "type": "Text",
      "validForList": [
        "ShowAndWaitClose"
      ],
      "condition": "仅：ShowAndWaitClose"
    }
  ],
