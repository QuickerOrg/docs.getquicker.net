{
  "code": "a10d3f7c-6eca-4a4e-16a8-08dd656169a1",
  "title": "简单翻译",
  "description": "使用Quicker提供的翻译接口对选中文本进行翻译。",
  "author": "CL",
  "revision": 0,
  "source": "https://getquicker.net/sharedaction?code=a10d3f7c-6eca-4a4e-16a8-08dd656169a1",
  "pulledAt": "2026-08-11T21:28:52.353Z",
  "variables": [
    {
      "name": "text",
      "type": "Text",
      "remark": "默认的文本变量"
    },
    {
      "name": "selectedText",
      "type": "Text"
    },
    {
      "name": "resultText",
      "type": "Text"
    }
  ],
  "steps": [
    {
      "key": "sys:getSelectedText",
      "inputs": {
        "format": "UnicodeText",
        "waitMs": "250",
        "repeat": "0",
        "trim": "0",
        "tryNoClipboard": "0",
        "useActionParam": "0",
        "stopIfFail": "1"
      },
      "outputs": {
        "output": "selectedText"
      }
    },
    {
      "key": "sys:translation",
      "inputs": {
        "operation": "single",
        "text": "{selectedText}",
        "srcLang": "Auto",
        "dstLang": "Auto",
        "vendor": "Quicker",
        "stopIfFail": "1"
      },
      "outputs": {
        "resultText": "resultText"
      }
    },
    {
      "key": "sys:showText",
      "inputs": {
        "type": "NO_WAIT",
        "text": "{resultText}",
        "title": "文本窗口",
        "autoCloseKey": "=",
        "topMost": "false",
        "stopIfFail": "1",
        "winLocation": "CenterScreen",
        "fontsize": "14",
        "enableEscClose": "true",
        "closeWhenLostFocus": "false",
        "showLineNum": "true",
        "autoWrap": "true",
        "showBuildInToolbar": "true",
        "copyWholeLine": "false",
        "caretPosition": "0",
        "updateIfExists": "0"
      }
    }
  ]
}
