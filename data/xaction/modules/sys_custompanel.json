{
  "key": "sys:custompanel",
  "slug": "custompanel",
  "legacySlug": "custompanel",
  "ownsLegacyContent": true,
  "name": "自定义操作窗",
  "description": "自定义悬浮操作窗口，点击后直接执行操作，不隐藏。",
  "category": "Ui",
  "categoryName": "界面组件",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/custompanel",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "show_fixed_panel_wait_close",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "operationData",
      "name": "操作项定义",
      "type": "Text",
      "description": "可以为Json/菜单文本格式/IList<CommonOperationItem>对象，详情请参考文档",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "defaultOperation",
      "name": "默认Operation",
      "type": "Text",
      "description": "默认的Operation值或参数组合。提供此值时，操作项可以直接通过\"[图标]标题(提示)|data\"的形式定义。",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "spacingStr",
      "name": "按钮之间的间隔",
      "type": "Text",
      "description": "可选格式1：5 => 四个边都是5；格式2：10,5 => 左右10，上下5; ",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "5",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "buttonPadding",
      "name": "按钮内边距",
      "type": "Text",
      "description": "格式1：5 => 四个边都是5；格式2：10,5 => 左右10，上下5; 格式3：7,8,9,10 => 分别指定左上右下4边边距。",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "10,6",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "columnCount",
      "name": "列数",
      "type": "Integer",
      "description": "按钮排列方式为固定列数时，指定列数。0表示自动。",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "2",
      "defaultValueRaw": 2,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "columnWidth",
      "name": "列宽",
      "type": "Integer",
      "description": "固定列宽时使用。0表示自动列宽，-1表示不对齐宽度，各子项根据内容自动调整宽度。",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "groupMode",
      "name": "分组方式",
      "type": "Enum",
      "description": "当包含子项时，第一级节点作为分组，第二级节点作为按钮。",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "heading",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "selectGroup",
      "name": "选择标签分组",
      "type": "Text",
      "description": "标签页分组时切换至设定的标签页标题，留空表示默认。",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "title",
      "name": "操作窗标题",
      "type": "Text",
      "description": "标题文字，或\"[图标]标题\"格式。",
      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowId",
      "name": "窗口标识",
      "type": "Text",
      "description": "如需单独的步骤关闭窗口，需使用标识查找窗口。可使用\"=\"表示当前动作ID。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "winLocation",
      "name": "窗口位置",
      "type": "Enum",
      "description": "在哪里显示选择窗口",
