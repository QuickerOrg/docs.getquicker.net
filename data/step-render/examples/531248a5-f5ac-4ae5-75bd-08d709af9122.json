{
  "code": "531248a5-f5ac-4ae5-75bd-08d709af9122",
  "title": "示例：状态存储",
  "description": "状态存储读取和保存",
  "author": "wzq",
  "revision": 0,
  "source": "https://getquicker.net/sharedaction?code=531248a5-f5ac-4ae5-75bd-08d709af9122",
  "pulledAt": "2026-08-11T21:42:32.823Z",
  "variables": [
    {
      "name": "context",
      "type": "Text",
      "remark": "默认的文本变量"
    },
    {
      "name": "img",
      "type": "Image",
      "remark": "默认的图片变量"
    },
    {
      "name": "num",
      "type": "Number"
    },
    {
      "name": "filename",
      "type": "Text"
    }
  ],
  "steps": [
    {
      "key": "sys:stateStorage",
      "inputs": {
        "type": "readActionState",
        "key": "filenum",
        "defaultValue": "0",
        "inputIfEmpty": "0"
      },
      "outputs": {
        "value": "num"
      }
    },
    {
      "key": "sys:compute",
      "inputs": {
        "expression": "$${num}+1"
      },
      "outputs": {
        "output": "num"
      }
    },
    {
      "key": "sys:stateStorage",
      "inputs": {
        "type": "saveActionState",
        "key": "filenum",
        "value": "{num}",
        "inputIfEmpty": "0"
      }
    },
    {
      "key": "sys:outputText",
      "inputs": {
        "content": "$$filename{num}",
        "method": "paste",
        "appendReturn": "0"
      }
    }
  ]
}
