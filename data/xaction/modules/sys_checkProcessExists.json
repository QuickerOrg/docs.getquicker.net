{
  "key": "sys:checkProcessExists",
  "slug": "checkprocessexists",
  "legacySlug": "checkprocessexists",
  "ownsLegacyContent": true,
  "name": "检查程序已启动/获取进程信息",
  "description": "检查指定的应用程序是否已经启动。",
  "category": "System",
  "categoryName": "Windows系统",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/checkprocessexists",
  "inputs": [
    {
      "key": "process",
      "name": "进程名称/pid",
      "type": "Text",
      "description": "请输入要检查的进程名或pid。进程名通常为程序文件名去掉.exe后缀。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "操作是否成功",
      "type": "Boolean",
      "description": "可能会因为无法访问高权限进程等原因而失败。进程未启动不会导致操作失败。"
    },
    {
      "key": "isExists",
      "name": "是否运行",
      "type": "Boolean",
      "description": "指定的进程是否运行。如果已运行，返回True，否则返回False"
    },
    {
      "key": "pid",
      "name": "进程ID",
      "type": "Integer",
      "description": "找到的第一个匹配进程的ID"
    },
    {
      "key": "pidList",
      "name": "所有进程ID列表",
      "type": "List",
      "description": "具有相同进程名的所有进程的ID列表"
    },
    {
      "key": "path",
      "name": "程序路径",
      "type": "Text",
      "description": "进程的应用程序路径"
    },
    {
      "key": "mainWinHandle",
      "name": "主窗口句柄",
      "type": "Integer"
    },
    {
      "key": "mainwinTitle",
      "name": "主窗口标题",
      "type": "Text"
    },
    {
      "key": "startTime",
      "name": "启动时间",
      "type": "DateTime"
    }
  ],
  "sourceFileName": "catalog.json"
}
