{
  "key": "sys:select",
  "slug": "userselect",
  "legacySlug": "userselect",
  "ownsLegacyContent": true,
  "name": "用户选择",
  "description": "请用户选择一个选项。",
  "category": "Basic",
  "categoryName": "基础",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/userselect",
  "inputs": [
    {
      "key": "type",
      "name": "类型",
      "type": "Enum",
      "defaultValue": "single",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "prompt",
      "name": "窗口标题",
      "type": "Text",
      "defaultValue": "请选择",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "note",
      "name": "提示信息",
      "type": "Text",
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "items",
      "name": "选项",
      "type": "Text",
      "description": "每行一个选项，格式为 \"文本\" 或 \"显示文本|值\"。如需显示图标，格式请参考文档。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "defaultValue",
      "name": "默认值",
      "type": "Text",
      "description": "预先选择的项",
      "validForList": [
        "single"
      ],
      "condition": "仅：single",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "defaultValueMulti",
      "name": "默认值",
      "type": "Text",
      "description": "多选时默认选项，每行一个",
      "validForList": [
        "multi"
      ],
      "condition": "仅：multi",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "winLocation",
      "name": "窗口位置",
      "type": "Enum",
      "description": "在哪里显示选择窗口",
      "defaultValue": "WithMouse1",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxWinSize",
      "name": "最大尺寸/位置坐标",
      "type": "Text",
      "description": "最大宽度,高度：逻辑像素或屏幕工作区百分比；自定义位置填坐标。",
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "keepLastPos",
      "name": "使用上次位置",
      "type": "Enum",
      "description": "重复显示选择窗口时，保持上次的显示位置。",
      "defaultValue": "1",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "autoCloseSeconds",
      "name": "自动关闭",
      "type": "Number",
      "description": "几秒后自动关闭选择窗口。0表示不自动关闭。",
      "isAdvanced": true,
      "defaultValue": "0.0",
      "defaultValueRaw": 0,
      "variableMode": "Input"
    },
    {
      "key": "noKeyboard",
      "name": "不使用焦点",
      "type": "Boolean",
      "description": "不抢占其他应用的焦点。此时无法使用键盘选择选项，只能用鼠标操作。",
      "isAdvanced": true,
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "closeOnDeactivated",
      "name": "失去焦点后关闭窗口（仅在使用焦点时有效）",
      "type": "Boolean",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "showFilter",
      "name": "启用筛选",
      "type": "Enum",
      "description": "是否显示筛选框。仅在且使用焦点时有效。",
      "defaultValue": "auto",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "filterContent",
      "name": "筛选内容",
      "type": "Text",
      "description": "预先显示的筛选内容",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "imeState",
      "name": "输入法状态",
      "type": "Enum",
      "description": "筛选框输入法状态",
      "isAdvanced": true,
      "defaultValue": "NO_CONTROL",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "restoreForeground",
      "name": "恢复活动窗口到弹出前",
      "type": "Boolean",
      "description": "将前台窗口还原为弹窗前的活动窗口。否则将会还原到最后一个活动窗口上。",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "allowOkWhenEmpty",
      "name": "允许不选择任何选项时点击确定",
      "type": "Boolean",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "enableQuickConfirm",
      "name": "启用快速确认（点击选项后立即确认选择并关闭窗口）",
      "type": "Boolean",
      "validForList": [
        "single"
      ],
      "condition": "仅：single",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "topMost",
      "name": "置顶显示",
      "type": "Boolean",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfCancel",
      "name": "取消后停止",
      "type": "Boolean",
      "description": "取消选择后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "operations",
      "name": "右键/全局菜单",
      "type": "Text",
      "description": "每行定义一个操作，具体格式请参考文档。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "fontsize",
      "name": "字体大小",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "12.0",
      "defaultValueRaw": 12,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "fontfamily",
      "name": "字体名称",
      "type": "Text",
      "description": "可选。设置字体名称。如有多个字体，使用逗号分隔。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "iconsize",
      "name": "图标大小",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "16.0",
      "defaultValueRaw": 16,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowKey",
      "name": "窗口标识",
      "type": "Text",
      "description": "再次运行动作时，可根据标识自动关闭前一个窗口并在该位置显示新窗口。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "help",
      "name": "帮助按钮内容",
      "type": "Text",
      "description": "点击弹出显示帮助内容，MarkDown格式",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否确认",
      "type": "Boolean",
      "description": "是否成功选择了选项/点击了保存按钮"
    },
    {
      "key": "textValue",
      "name": "选择的项(值)",
      "type": "Text",
      "description": "选中选项的值",
      "validForList": [
        "single"
      ],
      "condition": "仅：single"
    },
    {
      "key": "selectedIndex",
      "name": "索引号",
      "type": "Integer",
      "description": "选择的项在列表里的序号数字，从0开始。",
      "validForList": [
        "single"
      ],
      "condition": "仅：single"
    },
    {
      "key": "selectedIndexList",
      "name": "索引号列表",
      "type": "List",
      "description": "所有选择的项的序号列表",
      "validForList": [
        "multi"
      ],
      "condition": "仅：multi"
    },
    {
      "key": "multiSelected",
      "name": "选择的项值列表",
      "type": "List",
      "description": "所有选择的项的值的列表",
      "validForList": [
        "multi"
      ],
      "condition": "仅：multi"
    },
    {
      "key": "extraOperation",
      "name": "选择的菜单",
      "type": "Text",
      "description": "选择的右键菜单或全局菜单项的值"
    },
    {
      "key": "selectedFullItems",
      "name": "选择的完整选项",
      "type": "Any",
      "description": "选择选项的完整定义内容（不仅仅返回选项值）"
    },
    {
      "key": "selectedItemTitle",
      "name": "选择的选项标题",
      "type": "Text",
      "description": "所选中选项的标题",
      "validForList": [
        "single"
      ],
      "condition": "仅：single"
    },
    {
      "key": "filterContent",
      "name": "筛选内容",
      "type": "Text",
      "description": "最后使用的筛选词"
    }
  ],
  "selections": {
