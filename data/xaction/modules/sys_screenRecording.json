{
  "key": "sys:screenRecording",
  "slug": "screen-recording",
  "legacySlug": "screen-recording",
  "ownsLegacyContent": true,
  "name": "后台屏幕录制",
  "description": "后台录制屏幕区域为视频文件，通过会话 ID 跨步骤控制录制生命周期。",
  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/screen-recording",
  "inputs": [
    {
      "key": "operation",
      "name": "操作",
      "type": "Enum",
      "description": "录屏会话操作类型。",
      "defaultValue": "start",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "sessionId",
      "name": "会话 ID",
      "type": "Text",
      "description": "录屏会话标识（GUID）。开始录屏时留空将自动生成；暂停/继续/结束时必须提供。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "regionType",
      "name": "录制范围",
      "type": "Enum",
      "description": "要录制的屏幕区域类型。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "primary_screen",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "area",
      "name": "录制区域",
      "type": "Text",
      "description": "固定区域坐标，格式：left,top,right,bottom。默认不包含右边和底边像素。",
      "validForList": [
        "fixed_area"
      ],
      "invalidForList": [
        "pause",
        "resume",
        "stop"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "start"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "regionType",
            "operator": "In",
            "values": [
              "fixed_area"
            ]
          }
        ]
      },
      "condition": "(operation 为 \"start\" 且 regionType 为 \"fixed_area\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "includeRightBottomBorder",
      "name": "包含右下边像素",
      "type": "Boolean",
      "description": "包含时，0,0,2,2 表示 3×3 区域；否则为 2×2。",
      "validForList": [
        "fixed_area"
      ],
      "invalidForList": [
        "pause",
        "resume",
        "stop"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "start"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "regionType",
            "operator": "In",
            "values": [
              "fixed_area"
            ]
          }
        ]
      },
      "condition": "(operation 为 \"start\" 且 regionType 为 \"fixed_area\")",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "outputDirectory",
      "name": "输出文件夹路径",
      "type": "Text",
      "description": "成品写入该目录，文件名为 Recording_时间戳。留空且未指定旧「输出文件路径」时使用默认位置。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "outputFilePath",
      "name": "输出文件路径",
      "type": "Text",
      "description": "旧动作兼容：始终按文件规整，无扩展名仍是 clip.mp4。新动作请用「输出文件夹路径」。",
      "isAdvanced": true,
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "outputFormat",
      "name": "输出格式",
      "type": "Enum",
      "description": "录屏输出文件格式。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "mp4",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "exportQuality",
      "name": "导出画质",
      "type": "Enum",
      "description": "录屏导出画质：标准、高清或原始。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "standard",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "encodingPreset",
      "name": "编码方案",
      "type": "Enum",
      "description": "可选快捷配置，默认沿用原有画质；FFmpeg 参数可覆盖方案。",
      "isAdvanced": true,
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "start"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "outputFormat",
            "operator": "In",
            "values": [
              "mp4"
            ]
          }
        ]
      },
      "condition": "(operation 为 \"start\" 且 outputFormat 为 \"mp4\")",
      "defaultValue": "default",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "encodingParameters",
      "name": "FFmpeg 参数",
      "type": "Text",
      "description": "直接传给本机 FFmpeg，覆盖预设；留空沿用默认。例：-crf 20 -preset veryfast。",
      "isAdvanced": true,
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "start"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "outputFormat",
            "operator": "In",
            "values": [
              "mp4"
            ]
          }
        ]
      },
      "condition": "(operation 为 \"start\" 且 outputFormat 为 \"mp4\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "framesPerSecond",
      "name": "帧率",
      "type": "Integer",
      "description": "录制帧率，将自动规整到 10/15/24/30/60。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "30",
      "defaultValueRaw": 30,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "showCursor",
      "name": "显示鼠标光标",
      "type": "Boolean",
      "description": "是否在录制画面中显示鼠标光标。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "encodingStrategy",
      "name": "编码策略",
      "type": "Enum",
      "description": "边录边编码：录制时实时生成成品文件，停止后立即可用（需要 QuickerAvCodec）。先录后编码：先录制中间文件，停止后通过 ffmpeg 转码为目标格式，等待时间取决于录制时长和分辨率。",
      "isAdvanced": true,
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "encodeWhileRecording",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "returnImmediately",
      "name": "开始后立即返回",
      "type": "Boolean",
      "description": "启用后步骤在启动录制后立即成功返回；结束录屏请使用单独的结束步骤。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "delay",
      "name": "开始前延迟",
      "type": "Integer",
      "description": "等待多少毫秒后开始录制。",
      "validForList": [
        "start"
      ],
      "condition": "仅：start",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitForCompletion",
      "name": "等待编码完成",
      "type": "Boolean",
      "description": "结束录屏时是否等待文件写入完成。",
      "validForList": [
        "stop"
      ],
      "condition": "仅：stop",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "removeSessionAfterStop",
      "name": "结束后删除会话",
      "type": "Boolean",
      "description": "结束录屏成功后从会话注册表移除。",
      "validForList": [
        "stop"
      ],
      "condition": "仅：stop",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "addToHistory",
      "name": "加入录屏历史",
      "type": "Boolean",
      "description": "结束录屏时显式将成品复制到本机录屏历史。后台录屏默认不加入历史。",
      "isAdvanced": true,
      "validForList": [
        "stop"
      ],
      "condition": "仅：stop",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "sessionIdOut",
      "name": "会话 ID",
      "type": "Text",
      "description": "录屏会话标识，供后续暂停/继续/结束步骤使用。"
    },
    {
      "key": "filePath",
      "name": "文件路径",
      "type": "Text",
      "description": "录制完成的视频文件路径。"
    },
    {
      "key": "durationSeconds",
      "name": "录制时长",
      "type": "Number",
      "description": "录制时长（秒）。"
    },
    {
      "key": "rect",
      "name": "录制区域",
      "type": "Text",
      "description": "实际录制区域(left,top,right,bottom)。"
    },
    {
      "key": "errMessage",
      "name": "错误消息",
      "type": "Text",
      "description": "步骤执行出错时的消息"
    }
  ],
  "selections": {
    "operation": {
      "name": "操作",
      "items": [
        {
          "value": "start",
          "name": "开始录屏"
        },
        {
