      "key": "sendMessage",
      "name": "消息内容",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：SendMessage",
      "description": "Json格式的消息内容。词典变量会自动转换成json。"
    },
    {
      "key": "additionalObjects",
      "name": "附加对象",
      "type": "List",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：SendMessage",
      "description": "PostWebMessageAsJson的附加对象列表参数内容。目前支持路径的列表"
    },
