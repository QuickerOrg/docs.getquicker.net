{
  "key": "sys:getSelectedFiles",
  "slug": "getselectedfiles",
  "legacySlug": "getselectedfiles",
  "ownsLegacyContent": true,
  "name": "获取选择的文件(夹)/选择特定文件",
  "description": "获取资源管理器、桌面等位置选择的文件或文件夹的路径",
  "category": "System",
  "categoryName": "Windows系统",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/getselectedfiles",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "getSelection",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "waitMs",
      "name": "等待剪贴板时间",
      "type": "Integer",
      "description": "通过复制方式获取选择文件时，等待剪贴板变化的最长时间毫秒数。",
      "validForList": [
        "getSelection"
      ],
      "condition": "仅：getSelection",
      "defaultValue": "200",
      "defaultValueRaw": 200,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "sortType",
      "name": "排序文件列表",
      "type": "Enum",
      "description": "获取多个文件时，根据需要可以对文件列表进行排序。仅支持文件。",
      "validForList": [
        "getSelection"
      ],
      "condition": "仅：getSelection",
      "defaultValue": "Default",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "pathList",
      "name": "路径或文件名",
      "type": "Text",
      "description": "要选中的路径或文件名。支持使用 \"regex:表达式\" \"pinyin:筛选\" 选择匹配的文件。",
      "validForList": [
        "setSelection"
      ],
      "condition": "仅：setSelection",
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "winHandle",
      "name": "指定窗口句柄",
      "type": "Integer",
      "description": "指定要操作的资源管理器窗口，留空时表示前台窗口。（仅支持资源管理器）",
      "isAdvanced": true,
      "validForList": [
        "setSelection"
      ],
      "condition": "仅：setSelection",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后中止动作",
      "type": "Boolean",
      "description": "获取失败后，是否停止后续动作的执行。",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "是否成功获得文件列表"
    },
    {
      "key": "files",
      "name": "路径列表",
      "type": "List",
      "description": "所有选中的文件和文件夹的路径列表",
      "validForList": [
        "getSelection"
      ],
      "condition": "仅：getSelection"
    },
    {
      "key": "firstFile",
      "name": "首个路径",
      "type": "Text",
      "description": "选择1个文件(夹)时，返回其路径；选择多个时，返回第一个的路径。",
      "validForList": [
        "getSelection"
      ],
      "condition": "仅：getSelection"
    },
    {
      "key": "fileNames",
      "name": "文件(夹)名列表",
      "type": "List",
      "description": "所有选中的文件和文件夹的名称的列表（不包含所在路径）",
      "validForList": [
        "getSelection"
      ],
      "condition": "仅：getSelection"
    },
    {
      "key": "firstFileName",
      "name": "首个文件(夹)名",
      "type": "Text",
      "description": "选择1个文件(夹)时，返回其名称；选择多个时，返回第一个的名称。",
      "validForList": [
        "getSelection"
      ],
      "condition": "仅：getSelection"
    },
    {
      "key": "fileCount",
      "name": "文件个数",
      "type": "Integer",
      "description": "选择的文件个数",
      "validForList": [
        "getSelection",
        "setSelection"
      ],
      "condition": "仅：getSelection, setSelection"
    }
  ],
  "selections": {
