{
  "key": "sys:form",
  "slug": "form",
  "legacySlug": "form",
  "ownsLegacyContent": true,
  "name": "多字段表单",
  "description": "使用表单窗口编辑多个变量的值。",
  "category": "Ui",
  "categoryName": "界面组件",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/form",
  "inputs": [
    {
      "key": "operation",
      "name": "工作模式",
      "type": "Enum",
      "description": "工作模式：编辑某个词典的值，或编辑一些变量的值",
      "defaultValue": "variables",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "dictVar",
      "name": "词典变量",
      "type": "Dict",
      "description": "表单需要编辑的词典变量",
      "validForList": [
        "dict",
        "dict_dynamic"
      ],
      "condition": "仅：dict, dict_dynamic",
      "defaultValue": "",
      "variableMode": "UseVarOnly"
    },
    {
      "key": "title",
      "name": "窗口标题",
      "type": "Text",
      "description": "表单窗口标题文字",
      "defaultValue": "填写表单",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "formDef",
      "name": "表单定义",
      "type": "Form",
      "validForList": [
        "variables"
      ],
      "condition": "仅：variables",
      "defaultValue": "",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "formForDictDef",
      "name": "表单定义(词典)",
      "type": "FormForDict",
      "validForList": [
        "dict"
      ],
      "condition": "仅：dict",
      "defaultValue": "",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "dynamicFormForDictDef",
      "name": "表单定义(词典)",
      "type": "Text",
      "description": "JSON格式的表单定义数据。格式说明请参考模块文档。",
      "validForList": [
        "dict_dynamic"
      ],
      "condition": "仅：dict_dynamic",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "help",
      "name": "提示文字",
      "type": "Text",
      "description": "帮助用户填写表单的提示文字。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "titleColumnWidth",
      "name": "标题列宽度",
      "type": "Number",
      "description": "逻辑像素；负数表示自适应列宽的上限。",
      "defaultValue": "100",
      "defaultValueRaw": 100,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowWidth",
      "name": "窗口宽度",
      "type": "Number",
      "description": "逻辑像素，最小400。",
      "defaultValue": "500",
      "defaultValueRaw": 500,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "defaultInputWidth",
      "name": "输入框默认宽度",
      "type": "Number",
      "description": "逻辑像素，0表示自动宽度。",
      "isAdvanced": true,
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowHeight",
      "name": "窗口最大高度",
      "type": "Number",
      "description": "逻辑像素，0表示默认。设置时请填写大于100的值。",
      "defaultValue": "0",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "topMost",
      "name": "置顶显示",
      "type": "Boolean",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "restoreFocus",
      "name": "恢复活动窗口",
      "type": "Boolean",
      "description": "用户输入后，是否将焦点还原到之前的活动窗口",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "markdownhelp",
      "name": "帮助按钮内容",
      "type": "Text",
      "description": "点击弹出显示帮助内容，MarkDown格式。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "confirm",
      "name": "自定义“确定”按钮标题",
      "type": "Text",
      "description": "仅在需要时填写。使用\"_字符\"的形式定义触发字符,如\"_S\"表示Alt+S可直接触发按钮",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "customButtons",
      "name": "自定义按钮",
      "type": "Text",
      "description": "使用\"标题|返回值\"的形式定义按钮，多个按钮用换行分隔。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "selectedGroup",
      "name": "选择的分组",
      "type": "Text",
      "description": "使用分组标签页时，默认选择的分组。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "disableEnterSubmit",
      "name": "关闭Enter提交表单功能",
      "type": "Boolean",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "winLocation",
      "name": "窗口位置类型",
      "type": "Enum",
      "description": "在哪里显示选择窗口",
      "isAdvanced": true,
      "defaultValue": "CenterScreen",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "winSize",
      "name": "位置",
      "type": "Text",
      "description": "自定义位置：left,top,right,bottom；物理像素或屏幕工作区百分比。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "取消后停止",
      "type": "Boolean",
      "description": "取消后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "button",
      "name": "点击的按钮",
      "type": "Text",
      "description": "默认的确认按钮返回值为空，自定义按钮返回值为自定义的值。"
    },
    {
      "key": "selectedGroup",
      "name": "选择的分组",
      "type": "Text",
      "description": "关闭时所选择的标签页分组。"
    }
  ],
  "selections": {
