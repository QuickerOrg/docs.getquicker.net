{
  "key": "sys:cinema4dcontrol",
  "slug": "cinema4dcontrol",
  "legacySlug": "cinema4dcontrol",
  "ownsLegacyContent": true,
  "name": "Cinema 4D控制",
  "description": "通过 Cinema 4D Python 插件发送命令；仅有一个在线连接时直接使用，多个连接时按动作触发窗口定位。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/cinema4dcontrol",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "document.get_context",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "recursive",
      "name": "递归读取子对象",
      "type": "Boolean",
      "validForList": [
        "object.list"
      ],
      "condition": "仅：object.list",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "maxDepth",
      "name": "最大层级深度",
      "type": "Integer",
      "validForList": [
        "object.list"
      ],
      "condition": "仅：object.list",
      "defaultValue": "20",
      "defaultValueRaw": 20,
      "variableMode": "Input"
    },
    {
      "key": "includeTransform",
      "name": "返回对象变换",
      "type": "Boolean",
      "validForList": [
        "object.list"
      ],
      "condition": "仅：object.list",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "includeChildren",
      "name": "包含层级中的子对象",
      "type": "Boolean",
      "validForList": [
        "selection.select_all",
        "selection.invert"
      ],
      "condition": "仅：selection.select_all, selection.invert",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "objectRefsJson",
      "name": "对象引用(JSON 数组)",
      "type": "Text",
      "description": "引用可从读取对象层级或选择详情的 ref 字段取得。",
      "validForList": [
        "selection.select_by_refs"
      ],
      "condition": "仅：selection.select_by_refs",
      "defaultValue": "[]",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "selectionMode",
      "name": "选择方式",
      "type": "Text",
      "description": "replace、add 或 remove。",
      "validForList": [
        "selection.select_by_refs"
      ],
      "condition": "仅：selection.select_by_refs",
      "defaultValue": "replace",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "primitiveType",
      "name": "对象类型",
      "type": "Text",
      "description": "首版支持 cube、sphere、cylinder、cone、plane、torus。",
      "validForList": [
        "object.create_primitive"
      ],
      "condition": "仅：object.create_primitive",
      "defaultValue": "cube",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "objectName",
      "name": "对象名称",
      "type": "Text",
      "validForList": [
        "object.create_primitive"
      ],
      "condition": "仅：object.create_primitive",
      "defaultValue": "Quicker Object",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "renamePattern",
      "name": "重命名模板",
      "type": "Text",
      "description": "支持 {oldName} 和 {index}，例如 Obj_{index:03d}。",
      "validForList": [
        "object.rename_selected"
      ],
      "condition": "仅：object.rename_selected",
      "defaultValue": "{oldName}_{index:02d}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "startIndex",
      "name": "起始编号",
      "type": "Integer",
      "validForList": [
        "object.rename_selected"
      ],
      "condition": "仅：object.rename_selected",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "Input"
    },
    {
      "key": "offsetX",
      "name": "移动 X",
      "type": "Number",
      "validForList": [
        "object.move_selected"
      ],
      "condition": "仅：object.move_selected",
      "defaultValue": "100",
      "defaultValueRaw": 100,
      "variableMode": "Input"
    },
    {
      "key": "offsetY",
      "name": "移动 Y",
      "type": "Number",
      "validForList": [
        "object.move_selected"
      ],
      "condition": "仅：object.move_selected",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "Input"
    },
    {
      "key": "offsetZ",
      "name": "移动 Z",
      "type": "Number",
      "validForList": [
        "object.move_selected"
      ],
      "condition": "仅：object.move_selected",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "Input"
    },
    {
      "key": "coordinateSpace",
      "name": "坐标空间",
      "type": "Text",
      "description": "global 使用世界坐标；local 使用父级坐标。",
      "validForList": [
        "object.move_selected"
      ],
      "condition": "仅：object.move_selected",
      "defaultValue": "global",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandQuery",
      "name": "搜索内容",
      "type": "Text",
      "description": "按命令 ID、本地标题或帮助文本筛选；留空返回前若干项。",
      "validForList": [
        "command.search"
      ],
      "condition": "仅：command.search",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxCount",
      "name": "最多返回数量",
      "type": "Integer",
      "validForList": [
        "command.search"
      ],
      "condition": "仅：command.search",
      "defaultValue": "100",
      "defaultValueRaw": 100,
      "variableMode": "Input"
    },
    {
      "key": "commandIdentifier",
      "name": "命令 ID 或标题",
      "type": "Text",
      "description": "可填写数字 ID，或 command.search 返回的本地化标题；标题不唯一时会返回候选 ID。",
      "validForList": [
        "command.get_info",
        "command.call"
      ],
      "condition": "仅：command.get_info, command.call",
      "defaultValue": "13957",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "pythonCode",
      "name": "Python 代码",
      "type": "Text",
      "description": "表达式直接返回 value；脚本可把返回值赋给 result。",
      "validForList": [
        "python.evaluate",
        "python.execute"
      ],
      "condition": "仅：python.evaluate, python.execute",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "filePath",
      "name": "Python 文件路径",
      "type": "Text",
      "validForList": [
        "python.run_file"
      ],
      "condition": "仅：python.run_file",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandName",
      "name": "Bridge 命令名称",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "argumentsJson",
      "name": "参数(JSON 对象)",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitMs",
      "name": "最长等待时间(ms)",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "30000",
      "defaultValueRaw": 30000,
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
