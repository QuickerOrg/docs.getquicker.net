{
  "key": "sys:solidworkscontrol",
  "slug": "solidworkscontrol",
  "legacySlug": "solidworkscontrol",
  "ownsLegacyContent": true,
  "name": "SOLIDWORKS控制",
  "description": "通过 SOLIDWORKS Add-in 发送命令；仅有一个在线连接时直接使用，多个连接时按动作触发窗口定位。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/solidworkscontrol",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "document.get_context",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "searchQuery",
      "name": "搜索文字",
      "type": "Text",
      "validForList": [
        "command.search"
      ],
      "condition": "仅：command.search",
      "defaultValue": "zoom",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "searchLimit",
      "name": "最多返回数量",
      "type": "Integer",
      "validForList": [
        "command.search"
      ],
      "condition": "仅：command.search",
      "defaultValue": "50",
      "defaultValueRaw": 50,
      "variableMode": "Input"
    },
    {
      "key": "solidWorksCommandId",
      "name": "命令 ID",
      "type": "Integer",
      "description": "可先用“搜索 SOLIDWORKS 命令”获取 ID。",
      "validForList": [
        "command.call"
      ],
      "condition": "仅：command.call",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "Input"
    },
    {
      "key": "documentPath",
      "name": "文档路径",
      "type": "Text",
      "description": "打开文档时填写 .SLDPRT、.SLDASM 或 .SLDDRW 的绝对路径；激活文档时也可填写已打开文档的完整路径。",
      "validForList": [
        "document.open",
        "document.activate"
      ],
      "condition": "仅：document.open, document.activate",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "documentTitle",
      "name": "文档标题",
      "type": "Text",
      "description": "激活文档时路径为空才使用。建议包含扩展名，以免同名零件、装配体或工程图产生歧义。",
      "validForList": [
        "document.activate"
      ],
      "condition": "仅：document.activate",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "readOnly",
      "name": "只读打开",
      "type": "Boolean",
      "validForList": [
        "document.open"
      ],
      "condition": "仅：document.open",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "openConfiguration",
      "name": "打开配置",
      "type": "Text",
      "description": "可选；仅打开指定配置，留空使用文档默认配置。",
      "validForList": [
        "document.open"
      ],
      "condition": "仅：document.open",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "activateRebuild",
      "name": "激活时重建",
      "type": "Boolean",
      "validForList": [
        "document.activate"
      ],
      "condition": "仅：document.activate",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "filePath",
      "name": "输出文件路径",
      "type": "Text",
      "description": "使用绝对路径，文件扩展名决定 SOLIDWORKS 保存或导出格式。",
      "validForList": [
        "document.save_as",
        "document.export",
        "drawing.export_pdf"
      ],
      "condition": "仅：document.save_as, document.export, drawing.export_pdf",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "overwriteFile",
      "name": "允许覆盖已有文件",
      "type": "Boolean",
      "validForList": [
        "document.save_as",
        "document.export",
        "drawing.export_pdf"
      ],
      "condition": "仅：document.save_as, document.export, drawing.export_pdf",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "exportScope",
      "name": "导出范围",
      "type": "Text",
      "description": "entire 导出整个模型并先清空选择；selection 只导出当前选择。",
      "validForList": [
        "document.export"
      ],
      "condition": "仅：document.export",
      "defaultValue": "entire",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "topOnly",
      "name": "仅重建顶层装配体",
      "type": "Boolean",
      "validForList": [
        "document.rebuild"
      ],
      "condition": "仅：document.rebuild",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "undoSteps",
      "name": "撤销步数",
      "type": "Integer",
      "validForList": [
        "document.undo"
      ],
      "condition": "仅：document.undo",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "Input"
    },
    {
      "key": "selectionName",
      "name": "对象名称",
      "type": "Text",
      "validForList": [
        "selection.select_by_name"
      ],
      "condition": "仅：selection.select_by_name",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "selectionType",
      "name": "对象类型",
      "type": "Text",
      "description": "例如 COMPONENT、BODYFEATURE、FACE；留空时由 SOLIDWORKS 尝试匹配。",
      "validForList": [
        "selection.select_by_name"
      ],
      "condition": "仅：selection.select_by_name",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "appendSelection",
      "name": "追加到当前选择",
      "type": "Boolean",
      "validForList": [
        "selection.select_by_name"
      ],
      "condition": "仅：selection.select_by_name",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "includeSuppressed",
      "name": "包含抑制特征",
      "type": "Boolean",
      "validForList": [
        "feature.list"
      ],
      "condition": "仅：feature.list",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "featureNamesJson",
      "name": "特征名称(JSON 数组)",
      "type": "Text",
      "description": "例如 [\"Boss-Extrude1\",\"Cut-Extrude1\"]；会先确认所有目标唯一存在，再开始修改。",
      "validForList": [
        "feature.set_suppression"
      ],
      "condition": "仅：feature.set_suppression",
      "defaultValue": "[]",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "suppressionState",
      "name": "目标状态",
      "type": "Text",
      "description": "suppressed 或 resolved。",
      "validForList": [
        "feature.set_suppression"
      ],
      "condition": "仅：feature.set_suppression",
      "defaultValue": "suppressed",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "suppressionScope",
      "name": "配置范围",
      "type": "Text",
      "description": "current 仅当前配置；all 作用于全部配置。",
      "validForList": [
        "feature.set_suppression"
      ],
      "condition": "仅：feature.set_suppression",
      "defaultValue": "current",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "configurationName",
      "name": "配置名称",
      "type": "Text",
      "validForList": [
        "configuration.activate"
      ],
      "condition": "仅：configuration.activate",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "propertyConfiguration",
      "name": "属性配置",
      "type": "Text",
      "description": "留空表示文档级属性；填写配置名称表示配置专用属性。",
      "validForList": [
        "property.list",
        "property.set",
        "property.delete"
      ],
      "condition": "仅：property.list, property.set, property.delete",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "propertyName",
      "name": "属性名称",
      "type": "Text",
      "validForList": [
        "property.set",
        "property.delete"
      ],
      "condition": "仅：property.set, property.delete",
      "defaultValue": "Description",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "propertyValue",
      "name": "属性值",
      "type": "Text",
      "validForList": [
        "property.set"
      ],
      "condition": "仅：property.set",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "topLevelOnly",
      "name": "仅顶层零部件",
      "type": "Boolean",
      "validForList": [
        "assembly.list_components"
      ],
      "condition": "仅：assembly.list_components",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "drawingSheetName",
      "name": "图纸页名称",
      "type": "Text",
      "validForList": [
        "drawing.activate_sheet"
      ],
      "condition": "仅：drawing.activate_sheet",
      "defaultValue": "Sheet1",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "drawingSheets",
      "name": "PDF 图纸页范围",
      "type": "Text",
      "description": "all、current，或 JSON 名称数组，例如 [\"Sheet1\",\"Sheet2\"]。",
      "validForList": [
        "drawing.export_pdf"
      ],
      "condition": "仅：drawing.export_pdf",
      "defaultValue": "all",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "standardView",
      "name": "标准视图",
      "type": "Text",
      "description": "front、back、left、right、top、bottom、isometric、trimetric 或 dimetric。",
      "validForList": [
        "view.standard"
      ],
      "condition": "仅：view.standard",
      "defaultValue": "isometric",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "macroPath",
      "name": "宏文件路径",
      "type": "Text",
      "description": "支持 SOLIDWORKS VBA .swp 或编译后的 VSTA 宏 DLL。",
      "validForList": [
        "macro.run"
      ],
      "condition": "仅：macro.run",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "macroModule",
      "name": "宏模块",
      "type": "Text",
      "validForList": [
        "macro.run"
      ],
      "condition": "仅：macro.run",
      "defaultValue": "Module1",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "macroProcedure",
      "name": "宏过程",
      "type": "Text",
      "validForList": [
        "macro.run"
      ],
      "condition": "仅：macro.run",
      "defaultValue": "main",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scriptCode",
      "name": "C# 代码",
      "type": "Text",
      "description": "在 SOLIDWORKS 进程内执行；可使用 application（SldWorks）和 document（当前 ModelDoc2，可为空）。不提供安全沙箱，只运行可信代码。",
      "validForList": [
        "script.evaluate"
      ],
      "condition": "仅：script.evaluate",
      "defaultValue": "return document == null ? null : document.GetTitle();",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "vbaCode",
      "name": "VBA 宏代码",
      "type": "Text",
      "description": "完整 VBA 模块代码。Bridge 会写入临时 .swb 文本宏，由 SOLIDWORKS 转换并执行；不提供安全沙箱。",
      "validForList": [
        "script.evaluate_vba"
      ],
      "condition": "仅：script.evaluate_vba",
      "defaultValue": "Option Explicit\r\nDim swApp As SldWorks.SldWorks\r\nSub main()\r\n    Set swApp = Application.SldWorks\r\n    swApp.SendMsgToUser2 \"Hello from Quicker\", 0, 0\r\nEnd Sub",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "vbaModule",
      "name": "VBA 模块名称",
      "type": "Text",
      "description": "通常留空，由 Bridge 自动读取临时宏的入口模块；仅兼容性排查时手动指定。",
      "validForList": [
        "script.evaluate_vba"
      ],
      "condition": "仅：script.evaluate_vba",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "vbaProcedure",
      "name": "VBA 过程名称",
      "type": "Text",
      "description": "只能执行无参数 Sub。",
      "validForList": [
        "script.evaluate_vba"
      ],
      "condition": "仅：script.evaluate_vba",
      "defaultValue": "main",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandName",
      "name": "Bridge 命令名称",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "argumentsJson",
      "name": "参数(JSON 对象)",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitMs",
      "name": "最长等待时间(ms)",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "30000",
      "defaultValueRaw": 30000,
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "output",
      "name": "命令结果",
      "type": "Text",
      "description": "SOLIDWORKS 返回的 JSON 结果。"
    }
  ],
