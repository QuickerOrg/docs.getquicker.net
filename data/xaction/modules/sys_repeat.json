{
  "key": "sys:repeat",
  "slug": "repeat",
  "legacySlug": "repeat",
  "ownsLegacyContent": true,
  "name": "重复",
  "description": "循环指定的次数，或符合某个条件时中止",
  "category": "Flow",
  "categoryName": "程序流程",
  "stepType": "Loop",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/repeat",
  "inputs": [
    {
      "key": "count",
      "name": "次数",
      "type": "Integer",
      "description": "重复次数，除非符合条件提前中止。-1表示无限循环。",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "startIndex",
      "name": "计数开始值",
      "type": "Integer",
      "description": "计数序号的开始值，通常应该为0。",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopCondition",
      "name": "中止条件",
      "type": "Boolean",
      "description": "选填。条件满足时停止循环（每次循环开始时检查）。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "repeatDelayMs",
      "name": "循环间隔时间",
      "type": "Integer",
      "description": "每次循环之间的间隔毫秒数。如果为0，请确保循环内部有其他等待步骤，避免连续循环占用较多资源。",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "progressBarTitle",
      "name": "进度条标题",
      "type": "Text",
      "description": "如果设置了此参数，则在循环过程中会显示一个进度条，标题为此参数的值。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    }
  ],
  "outputs": [
    {
      "key": "count",
      "name": "计数",
      "type": "Integer",
      "description": "计数序号，表示第几次循环。"
    }
  ],
  "sourceFileName": "catalog.json"
}
