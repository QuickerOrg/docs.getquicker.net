{
  "code": "2376e6a5-b5d9-4afb-7655-08d950c2afd2",
  "title": "多译",
  "description": "多引擎翻译",
  "author": "CL",
  "revision": 4,
  "source": "https://getquicker.net/sharedaction?code=2376e6a5-b5d9-4afb-7655-08d950c2afd2",
  "pulledAt": "2026-08-11T21:28:52.472Z",
  "variables": [
    {
      "name": "text",
      "type": "Text",
      "remark": "默认的文本变量"
    },
    {
      "name": "vendors",
      "type": "List",
      "remark": "厂商类型"
    },
    {
      "name": "srcLang",
      "type": "Text",
      "remark": "源语言"
    },
    {
      "name": "dstLang",
      "type": "Text",
      "remark": "目标语言"
    },
    {
      "name": "autoPaste",
      "type": "Boolean",
      "remark": "自动粘贴替换"
    },
    {
      "name": "closeAfterLostFocus",
      "type": "Boolean",
      "remark": "失去焦点后自动关闭"
    },
    {
      "name": "resultText",
      "type": "Text"
    },
    {
      "name": "isSuccess",
      "type": "Boolean",
      "remark": "是否成功获取内容。"
    },
    {
      "name": "img",
      "type": "Image"
    },
    {
      "name": "enableInput",
      "type": "Boolean",
      "remark": "是否启用输入"
    }
  ],
  "steps": [
    {
      "key": "sys:comment",
      "inputs": {
        "note": "动作设置菜单处理"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$= {quicker_in_param} == \"settings\""
      },
      "ifSteps": [
        {
          "key": "sys:form",
          "inputs": {
            "title": "动作设置",
            "formDef": "{\"Fields\":[{\"FieldKey\":\"enableInput\",\"Label\":\"未选择内容时显示输入框\",\"HelpText\":\"是否允许输入要翻译的内容。否则的话将直接使用OCR功能。\",\"HelpLink\":null,\"InputMethod\":6,\"SelectionItems\":\"\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"vendors\",\"Label\":\"厂商类型\",\"HelpText\":\"\",\"HelpLink\":null,\"InputMethod\":8,\"SelectionItems\":\"百度|Baidu\\r\\n腾讯|Tencent\\r\\n有道|Youdao\\r\\n彩云|Caiyun\\r\\n阿里云|Aliyun\\r\\n讯飞(小牛引擎)|XunfeiNiutrans\\r\\n谷歌|Google\",\"IsRequired\":true,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"srcLang\",\"Label\":\"源语言\",\"HelpText\":\"自动：Auto，其他请参考所用厂商接口文档。\",\"HelpLink\":null,\"InputMethod\":11,\"SelectionItems\":\"Auto\\r\\nZhCn\\r\\nEn\\r\\nJa\\r\\nKo\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"dstLang\",\"Label\":\"目标语言\",\"HelpText\":\"自动为Auto，其他请参考厂商接口文档\",\"HelpLink\":null,\"InputMethod\":11,\"SelectionItems\":\"Auto\\r\\nZhCn\\r\\nEn\\r\\nJa\\r\\nKo\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"autoPaste\",\"Label\":\"自动粘贴替换\",\"HelpText\":\"自动粘贴翻译结果，否则只复制到剪贴板。\",\"HelpLink\":null,\"InputMethod\":6,\"SelectionItems\":\"\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"closeAfterLostFocus\",\"Label\":\"失去焦点后自动关闭\",\"HelpText\":\"失去焦点后自动关闭翻译结果窗口\",\"HelpLink\":null,\"InputMethod\":6,\"SelectionItems\":\"\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"}]}",
            "titleColumnWidth": "100",
            "windowWidth": "500",
            "restoreFocus": "0",
            "topMost": "false",
            "stopIfFail": "1"
          }
        },
        {
          "key": "sys:stop",
          "inputs": {
            "method": "default",
            "isError": "0"
          }
        }
      ]
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "正常翻译处理"
      }
    },
    {
      "key": "sys:getSelectedText",
      "inputs": {
        "format": "UnicodeText",
        "repeat": "0",
        "useActionParam": "0",
        "stopIfFail": "0"
      },
      "outputs": {
        "output": "text",
        "isSuccess": "isSuccess"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$=!{isSuccess}"
      },
      "ifSteps": [
        {
          "key": "sys:comment",
          "inputs": {
            "note": "用户输入"
          }
        },
        {
          "key": "sys:simpleIf",
          "inputs": {
            "condition": "{enableInput}"
          },
          "ifSteps": [
            {
              "key": "sys:userInput",
              "inputs": {
                "type": "multiline",
                "prompt": "请输入要翻译的内容。按Esc或输入为空使用OCR截图获取内容。",
                "isRequired": "0",
                "winLocation": "CenterScreen",
                "imeState": "NO_CONTROL",
                "submitWithReturn": "0",
                "restoreFocus": "1",
                "closeOnDeactivated": "0",
                "stopIfFail": "0"
              },
              "outputs": {
                "isSuccess": "isSuccess",
                "textValue": "text"
              }
            }
          ]
        },
        {
          "key": "sys:comment",
          "inputs": {
            "note": "OCR"
          }
        },
        {
          "key": "sys:simpleIf",
          "inputs": {
            "condition": "$=!{isSuccess} || String.IsNullOrEmpty({text})"
          },
          "ifSteps": [
            {
              "key": "sys:screenCapture",
              "inputs": {
                "type": "select",
                "delay": "200",
                "toClip": "0",
                "stopIfFail": "1"
              },
              "outputs": {
                "img": "img"
              }
            },
            {
              "key": "sys:basic-ocr",
              "inputs": {
                "operation": "baidu-quicker",
                "imgVar": "{img}",
                "punctuationType": "no",
                "mergeChapter": "no",
                "stopIfFail": "1"
              },
              "outputs": {
                "content": "text"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "sys:translation",
      "inputs": {
        "operation": "multiple",
        "text": "{text}",
        "srcLang": "{srcLang}",
        "dstLang": "{dstLang}",
        "vendorList": "$=String.Join(\",\" , {vendors})",
        "stopIfFail": "1"
      },
      "outputs": {
        "resultText": "resultText"
      }
    },
    {
      "key": "sys:showText",
      "inputs": {
        "type": "NO_WAIT",
        "text": "$$【原文】\r\n{text}\r\n\r\n{resultText}",
        "title": "结果内容",
        "topMost": "false",
        "winLocation": "CenterScreen",
        "fontsize": "14",
        "closeWhenLostFocus": "{closeAfterLostFocus}",
        "showLineNum": "true",
        "autoWrap": "true",
        "showBuildInToolbar": "true",
        "copyWholeLine": "false"
      }
    }
  ]
}
