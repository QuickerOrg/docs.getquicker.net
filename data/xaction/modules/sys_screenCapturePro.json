{
  "key": "sys:screenCapturePro",
  "slug": "screen-capture-pro",
  "legacySlug": "screen-capture-pro",
  "ownsLegacyContent": true,
  "name": "截图 Pro",
  "description": "框选截图、标注、贴图或识别。默认自动吸附，可关闭后用滚轮手动调整选区。",
  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/screen-capture-pro",
  "inputs": [
    {
      "key": "operation",
      "name": "操作",
      "type": "Enum",
      "description": "这次截图怎么结束，不受设置中“直接截图的完成操作”影响。",
      "defaultValue": "capture",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "preSelectArea",
      "name": "预选截图区域",
      "type": "Text",
      "description": "留空时手动选择；指定物理屏幕坐标 left,top,right,bottom（右、下边界不包含）时，截图/快速保存从该区域进入可调整状态，其他操作直接对该区域执行。",
      "isAdvanced": true,
      "validForList": [
        "capture",
        "capture_now",
        "copy",
        "pin",
        "ocr_copy",
        "ocr",
        "table",
        "formula",
        "translate",
        "image_translate",
        "quick_save"
      ],
      "condition": "仅：capture, capture_now, copy, pin, ocr_copy, ocr, table, formula, translate, image_translate, quick_save",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "delay",
      "name": "截图前延迟时间",
      "type": "Integer",
      "description": "等待多少毫秒后开始截图",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "addToHistory",
      "name": "加入截图历史",
      "type": "Boolean",
      "description": "遵循全局截图历史开关；取消勾选可排除本次截图，不会打开全局历史。",
      "isAdvanced": true,
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "toClip",
      "name": "写入剪贴板",
      "type": "Boolean",
      "description": "确认截图后写入剪贴板；“框选即出图”在框选完成后写入。其他工具栏出口不触发。",
      "validForList": [
        "capture",
        "capture_now",
        "quick_save"
      ],
      "condition": "仅：capture, capture_now, quick_save",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "pinImage",
      "name": "截图后贴图",
      "type": "Boolean",
      "description": "确认截图后贴到原位置；“框选即出图”在框选完成后贴图。其他工具栏出口不触发。",
      "validForList": [
        "capture",
        "capture_now",
        "quick_save"
      ],
      "condition": "仅：capture, capture_now, quick_save",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "showToolbarAfterPin",
      "name": "贴图后显示工具栏",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "capture",
        "capture_now",
        "pin",
        "quick_save"
      ],
      "condition": "仅：capture, capture_now, pin, quick_save",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "autoAdsorb",
      "name": "自动吸附UI元素",
      "type": "Boolean",
      "description": "自动吸附鼠标下的界面元素。关闭后可用滚轮手动缩小或扩大选区。",
      "isAdvanced": true,
      "defaultValue": "false",
      "defaultValueRaw": false,
      "newStepDefaultValue": "true",
      "variableMode": "Input"
    },
    {
      "key": "toolbarScript",
      "name": "自定义工具栏",
      "type": "Text",
      "description": "留空则用默认工具栏。",
      "isAdvanced": true,
      "validForList": [
        "capture",
        "quick_save"
      ],
      "condition": "仅：capture, quick_save",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "saveDirectory",
      "name": "保存目录",
      "type": "Text",
      "description": "留空用全局目录，只改本次。",
      "isAdvanced": true,
      "validForList": [
        "quick_save"
      ],
      "condition": "仅：quick_save",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    }
  ],
  "outputs": [
