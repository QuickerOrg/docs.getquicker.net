{
  "key": "sys:autocadcontrol",
  "slug": "autocadcontrol",
  "legacySlug": "autocadcontrol",
  "ownsLegacyContent": true,
  "name": "AutoCAD控制",
  "description": "通过低权限代理或 HTTP Bridge 调用 AutoCAD。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/autocadcontrol",
  "inputs": [
    {
      "key": "connection",
      "name": "连接方式",
      "type": "Enum",
      "description": "旧动作默认使用低权限代理；HTTP Bridge 需要安装并启用 AutoCAD 插件。",
      "defaultValue": "agent",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "description": "低权限代理操作。",
      "validForList": [
        "agent"
      ],
      "condition": "仅：agent",
      "defaultValue": "SendCommand",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "bridgeOperation",
      "name": "Bridge 操作",
      "type": "Enum",
      "description": "向在线 AutoCAD 连接发送结构化命令；多个连接时按动作触发窗口定位。",
      "validForList": [
        "bridge"
      ],
      "condition": "仅：bridge",
      "defaultValue": "bridge.ping",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "command",
      "name": "命令内容",
      "type": "Text",
      "description": "发送到 CAD 执行的命令内容。通常以空格结尾开始执行。",
      "validForList": [
        "SendCommand"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "agent"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "SendCommand"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"agent\" 且 operation 为 \"SendCommand\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "varList",
      "name": "变量列表",
      "type": "Text",
      "description": "每行一个变量名称。",
      "validForList": [
        "ReadVariable"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "agent"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "ReadVariable"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"agent\" 且 operation 为 \"ReadVariable\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitResp",
      "name": "等待命令结束",
      "type": "Boolean",
      "validForList": [
        "SendCommand"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "agent"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "SendCommand"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"agent\" 且 operation 为 \"SendCommand\")",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bridgeCommand",
      "name": "AutoCAD 命令内容",
      "type": "Text",
      "description": "不限制命令字符串；末尾没有空白时会自动补一个空格开始执行。",
      "validForList": [
        "document.send_command"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "bridge"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "bridgeOperation",
            "operator": "In",
            "values": [
              "document.send_command"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"bridge\" 且 bridgeOperation 为 \"document.send_command\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bridgeVariableList",
      "name": "系统变量列表",
      "type": "Text",
      "description": "每行一个系统变量名称。",
      "validForList": [
        "system_variables.get"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "bridge"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "bridgeOperation",
            "operator": "In",
            "values": [
              "system_variables.get"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"bridge\" 且 bridgeOperation 为 \"system_variables.get\")",
      "defaultValue": "DWGNAME",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "lineStart",
      "name": "起点 (X,Y,Z)",
      "type": "Text",
      "description": "AutoCAD 图形单位坐标。",
      "validForList": [
        "geometry.create_line"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "bridge"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "bridgeOperation",
            "operator": "In",
            "values": [
              "geometry.create_line"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"bridge\" 且 bridgeOperation 为 \"geometry.create_line\")",
      "defaultValue": "0,0,0",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "lineEnd",
      "name": "终点 (X,Y,Z)",
      "type": "Text",
      "description": "AutoCAD 图形单位坐标。",
      "validForList": [
        "geometry.create_line"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "bridge"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "bridgeOperation",
            "operator": "In",
            "values": [
              "geometry.create_line"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"bridge\" 且 bridgeOperation 为 \"geometry.create_line\")",
      "defaultValue": "100,0,0",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bridgeFilePath",
      "name": "文件路径",
      "type": "Text",
      "description": "必须是 AutoCAD 所在电脑上的绝对路径。插件加载仍受 SECURELOAD 和 TRUSTEDPATHS 限制。",
      "validForList": [
        "document.open",
        "document.save_as",
        "lisp.list_commands",
        "lisp.load_file",
        "script.run_file",
        "plugin.load_dotnet",
        "plugin.load_arx",
        "plot.export_pdf",
        "document.export_dxf",
        "plugin.load_and_run"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "connection",
            "operator": "In",
            "values": [
              "bridge"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "bridgeOperation",
            "operator": "In",
            "values": [
              "document.open",
              "document.save_as",
              "lisp.list_commands",
              "lisp.load_file",
              "script.run_file",
              "plugin.load_dotnet",
              "plugin.load_arx",
              "plot.export_pdf",
              "document.export_dxf",
              "plugin.load_and_run"
            ]
          }
        ]
      },
      "condition": "(connection 为 \"bridge\" 且 bridgeOperation 为 \"document.open\"、\"document.save_as\"、\"lisp.list_commands\"、\"lisp.load_file\"、\"script.run_file\"、\"plugin.load_dotnet\"、\"plugin.load_arx\"、\"plot.export_pdf\"、\"document.export_dxf\"、\"plugin.load_and_run\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
