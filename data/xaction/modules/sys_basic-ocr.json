  "inputs": [
    {
      "key": "operation",
      "name": "接口/引擎",
      "type": "Enum",
      "defaultValue": "QuickerServerOcr",
      "required": true,
      "variableMode": "Input",
      "condition": "",
      "description": "OCR接口或引擎。离线引擎安装方式请参考模块文档。"
    },
    {
      "key": "apiKey",
      "name": "ApiKey",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：baidu-basic, baidu-custom",
      "description": "请填写OCR帐号的ApiKey"
    },
    {
      "key": "secretKey",
      "name": "SecretKey",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：baidu-basic, baidu-custom",
      "description": "请填写OCR帐号的SecretKey"
    },
    {
      "key": "imgVar",
      "name": "图片变量",
      "type": "Image",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVar",
      "condition": "",
      "description": "从指定变量中加载图片"
    },
    {
      "key": "punctuationType",
      "name": "转换标点符号",
      "type": "Enum",
      "defaultValue": "no",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：baidu-basic, baidu-quicker, QuickerServerOcr",
      "description": "合并文本时，是否转换标点符号"
    },
    {
      "key": "mergeChapter",
      "name": "合并段落",
      "type": "Enum",
      "defaultValue": "no",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：baidu-basic, baidu-quicker, QuickerServerOcr",
      "description": "是否智能合并段落。"
    },
    {
      "key": "interface",
      "name": "接口名称或网址",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：baidu-custom",
      "description": "接口的完整网址，或 https://aip.baidubce.com/rest/2.0/ocr/v1/ 后面的部分"
    },
    {
      "key": "options",
      "name": "附加参数",
      "type": "Dict",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：baidu-custom",
      "description": "请参考百度官方/Quicker服务接口说明。每行一个参数，使用option:value的格式。"
    },
    {
      "key": "lang",
      "name": "语言",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：QuickerServerOcr, table_quicker",
      "description": "待识别内容的语言。表格识别仅支持中英混合和英文。"
    },
    {
      "key": "offlineMode",
      "name": "离线模式",
      "type": "Enum",
      "defaultValue": "Auto",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：QuickerServerOcr",
      "description": "旧版兼容参数。Quicker OCR 当前固定使用在线服务；旧动作选择“仅使用离线引擎”时转为本地 OCR。新动作请直接选择“本地 OCR”。"
    },
    {
      "key": "modelTier",
      "name": "模型",
      "type": "Enum",
      "defaultValue": "small",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：LocalOcr",
      "description": "标准=small（更准更大，默认）；快速=tiny（更快更小）。切换后如未安装会下载对应模型包。表格识别固定用 small，不出现此参数。"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "defaultValue": "true",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "失败后是否停止动作"
    }
  ],
