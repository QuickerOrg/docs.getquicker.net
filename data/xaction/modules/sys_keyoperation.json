{
  "key": "sys:keyoperation",
  "slug": "keyoperation",
  "legacySlug": "keyoperation",
  "ownsLegacyContent": true,
  "name": "按键操作",
  "description": "单个键盘按键的操作控制或状态获取",
  "category": "System",
  "categoryName": "Windows系统",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/keyoperation",
  "inputs": [
    {
      "key": "type",
      "name": "类型",
      "type": "Enum",
      "description": "操作类型。按下和抬起需要配对使用。",
      "defaultValue": "get_key_state",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "key",
      "name": "按键",
      "type": "Text",
      "description": "要操作或检查状态的按键(单个)。获取状态可使用鼠标键；如需发送真实鼠标事件，请使用“鼠标输入”步骤。",
      "validForList": [
        "get_key_state",
        "key_down",
        "key_up"
      ],
      "condition": "仅：get_key_state, key_down, key_up",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "getRealMouseState",
      "name": "获取按键的实际状态（在远程时无法获取）",
      "type": "Boolean",
      "validForList": [
        "get_key_state"
      ],
      "condition": "仅：get_key_state",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "keepMs",
      "name": "保持按下时间",
      "type": "Integer",
      "description": "保持此虚拟键按下的时间（毫秒数），之后会自动抬起。",
      "validForList": [
        "key_keydown_v1"
      ],
      "condition": "仅：key_keydown_v1",
      "defaultValue": "1000",
      "defaultValueRaw": 1000,
      "variableMode": "UseVarOrInput"
    }
  ],
  "outputs": [
    {
      "key": "isDown",
      "name": "是否按下",
      "type": "Boolean",
      "description": "此按键是否为按下状态",
      "validForList": [
        "get_key_state"
      ],
      "condition": "仅：get_key_state"
    },
    {
      "key": "isToggled",
      "name": "是否锁定",
      "type": "Boolean",
      "description": "此按键是否为锁定状态，仅对CapsLock、NumLock等按键有效。",
      "validForList": [
        "get_key_state"
      ],
      "condition": "仅：get_key_state"
    }
  ],
