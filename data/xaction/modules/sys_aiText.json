      "key": "instructions",
      "name": "补充要求",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "排除：custom",
      "description": "追加到内置任务模板后的要求，例如“控制在 100 字内”。自定义操作时不使用。"
    },
    {
      "key": "targetLanguage",
      "name": "目标语言",
      "type": "Text",
      "defaultValue": "中文",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：translate",
      "description": "翻译结果使用的语言，例如“英语”或“日语”。仅翻译操作显示。"
    },
    {
      "key": "systemPrompt",
      "name": "完整系统提示词",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：custom",
      "description": "完全定义 AI 的处理规则，不会与任何内置模板或补充要求拼接。"
    },
    {
      "key": "useCaseId",
      "name": "AI 任务场景",
      "type": "Text",
      "defaultValue": "text.general",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "",
      "description": "选择“模型分配”中的任务场景。动作只保存场景 ID，可在其它设备匹配同步后的同一场景。"
    },
    {
      "key": "outputMode",
      "name": "输出方式",
      "type": "Enum",
      "defaultValue": "direct",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "",
      "description": "直接返回适合后台流程；交互调整会打开 Markdown 窗口，可实时查看、继续追问并显式采用回答。"
    },
    {
      "key": "missingUseCaseBehavior",
      "name": "任务场景缺失时",
      "type": "Enum",
      "defaultValue": "UseBaseUseCase",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "",
      "description": "自定义任务场景不存在时，使用内置文本任务场景或直接失败。"
    },
    {
