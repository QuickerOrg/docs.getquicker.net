{
  "key": "sys:waitWindow",
  "slug": "waitwindow",
  "legacySlug": "waitwindow",
  "ownsLegacyContent": true,
  "name": "等待窗口",
  "description": "等待窗口出现、消失、成为前台、最小化或恢复。",
  "category": "Waiting",
  "categoryName": "等待",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/waitwindow",
  "inputs": [
    {
      "key": "waitFor",
      "name": "等待条件",
      "type": "Enum",
      "defaultValue": "appeared",
      "variableMode": "Input"
    },
    {
      "key": "targetType",
      "name": "目标类型",
      "type": "Enum",
      "defaultValue": "query",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "hWnd",
      "name": "窗口句柄",
      "type": "Integer",
      "description": "指定顶层窗口的句柄。固定句柄模式会识别等待期间的句柄失效和复用；等待“出现”只要求该句柄有效，不要求窗口可见。低权限 Quicker 可能无法为管理员窗口建立稳定身份标记。",
      "visibleWhen": {
        "kind": "Field",
        "fieldKey": "targetType",
        "operator": "In",
        "values": [
          "handle"
        ]
      },
      "condition": "targetType 为 \"handle\"",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "titleContains",
      "name": "窗口标题包含",
      "type": "Text",
      "description": "忽略大小写；和进程名、窗口类名同时填写时按 AND 组合。",
      "visibleWhen": {
        "kind": "Field",
        "fieldKey": "targetType",
        "operator": "In",
        "values": [
          "query"
        ]
      },
      "condition": "targetType 为 \"query\"",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "processName",
      "name": "进程名",
      "type": "Text",
      "description": "程序文件名，可填写或省略 .exe，不接受完整路径。",
      "visibleWhen": {
        "kind": "Field",
        "fieldKey": "targetType",
        "operator": "In",
        "values": [
          "query"
        ]
      },
      "condition": "targetType 为 \"query\"",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "className",
      "name": "窗口类名",
      "type": "Text",
      "description": "忽略大小写精确匹配。",
      "visibleWhen": {
        "kind": "Field",
        "fieldKey": "targetType",
        "operator": "In",
        "values": [
          "query"
        ]
      },
      "condition": "targetType 为 \"query\"",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "includeHidden",
      "name": "包含隐藏窗口",
      "type": "Boolean",
      "description": "未启用时，仅在可见顶层窗口中查找。",
      "visibleWhen": {
        "kind": "Field",
        "fieldKey": "targetType",
        "operator": "In",
        "values": [
          "query"
        ]
      },
      "condition": "targetType 为 \"query\"",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "timeoutSeconds",
      "name": "最长等待秒数",
      "type": "Number",
      "description": "0 表示无限等待；无限等待仍可被动作中止或 WaitAny 分支取消。",
      "defaultValue": "10.0",
      "defaultValueRaw": 10,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "outcome",
      "name": "等待结果",
      "type": "Text",
      "description": "matched、timedOut、canceled、invalidTarget、targetLost 或 error。"
    },
    {
      "key": "hWnd",
      "name": "窗口句柄",
      "type": "Integer"
    },
    {
      "key": "matchedCount",
      "name": "匹配窗口数",
      "type": "Integer"
    },
    {
      "key": "title",
      "name": "窗口标题",
      "type": "Text"
    },
    {
      "key": "processName",
      "name": "进程名",
      "type": "Text"
    },
    {
      "key": "className",
      "name": "窗口类名",
      "type": "Text"
    },
    {
      "key": "isVisible",
      "name": "是否可见",
      "type": "Boolean"
    },
    {
      "key": "isForeground",
      "name": "是否为前台窗口",
      "type": "Boolean"
    },
    {
      "key": "isMinimized",
      "name": "是否最小化",
      "type": "Boolean"
    },
    {
      "key": "elapsedMs",
      "name": "等待耗时（毫秒）",
      "type": "Integer"
    },
    {
      "key": "attemptCount",
      "name": "状态检查次数",
      "type": "Integer"
    },
    {
      "key": "message",
      "name": "结果消息",
      "type": "Text",
      "description": "超时、取消、目标失效或查询错误的诊断消息。"
    }
  ],
  "selections": {
    "waitFor": {
      "name": "等待条件",
      "items": [
        {
          "value": "appeared",
          "name": "出现"
        },
        {
          "value": "disappeared",
          "name": "消失"
        },
        {
          "value": "foreground",
          "name": "成为前台窗口"
        },
        {
          "value": "minimized",
          "name": "最小化"
        },
        {
          "value": "restored",
          "name": "恢复（非最小化）"
        }
      ]
    },
    "targetType": {
      "name": "目标类型",
      "items": [
        {
          "value": "query",
          "name": "按条件查找"
        },
        {
          "value": "handle",
          "name": "指定窗口句柄"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
