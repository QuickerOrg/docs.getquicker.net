  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "isRisky": false,
  "isProOnly": false,
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/imageinfo",
  "inputs": [
    {
      "key": "sourceType",
      "name": "图片来源",
      "type": "Enum",
      "defaultValue": "var",
      "required": true,
      "variableMode": "Input",
      "condition": "",
      "description": ""
    },
    {
      "key": "bmpFile",
      "name": "文件路径",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：file",
      "description": "图片文件的完整路径"
    },
    {
      "key": "bmpVar",
      "name": "图片变量",
      "type": "Image",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVar",
      "condition": "仅：var",
      "description": ""
    },
    {
      "key": "autoRotate",
      "name": "计算旋转后的宽高",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "如果Exif中包含旋转角度信息，则获取旋转后的宽高"
    },
    {
      "key": "missingExifDateFallback",
      "name": "无 EXIF 日期时",
      "type": "Enum",
      "defaultValue": "creationTime",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "",
      "description": "Exif拍摄时间和普通日期均缺失时的处理方式。文件日期只是估算；图片变量没有文件日期，始终返回时间最小值（1年1月1日）。"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "defaultValue": "true",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "失败后是否停止动作"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "condition": "",
      "description": "操作是否成功"
    },
    {
      "key": "width",
      "name": "宽度",
      "type": "Integer",
      "condition": "",
      "description": ""
    },
    {
      "key": "height",
      "name": "高度",
      "type": "Integer",
      "condition": "",
      "description": ""
    },
    {
      "key": "rotateDegree",
      "name": "旋转角度",
      "type": "Integer",
      "condition": "",
      "description": ""
    },
    {
      "key": "dateTimeOriginal",
      "name": "拍摄时间",
      "type": "DateTime",
      "condition": "",
      "description": "优先读取Exif拍摄时间，其次读取Exif普通日期；均缺失时按“无 EXIF 日期时”选项处理。图片变量无日期或日期解析失败时返回时间最小值。"
    },
    {
      "key": "exifData",
      "name": "Exif数据",
      "type": "Dict",
      "condition": "",
      "description": "转换为文本格式的exif数据（词典格式，请参考模块文档）"
    },
    {
      "key": "rawExifData",
      "name": "原始属性数据",
      "type": "Dict",
      "condition": "",
      "description": "原始Exif数据(词典格式，请参考模块文档)"
    },
    {
      "key": "fileTypeFromData",
      "name": "内容图片格式",
      "type": "Text",
      "condition": "仅：file",
      "description": "根据文件内容判断的文件格式（可能不准确），用于在无法根据扩展名得到图片格式的情况下使用。"
    },
    {
      "key": "isTakenDateTimeEmpty",
      "name": "拍摄时间为空",
      "type": "Boolean",
      "condition": "",
      "description": "Exif拍摄时间（DateTimeOriginal）缺失或无法解析时为true；不把Exif普通日期或文件日期视为拍摄时间。“拍摄时间”输出此时可能返回回退值。"
    }
