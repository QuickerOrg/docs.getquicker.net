{
  "key": "sys:WriteTextFile",
  "slug": "writetextfile",
  "legacySlug": "writetextfile",
  "ownsLegacyContent": true,
  "name": "写入文本文件",
  "description": "将内容写入文本文件",
  "category": "Files",
  "categoryName": "系统操作",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/writetextfile",
  "inputs": [
    {
      "key": "content",
      "name": "内容",
      "type": "Text",
      "description": "要写入文件的内容",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "filePath",
      "name": "文件路径",
      "type": "Text",
      "description": "要写入的完整文件路径（包含文件名）",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "encoding",
      "name": "文件编码",
      "type": "Enum",
      "description": "写入文件的编码格式",
      "defaultValue": "utf-8",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "addUtf8Bom",
      "name": "添加UTF-BOM",
      "type": "Boolean",
      "description": "UTF8编码文件是否写入BOM标记",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "appendMode",
      "name": "添加到文件末尾",
      "type": "Boolean",
      "description": "如果文件已存在，则添加到文件的末尾",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "addNewLine",
      "name": "添加空行",
      "type": "Boolean",
      "description": "在文件末尾添加空行",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "newLineChars",
      "name": "统一换行字符",
      "type": "Enum",
      "defaultValue": "",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    }
  ],
  "selections": {
    "encoding": {
      "name": "文件编码",
      "items": [
        {
          "value": "utf-8",
          "name": "UTF8"
        },
        {
          "value": "utf-16",
          "name": "UTF-16 LE"
        },
        {
          "value": "utf-16BE",
          "name": "UTF-16 BE"
        },
        {
          "value": "us-ascii",
          "name": "ASCII"
        },
        {
          "value": "utf-7",
          "name": "UTF7"
        },
        {
          "value": "utf-32",
          "name": "UTF32"
        },
        {
          "value": "default",
          "name": "系统默认(gb2312)"
        }
      ]
    },
    "newLineChars": {
      "name": "统一换行字符",
      "items": [
        {
          "value": "",
          "name": "默认（不处理）"
        },
        {
          "value": "\r\n",
          "name": "\\r\\n",
          "description": "Windows"
        },
        {
          "value": "\r",
          "name": "\\r ",
          "description": "(Mac)"
        },
        {
          "value": "\n",
          "name": "\\n ",
          "description": "(Linux)"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
