{
  "key": "sys:zip",
  "slug": "zip",
  "legacySlug": "zip",
  "ownsLegacyContent": true,
  "name": "Zip压缩打包",
  "description": "Zip压缩或解压缩",
  "category": "Files",
  "categoryName": "系统操作",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/zip",
  "inputs": [
    {
      "key": "type",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "Zip",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "sourcePath",
      "name": "源路径",
      "type": "Text",
      "description": "待压缩的文件夹或文件路径。多个文件时每个文件一行。",
      "validForList": [
        "Zip"
      ],
      "condition": "仅：Zip",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "targetZipFile",
      "name": "Zip文件路径",
      "type": "Text",
      "description": "压缩时：目标文件的路径。留空时自动生成临时文件。点(.)表示待压缩的文件夹或文件所在位置。",
      "validForList": [
        "Zip"
      ],
      "condition": "仅：Zip",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "sourceZipFile",
      "name": "Zip文件路径",
      "type": "Text",
      "description": "待解压的文件路径。",
      "validForList": [
        "Unzip"
      ],
      "condition": "仅：Unzip",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "keepBaseFolder",
      "name": "源路径为单个文件夹时，压缩整个文件夹（保留文件夹名称）",
      "type": "Boolean",
      "validForList": [
        "Zip"
      ],
      "condition": "仅：Zip",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "outputPath",
      "name": "目标路径",
      "type": "Text",
      "description": "解压缩的目标路径, 点(.)表示zip文件所在的文件夹, 星(*)表示以zip文件名创建的子文件夹。",
      "validForList": [
        "Unzip"
      ],
      "condition": "仅：Unzip",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "password",
      "name": "密码",
      "type": "Text",
      "description": "压缩文件密码",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "comment",
      "name": "备注",
      "type": "Text",
      "description": "压缩文件注释内容",
      "validForList": [
        "Zip"
      ],
      "condition": "仅：Zip",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "level",
      "name": "级别",
      "type": "Integer",
      "description": "压缩级别，0-9。0表示不压缩（速度快），9表示压缩到最小（速度慢）",
      "validForList": [
        "Zip"
      ],
      "condition": "仅：Zip",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "overwrite",
      "name": "自动覆盖文件",
      "type": "Boolean",
      "validForList": [
        "Unzip"
      ],
      "condition": "仅：Unzip",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "skipOverwriteError",
      "name": "覆盖失败时忽略",
      "type": "Boolean",
      "description": "忽略掉无法覆盖的情况",
      "validForList": [
        "Unzip"
      ],
      "condition": "仅：Unzip",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "showProgress",
      "name": "显示进度条",
      "type": "Boolean",
      "description": "仅支持解压缩或压缩单个文件夹。",
      "validForList": [
        "Zip",
        "Unzip"
      ],
      "condition": "仅：Zip, Unzip",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "resultPath",
      "name": "结果路径",
      "type": "Text",
      "description": "生成的zip文件完整路径，或解压缩后的完整路径"
    }
  ],
  "selections": {
    "type": {
      "name": "操作类型",
      "items": [
        {
          "value": "Zip",
          "name": "创建Zip文件"
        },
        {
          "value": "Unzip",
          "name": "解压缩Zip文件"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
