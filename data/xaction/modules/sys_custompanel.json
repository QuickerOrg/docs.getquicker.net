{
  "key": "sys:custompanel",
  "slug": "custompanel",
  "legacySlug": "custompanel",
  "ownsLegacyContent": true,
  "name": "自定义操作窗",
  "description": "自定义悬浮操作窗口，点击后直接执行操作，不隐藏。",
  "category": "Ui",
  "categoryName": "界面组件",
  "stepType": "Action",
  "isRisky": false,
  "isProOnly": false,
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/custompanel",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "show_fixed_panel_wait_close",
      "required": true,
      "variableMode": "Input",
      "condition": "",
      "description": ""
    },
    {
      "key": "operationData",
      "name": "操作项定义",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "可以为Json/菜单文本格式/IList<CommonOperationItem>对象，详情请参考文档"
    },
    {
      "key": "defaultOperation",
      "name": "默认Operation",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "默认的Operation值或参数组合。提供此值时，操作项可以直接通过\"[图标]标题(提示)|data\"的形式定义。"
    },
    {
      "key": "spacingStr",
      "name": "按钮之间的间隔",
      "type": "Text",
      "defaultValue": "5",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "可选格式1：5 => 四个边都是5；格式2：10,5 => 左右10，上下5;"
    },
    {
      "key": "buttonPadding",
      "name": "按钮内边距",
      "type": "Text",
      "defaultValue": "10,6",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "格式1：5 => 四个边都是5；格式2：10,5 => 左右10，上下5; 格式3：7,8,9,10 => 分别指定左上右下4边边距。"
    },
    {
      "key": "columnCount",
      "name": "列数",
      "type": "Integer",
      "defaultValue": "2",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "按钮排列方式为固定列数时，指定列数。0表示自动。"
    },
    {
      "key": "columnWidth",
      "name": "列宽",
      "type": "Integer",
      "defaultValue": "0",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "固定列宽时使用。0表示自动列宽，-1表示不对齐宽度，各子项根据内容自动调整宽度。"
    },
    {
      "key": "groupMode",
      "name": "分组方式",
      "type": "Enum",
      "defaultValue": "heading",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "当包含子项时，第一级节点作为分组，第二级节点作为按钮。"
    },
    {
      "key": "selectGroup",
      "name": "选择标签分组",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "标签页分组时切换至设定的标签页标题，留空表示默认。"
    },
    {
      "key": "title",
      "name": "操作窗标题",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "标题文字，或\"[图标]标题\"格式。"
    },
    {
      "key": "windowId",
      "name": "窗口标识",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "",
      "description": "如需单独的步骤关闭窗口，需使用标识查找窗口。可使用\"=\"表示当前动作ID。"
    },
    {
      "key": "winLocation",
      "name": "窗口位置",
      "type": "Enum",
      "defaultValue": "CenterScreen",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "在哪里显示选择窗口"
    },
    {
      "key": "winSize",
      "name": "窗口尺寸/位置",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "设置选择窗口的最大尺寸，格式为：宽度,高度。支持像素数值或屏幕宽高百分比，详情请参考模块文档。\n\"窗口位置\" 类型为 \"自定义位置\" 时用于指定显示位置，格式为：left,top,right,bottom"
    },
    {
      "key": "horzAlign",
      "name": "按钮内容对齐方式",
      "type": "Enum",
      "defaultValue": "Center",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": ""
    },
    {
      "key": "bgColor",
      "name": "背景颜色",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": ""
    },
    {
      "key": "btnColor",
      "name": "按钮颜色",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": ""
    },
    {
      "key": "btnBorderColor",
      "name": "按钮边框颜色",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": ""
    },
    {
      "key": "fontColor",
      "name": "字体颜色",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": ""
    },
    {
      "key": "fontsize",
      "name": "字体大小",
      "type": "Number",
      "defaultValue": "12",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": ""
    },
    {
      "key": "iconsize",
      "name": "图标大小",
      "type": "Number",
      "defaultValue": "16",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "图标的宽度/高度像素数"
    },
    {
      "key": "contextMenuData",
      "name": "窗口右键菜单",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "可以为Json/菜单文本格式/IList<CommonOperationItem>对象，详情请参考文档"
    },
    {
      "key": "buttonContextMenuData",
      "name": "默认的按钮右键菜单",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "可以为Json/菜单文本格式/IList<CommonOperationItem>对象，详情请参考文档"
    },
    {
      "key": "bindProc",
      "name": "自动关联到进程",
      "type": "Enum",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "要关联的进程名称，输入\"-\"禁用此功能。当该进程为前台时显示操作窗，否则自动隐藏。"
    },
    {
      "key": "autoCollapse",
      "name": "自动折叠",
      "type": "Enum",
      "defaultValue": "0",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": ""
    },
    {
      "key": "saveState",
      "name": "记忆位置等状态",
      "type": "Boolean",
      "defaultValue": "true",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "description": "多次使用操作窗时，保持上一次所在位置和分组"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "defaultValue": "true",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "失败后是否停止动作"
    }
  ],
