{
  "key": "sys:runAction",
  "slug": "runaction",
  "legacySlug": "runaction",
  "ownsLegacyContent": true,
  "name": "运行或停止动作",
  "description": "执行指定的其他动作",
  "category": "Flow",
  "categoryName": "程序流程",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/runaction",
  "inputs": [
    {
      "key": "type",
      "name": "类型",
      "type": "Enum",
      "description": "操作类型",
      "defaultValue": "StartAction",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "actionId",
      "name": "目标动作",
      "type": "Text",
      "description": "要运行的其他动作的ID或名称(使用名称时需要完全匹配且不能有重名动作)",
      "validForList": [
        "StartAction",
        "StopAction",
        "ShowActionContextMenu",
        "GetRunningActionCount"
      ],
      "condition": "仅：StartAction, StopAction, ShowActionContextMenu, GetRunningActionCount",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "onlyCustomMenu",
      "name": "仅显示动作的自定义菜单",
      "type": "Boolean",
      "description": "不显示编辑、复制等菜单",
      "validForList": [
        "ShowActionContextMenu"
      ],
      "condition": "仅：ShowActionContextMenu",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "inputParam",
      "name": "命令参数",
      "type": "Text",
      "description": "传递给目标动作的参数。存储在该动作的quicker_in_param变量中。",
      "validForList": [
        "StartAction",
        "StartCurrentAction"
      ],
      "condition": "仅：StartAction, StartCurrentAction",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "debug",
      "name": "调试模式运行",
      "type": "Boolean",
      "description": "是否以调试模式运行动作",
      "validForList": [
        "StartAction",
        "StartCurrentAction"
      ],
      "condition": "仅：StartAction, StartCurrentAction",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "wait",
      "name": "等待运行结束",
      "type": "Boolean",
      "description": "是否等待此动作运行结束再执行后续动作（如需获取目标动作的输出，需选中此项）",
      "validForList": [
        "StartAction",
        "StartCurrentAction"
      ],
      "condition": "仅：StartAction, StartCurrentAction",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "hideMessage",
      "name": "不显示提示消息",
      "type": "Boolean",
      "description": "仅对非动作库安装的动作有效",
      "validForList": [
        "StopAction"
      ],
      "condition": "仅：StopAction",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "如果未找到目标动作，是否停止当前动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "actionTitle",
      "name": "动作名称",
      "type": "Text",
      "description": "运行的动作名称。",
      "validForList": [
        "StartAction"
      ],
      "condition": "仅：StartAction"
    },
    {
      "key": "output",
      "name": "动作输出",
      "type": "Text",
      "description": "被调用动作的输出。",
      "validForList": [
        "StartAction",
        "StartCurrentAction"
      ],
      "condition": "仅：StartAction, StartCurrentAction"
    },
    {
      "key": "count",
      "name": "运行个数",
      "type": "Number",
      "description": "动作正在运行的个数",
      "validForList": [
        "GetRunningActionCount"
      ],
      "condition": "仅：GetRunningActionCount"
    }
  ],
  "selections": {
    "type": {
      "name": "类型",
      "items": [
        {
          "value": "StartAction",
          "name": "运行动作"
        },
        {
          "value": "StopAction",
          "name": "停止动作"
        },
        {
          "value": "ShowActionContextMenu",
          "name": "显示动作右键菜单"
        },
        {
          "value": "StartCurrentAction",
          "name": "运行当前动作（注意避免产生循环或递归）"
        },
        {
          "value": "StopOtherInstance",
          "name": "停止当前动作的其它实例"
        },
        {
          "value": "GetRunningActionCount",
          "name": "获取动作运行个数（自己编写动作时可用）"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
