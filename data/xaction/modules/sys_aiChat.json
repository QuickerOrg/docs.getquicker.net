{
  "key": "sys:aiChat",
  "slug": "ai-chat",
  "legacySlug": "ai-chat",
  "ownsLegacyContent": true,
  "name": "AI 交互对话",
  "description": "打开流式 AI 对话窗口，支持追问并显式采用回答",
  "category": "Ai",
  "categoryName": "AI",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/ai-chat",
  "inputs": [
    {
      "key": "mode",
      "name": "会话方式",
      "type": "Enum",
      "description": "新建本机会话，或继续当前设备上已有的会话。会话 ID 不会随动作分享。",
      "defaultValue": "new",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "conversationId",
      "name": "会话 ID",
      "type": "Text",
      "description": "要继续的本机会话 ID；不存在时明确失败，不会创建空会话。",
      "validForList": [
        "continue"
      ],
      "condition": "仅：continue",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "initialQuestion",
      "name": "初始问题",
      "type": "Text",
      "description": "打开窗口后立即发送的问题；之后可在窗口中继续追问。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "systemPrompt",
      "name": "完整系统提示词",
      "type": "Text",
      "description": "新建会话的完整系统规则；继续会话时使用原会话记录。",
      "validForList": [
        "new"
      ],
      "condition": "仅：new",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "useCaseId",
      "name": "AI 任务场景",
      "type": "Text",
      "description": "选择“模型分配”中的文本任务场景。每轮追问都会重新解析当前可用模型。",
      "defaultValue": "text.general",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowTitle",
      "name": "窗口标题",
      "type": "Text",
      "description": "对话窗口和新会话的标题。",
      "defaultValue": "AI 对话",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxRounds",
      "name": "最大对话轮数",
      "type": "Integer",
      "description": "首轮回答计为 1；达到上限后只能采用或取消。",
      "isAdvanced": true,
      "defaultValue": "10",
      "defaultValueRaw": 10,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxOutputTokens",
      "name": "最大输出 Token",
      "type": "Integer",
      "description": "每轮输出限制；0 表示不由本步骤设置。",
      "isAdvanced": true,
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "missingUseCaseBehavior",
      "name": "任务场景缺失时",
      "type": "Enum",
      "description": "自定义任务场景不存在时，使用内置文本任务场景或直接失败。",
      "isAdvanced": true,
      "defaultValue": "UseBaseUseCase",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "result",
      "name": "采用的回答",
      "type": "Text",
      "description": "用户明确点击“采用当前回答”时最后一条完整 Assistant 文本。"
    },
    {
      "key": "resultConversationId",
      "name": "会话 ID",
      "type": "Text",
      "description": "当前设备上的本地会话 ID。"
    },
    {
      "key": "historyJson",
      "name": "完整消息历史 JSON",
      "type": "Text",
      "description": "版本化的本地消息历史，Reasoning 与 Text 分开。",
      "isAdvanced": true
    },
    {
      "key": "roundCount",
      "name": "对话轮数",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "model",
      "name": "实际模型",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "inputTokens",
      "name": "输入 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "cachedInputTokens",
      "name": "缓存输入 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "outputTokens",
      "name": "输出 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "totalTokens",
      "name": "总 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "invocationIdsJson",
      "name": "调用标识列表 JSON",
      "type": "Text",
      "isAdvanced": true
    }
  ],
  "selections": {
    "mode": {
      "name": "会话方式",
      "items": [
        {
          "value": "new",
          "name": "新建会话"
        },
        {
          "value": "continue",
          "name": "继续指定会话"
        }
      ]
    },
    "useCaseId": {
      "name": "AI 任务场景",
      "items": [
        {
          "value": "text.general",
          "name": "日常文本处理与翻译"
        }
      ]
    },
    "missingUseCaseBehavior": {
      "name": "任务场景缺失时",
      "items": [
        {
          "value": "UseBaseUseCase",
          "name": "使用基础场景"
        },
        {
          "value": "Fail",
          "name": "执行失败"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
