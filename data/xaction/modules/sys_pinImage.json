{
  "key": "sys:pinImage",
  "slug": "pinimage",
  "legacySlug": "pinimage",
  "ownsLegacyContent": true,
  "name": "贴图",
  "description": "在屏幕指定位置浮动贴图（与截图 Pro 贴图窗口一致）。按来源自动识别图片、HTML、公式、OCR 原始结果或文本。",
  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/pinimage",
  "inputs": [
    {
      "key": "mode",
      "name": "内容来源",
      "type": "Enum",
      "description": "变量和剪贴板自动识别图片、HTML、公式、OCR 结果或文本。「纯文本」直接显示输入文字，可设置字体与字号。HTML 仅静态渲染，禁止网络访问。",
      "defaultValue": "variable",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "content",
      "name": "内容",
      "type": "Any",
      "description": "图片变量、图片路径，或文本（HTML / LaTeX / $公式$ / OCR 原始结果 / 纯文本）。自动判断类型并渲染；HTML 使用自身静态样式，禁用来源脚本和网络访问。",
      "validForList": [
        "variable"
      ],
      "condition": "仅：variable",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "text",
      "name": "文本",
      "type": "Text",
      "description": "要贴图的多行文字。支持变量；纯文本模式直接显示文字。",
      "validForList": [
        "text",
        "plainText"
      ],
      "condition": "仅：text, plainText",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "screenPlacement",
      "name": "屏幕位置",
      "type": "Enum",
      "description": "「自动」：剪贴板有 QuickerPinData / PixPinData 时贴回截图原位置，否则屏幕中间。其余预设相对鼠标所在显示器工作区定位（图片左上角）。「截图原位置」没有元数据时落到当前光标。来源为剪贴板且本项为「自定义坐标」且坐标为默认 0,0 时，有位置元数据也按原位置。未保存过此参数的旧动作仍是「自定义坐标」；新建步骤默认「自动」。",
      "defaultValue": "manual",
      "newStepDefaultValue": "auto",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "rect",
      "name": "自定义坐标",
      "type": "Text",
      "description": "仅当「屏幕位置」为自定义时有效。图片内容左上角的屏幕像素坐标：left,top 或 left,top,right,bottom（四元组时仅取 left、top）。",
      "validForList": [
        "manual"
      ],
      "condition": "仅：manual",
      "defaultValue": "0,0",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "fontName",
      "name": "纯文本字体名称",
      "type": "Text",
      "description": "纯文本贴图使用的本机字体。",
      "isAdvanced": true,
      "validForList": [
        "text",
        "plainText"
      ],
      "condition": "仅：text, plainText",
      "defaultValue": "Microsoft YaHei UI",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "fontSize",
      "name": "纯文本字号",
      "type": "Number",
      "description": "纯文本贴图的字号。",
      "isAdvanced": true,
      "validForList": [
        "text",
        "plainText"
      ],
      "condition": "仅：text, plainText",
      "defaultValue": "16.0",
      "defaultValueRaw": 16,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "theme",
      "name": "主题",
      "type": "Enum",
      "description": "自动：HTML 保留来源主题，文本、公式和 OCR 跟随 Quicker 主题。也可统一使用浅色或深色。",
      "isAdvanced": true,
      "validForList": [
        "variable",
        "clipboard",
        "text",
        "plainText",
        "baiduOcrJson",
        "html",
        "formula"
      ],
      "condition": "仅：variable, clipboard, text, plainText, baiduOcrJson, html, formula",
      "defaultValue": "auto",
      "variableMode": "Input"
    },
    {
      "key": "maxTextWidth",
      "name": "最大宽度",
      "type": "Integer",
      "description": "像素。0 表示按内容自动扩展。纯文本大于 0 时自动换行；HTML / 公式上限 2400。",
      "isAdvanced": true,
      "validForList": [
        "variable",
        "clipboard",
        "text",
        "plainText",
        "html",
        "formula"
      ],
      "condition": "仅：variable, clipboard, text, plainText, html, formula",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "imgVar",
      "name": "图片",
      "type": "Image",
      "description": "要贴图的图片变量。",
      "isAdvanced": true,
      "validForList": [
        "image"
      ],
      "condition": "仅：image",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVar"
    },
    {
      "key": "html",
      "name": "HTML",
      "type": "Text",
      "description": "完整 HTML 文档或片段。仅渲染静态 HTML 与内联样式，禁用来源脚本和网络访问；公式使用本地 KaTeX。",
      "isAdvanced": true,
      "validForList": [
        "html"
      ],
      "condition": "仅：html",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "htmlMaxWidth",
      "name": "HTML 最大宽度",
      "type": "Integer",
      "description": "像素。0 表示按内容自动扩展（上限 2400）。",
      "isAdvanced": true,
      "validForList": [
        "html"
      ],
      "condition": "仅：html",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "latex",
      "name": "LaTeX",
      "type": "Text",
      "description": "数学公式，如 E=mc^2 或 \\frac{a}{b}。使用本地 KaTeX 渲染。",
      "isAdvanced": true,
      "validForList": [
        "formula"
      ],
      "condition": "仅：formula",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "formulaLayout",
      "name": "公式版式",
      "type": "Enum",
      "isAdvanced": true,
      "validForList": [
        "formula"
      ],
      "condition": "仅：formula",
      "defaultValue": "display",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "formulaFontSize",
      "name": "公式字号",
      "type": "Number",
      "isAdvanced": true,
      "validForList": [
        "text",
        "formula"
      ],
      "condition": "仅：text, formula",
      "defaultValue": "22.0",
      "defaultValueRaw": 22,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "ocrJson",
      "name": "OCR 原始结果",
      "type": "Text",
      "description": "通常为「基础 OCR」步骤输出的「原始结果」(rawData)。支持 words_result/location 与 Result/Regions/Rect；无位置信息时纵向排列。",
      "isAdvanced": true,
      "validForList": [
        "baiduOcrJson"
      ],
      "condition": "仅：baiduOcrJson",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "ocrCanvasWidth",
      "name": "画布宽度",
      "type": "Integer",
      "description": "0 表示根据识别框自动推算（含边距）。",
      "isAdvanced": true,
      "validForList": [
        "baiduOcrJson"
      ],
      "condition": "仅：baiduOcrJson",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "ocrCanvasHeight",
      "name": "画布高度",
      "type": "Integer",
      "description": "0 表示根据识别框自动推算（含边距）。",
      "isAdvanced": true,
      "validForList": [
        "baiduOcrJson"
      ],
      "condition": "仅：baiduOcrJson",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "ocrFontName",
      "name": "OCR 绘制字体",
      "type": "Text",
      "isAdvanced": true,
      "validForList": [
        "baiduOcrJson"
      ],
      "condition": "仅：baiduOcrJson",
      "defaultValue": "Microsoft YaHei UI",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "img",
      "name": "贴图位图",
      "type": "Image",
      "description": "本次生成或用于贴图的位图（与窗口显示内容一致）。"
    },
    {
      "key": "hwnd",
      "name": "窗口句柄",
      "type": "Integer",
      "description": "本次创建的贴图窗口句柄，可用于后续窗口操作。窗口关闭后失效。"
    }
  ],
