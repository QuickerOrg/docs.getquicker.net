{
  "key": "sys:basic-ocr",
  "slug": "basic-ocr",
  "legacySlug": "basic-ocr",
  "ownsLegacyContent": true,
  "name": "基础OCR",
  "description": "获取图片中的文字",
  "category": "Network",
  "categoryName": "网络服务",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/basic-ocr",
  "inputs": [
    {
      "key": "operation",
      "name": "接口/引擎",
      "type": "Enum",
      "description": "OCR接口或引擎。离线引擎安装方式请参考模块文档。",
      "defaultValue": "QuickerServerOcr",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "apiKey",
      "name": "ApiKey",
      "type": "Text",
      "description": "请填写OCR帐号的ApiKey",
      "validForList": [
        "baidu-basic",
        "baidu-custom"
      ],
      "condition": "仅：baidu-basic, baidu-custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "secretKey",
      "name": "SecretKey",
      "type": "Text",
      "description": "请填写OCR帐号的SecretKey",
      "validForList": [
        "baidu-basic",
        "baidu-custom"
      ],
      "condition": "仅：baidu-basic, baidu-custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "imgVar",
      "name": "图片变量",
      "type": "Image",
      "description": "从指定变量中加载图片",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVar"
    },
    {
      "key": "punctuationType",
      "name": "转换标点符号",
      "type": "Enum",
      "description": "合并文本时，是否转换标点符号",
      "validForList": [
        "QuickerServerOcr",
        "baidu-basic",
        "baidu-quicker"
      ],
      "condition": "仅：QuickerServerOcr, baidu-basic, baidu-quicker",
      "defaultValue": "no",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "mergeChapter",
      "name": "合并段落",
      "type": "Enum",
      "description": "是否智能合并段落。",
      "validForList": [
        "QuickerServerOcr",
        "baidu-basic",
        "baidu-quicker"
      ],
      "condition": "仅：QuickerServerOcr, baidu-basic, baidu-quicker",
      "defaultValue": "no",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "interface",
      "name": "接口名称或网址",
      "type": "Text",
      "description": "接口的完整网址，或 https://aip.baidubce.com/rest/2.0/ocr/v1/ 后面的部分",
      "validForList": [
        "baidu-custom"
      ],
      "condition": "仅：baidu-custom",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "options",
      "name": "附加参数",
      "type": "Dict",
      "description": "请参考百度官方/Quicker服务接口说明。每行一个参数，使用option:value的格式。",
      "validForList": [
        "baidu-custom"
      ],
      "condition": "仅：baidu-custom",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "lang",
      "name": "语言",
      "type": "Text",
      "description": "待识别内容的语言。表格识别仅支持中英混合和英文。",
      "validForList": [
        "QuickerServerOcr",
        "table_quicker"
      ],
      "condition": "仅：QuickerServerOcr, table_quicker",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "offlineMode",
      "name": "离线模式",
      "type": "Enum",
      "description": "旧版兼容参数。Quicker OCR 当前固定使用在线服务；旧动作选择“仅使用离线引擎”时转为本地 OCR。新动作请直接选择“本地 OCR”。",
      "isAdvanced": true,
      "validForList": [
        "QuickerServerOcr"
      ],
      "condition": "仅：QuickerServerOcr",
      "defaultValue": "Auto",
      "variableMode": "Input"
    },
    {
      "key": "modelTier",
      "name": "模型",
      "type": "Enum",
      "description": "标准=small（更准更大，默认）；快速=tiny（更快更小）。切换后如未安装会下载对应模型包。表格识别固定用 small，不出现此参数。",
      "validForList": [
        "LocalOcr"
      ],
      "condition": "仅：LocalOcr",
      "defaultValue": "small",
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "textList",
      "name": "行列表",
      "type": "List",
      "description": "OCR识别结果，列表格式，每行一项。",
      "validForList": [
        "QuickerServerOcr",
        "LocalOcr",
        "WindowsOcr",
        "baidu-basic",
        "baidu-quicker"
      ],
      "condition": "仅：QuickerServerOcr, LocalOcr, WindowsOcr, baidu-basic, baidu-quicker"
    },
    {
      "key": "content",
      "name": "合并后结果",
      "type": "Text",
      "description": "合并在一起的的文本内容",
      "validForList": [
        "QuickerServerOcr",
        "LocalOcr",
        "WindowsOcr",
        "baidu-basic",
        "baidu-quicker",
        "table_quicker"
      ],
      "condition": "仅：QuickerServerOcr, LocalOcr, WindowsOcr, baidu-basic, baidu-quicker, table_quicker"
    },
    {
      "key": "rawData",
      "name": "原始结果",
      "type": "Text",
      "description": "原始结果。表格识别为 ApiResult JSON（Data.Html / Data.Tsv）；其它引擎为接口原始内容。"
    },
    {
      "key": "rawObject",
      "name": "原始结果JObject对象",
      "type": "Object",
      "description": "返回结果的JObject对象",
      "validForList": [
        "baidu-basic",
        "baidu-quicker",
        "baidu-custom"
      ],
      "condition": "仅：baidu-basic, baidu-quicker, baidu-custom"
    }
  ],
