  "ownsLegacyContent": true,
  "name": "Excel文件读写",
  "description": "读取Excel文件内容或写入Excel文件",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/excelreadwrite",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "fileType",
      "name": "工作簿类型",
      "type": "Enum",
      "validForList": [
        "newWorkbook"
      ],
      "condition": "仅：newWorkbook",
      "defaultValue": "XSSF",
      "variableMode": "Input"
    },
    {
      "key": "filePath",
      "name": "文件路径",
      "type": "Text",
      "description": "要打开或写入的Excel文件路径",
      "validForList": [
        "load",
        "save"
      ],
      "condition": "仅：load, save",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "readDataMap",
      "name": "提取数据定义",
      "type": "Text",
      "description": "每行一条规则：\"字段:[工作表序号或名称]单元格地址\"，详情请参考模块文档。",
      "validForList": [
        "readData"
      ],
      "condition": "仅：readData",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "workbook",
      "name": "工作簿对象",
      "type": "Object",
      "description": "需要操作的工作簿对象",
      "validForList": [
        "save",
        "getSheet",
        "getSheetByIndex",
        "getSheetByName",
        "createSheet",
        "readData",
        "addNames"
      ],
      "condition": "仅：save, getSheet, getSheetByIndex, getSheetByName, createSheet, readData, addNames",
      "defaultValue": "",
      "variableMode": "UseVarOnly"
    },
    {
      "key": "sheetIndex",
      "name": "工作表序号或名称",
