{
  "key": "sys:fileOperation",
  "slug": "fileoperation",
  "legacySlug": "fileoperation",
  "ownsLegacyContent": true,
  "name": "文件和目录操作",
  "description": "文件和目录操作。请确保路径是合法的。",
  "category": "Files",
  "categoryName": "系统操作",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/fileoperation",
  "inputs": [
    {
      "key": "type",
      "name": "操作类型",
      "type": "Enum",
      "description": "操作类型",
      "defaultValue": "",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "path",
      "name": "路径",
      "type": "Text",
      "description": "要操作的文件或文件夹路径",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "dstPath",
      "name": "目标路径/名称",
      "type": "Text",
      "description": "复制/移动的目标路径或新文件、文件名。详情请参考文档。",
      "validForList": [
        "copyInto",
        "copyIntoWithShell",
        "copyTo",
        "moveInto",
        "moveIntoWithShell",
        "rename",
        "moveTo",
        "copyFile",
        "moveFile"
      ],
      "condition": "仅：copyInto, copyIntoWithShell, copyTo, moveInto, moveIntoWithShell, rename, moveTo, copyFile, moveFile",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "overwrite",
      "name": "覆盖已有",
      "type": "Boolean",
      "description": "如果目标位置已存在文件，是否覆盖？",
      "validForList": [
        "copyInto",
        "copyTo",
        "moveInto",
        "rename",
        "moveTo",
        "copyFile",
        "moveFile"
      ],
      "condition": "仅：copyInto, copyTo, moveInto, rename, moveTo, copyFile, moveFile",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "searchPattern",
      "name": "搜索内容",
      "type": "Text",
      "description": "筛选文件或目录名。可以包含通配符*和?，或\"regex:正则表达式\"。搜索文件时也可以为分号隔开的多个后缀名如.jpg;.png;.bmp",
      "validForList": [
        "enumFiles",
        "enumDirs"
      ],
      "condition": "仅：enumFiles, enumDirs",
      "defaultValue": "*",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "isAll",
      "name": "包含子目录",
      "type": "Boolean",
      "description": "包含子目录中的(否则只搜索顶层目录)",
      "validForList": [
        "enumFiles",
        "enumDirs"
      ],
      "condition": "仅：enumFiles, enumDirs",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "timeoutSeconds",
      "name": "超时时间（秒）",
      "type": "Integer",
      "description": "获取列表的最长等待时间，0表示不限时。超时返回失败；网络盘底层读取可能仍在后台等待恢复。",
      "validForList": [
        "enumFiles",
        "enumDirs"
      ],
      "condition": "仅：enumFiles, enumDirs",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后中止动作",
      "type": "Boolean",
      "description": "如果操作异常，是否终止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "files",
      "name": "路径列表",
      "type": "List",
      "description": "搜索到的文件或文件夹列表",
      "validForList": [
        "enumFiles",
        "enumDirs"
      ],
      "condition": "仅：enumFiles, enumDirs"
    },
    {
      "key": "resultPath",
      "name": "结果路径",
      "type": "Text",
      "description": "结果文件路径",
      "validForList": [
        "copyInto",
        "copyTo",
        "rename"
      ],
      "condition": "仅：copyInto, copyTo, rename"
    }
  ],
  "selections": {
    "type": {
      "name": "操作类型",
      "items": [
        {
          "value": "copyInto",
          "name": "复制到指定目录下"
        },
        {
          "value": "copyIntoWithShell",
          "name": "复制到指定目录下(Windows)"
        },
        {
          "value": "copyTo",
          "name": "复制为（指定结果名称或路径）"
        },
        {
          "value": "moveInto",
          "name": "移动到指定目录下"
        },
        {
          "value": "moveIntoWithShell",
          "name": "移动到指定目录下(Windows)"
        },
        {
          "value": "rename",
          "name": "移动/重命名为（指定结果名称或完整路径）"
        },
        {
          "value": "deleteFile",
          "name": "删除文件（不支持文件夹）"
        },
        {
          "value": "deleteEmptyFolder",
          "name": "删除空文件夹"
        },
        {
          "value": "recycle",
          "name": "移入回收站"
        },
        {
          "value": "recycleNoUi",
          "name": "移入回收站（安静模式，自动确认操作）"
        },
        {
          "value": "makeDir",
          "name": "创建文件夹"
        },
        {
          "value": "createFile",
          "name": "创建空文件"
        },
        {
          "value": "enumFiles",
          "name": "获取文件夹内的文件"
        },
        {
          "value": "enumDirs",
          "name": "获取文件夹内的子文件夹"
        },
        {
          "value": "copyFile",
          "name": "复制文件/文件夹（自动）【不建议使用】"
        },
        {
          "value": "moveFile",
          "name": "移动/重命名文件(夹)（自动）【不建议使用】"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
