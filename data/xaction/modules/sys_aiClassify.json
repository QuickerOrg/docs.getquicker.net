{
  "key": "sys:aiClassify",
  "slug": "ai-classify",
  "legacySlug": "ai-classify",
  "ownsLegacyContent": true,
  "name": "AI 文本分类",
  "description": "使用全局 AI 设置从给定分类中选择一个稳定 Key",
  "category": "Ai",
  "categoryName": "AI",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/ai-classify",
  "inputs": [
    {
      "key": "reasoningEffort",
      "name": "推理强度",
      "type": "Enum",
      "description": "跟随模型默认保持现有行为；自动不发送推理参数。其它档位覆盖模型默认值，须由实际模型支持；Extra/Max 可兼容映射，不支持且无法映射时执行失败。",
      "isAdvanced": true,
      "defaultValue": "model",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "text",
      "name": "文本",
      "type": "Text",
      "description": "要判断类别的文本，例如邮件正文或用户反馈。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "categories",
      "name": "分类项",
      "type": "Dict",
      "description": "Key 是供后续分支使用的稳定结果，Value 是分类说明。例如 Spam=垃圾邮件。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "defaultKey",
      "name": "无法判断时的默认 Key",
      "type": "Text",
      "description": "模型返回未知 Key 时使用的已有分类 Key；留空则步骤失败。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "instructions",
      "name": "判断标准",
      "type": "Text",
      "description": "补充分类依据，例如“促销邮件也归为 Spam”。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "useCaseId",
      "name": "AI 任务场景",
      "type": "Text",
      "description": "选择用于分类的文本任务场景；所选模型必须明确支持结构化输出。",
      "defaultValue": "text.general",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "missingUseCaseBehavior",
      "name": "任务场景缺失时",
      "type": "Enum",
      "description": "自定义任务场景不存在时，使用内置文本任务场景或直接失败。",
      "isAdvanced": true,
      "defaultValue": "UseBaseUseCase",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxOutputTokens",
      "name": "最大输出 Token",
      "type": "Integer",
      "isAdvanced": true,
      "defaultValue": "512",
      "defaultValueRaw": 512,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "categoryKey",
      "name": "分类 Key",
      "type": "Text"
    },
    {
      "key": "reason",
      "name": "分类理由",
      "type": "Text"
    },
    {
      "key": "resultJson",
      "name": "结果 JSON",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "usedDefaultKey",
      "name": "是否使用默认 Key",
      "type": "Boolean"
    },
    {
      "key": "model",
      "name": "实际模型",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "inputTokens",
      "name": "输入 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "cachedInputTokens",
      "name": "缓存输入 Token",
      "type": "Integer",
      "description": "服务商报告的缓存命中输入 Token；未提供时为 0。",
      "isAdvanced": true
    },
    {
      "key": "outputTokens",
      "name": "输出 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "totalTokens",
      "name": "总 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "invocationId",
      "name": "调用标识",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "resolvedUseCaseId",
      "name": "实际任务场景",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "useCaseFallbackUsed",
      "name": "是否回退场景",
      "type": "Boolean",
      "isAdvanced": true
    }
  ],
  "selections": {
