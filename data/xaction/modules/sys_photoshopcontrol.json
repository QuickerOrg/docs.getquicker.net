{
  "key": "sys:photoshopcontrol",
  "slug": "photoshopcontrol",
  "legacySlug": "photoshopcontrol",
  "ownsLegacyContent": true,
  "name": "Photoshop控制",
  "description": "通过 Photoshop UXP 插件调用文档、图层、选择、图像与脚本能力。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/photoshopcontrol",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "document.get_context",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "layerId",
      "name": "图层 ID",
      "type": "Number",
      "validForList": [
        "layer.select",
        "layer.rename",
        "layer.set_visibility",
        "layer.duplicate",
        "layer.delete"
      ],
      "condition": "仅：layer.select, layer.rename, layer.set_visibility, layer.duplicate, layer.delete",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "layerName",
      "name": "图层名称",
      "type": "Text",
      "validForList": [
        "layer.rename"
      ],
      "condition": "仅：layer.rename",
      "defaultValue": "新名称",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "visible",
      "name": "可见",
      "type": "Boolean",
      "validForList": [
        "layer.set_visibility"
      ],
      "condition": "仅：layer.set_visibility",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "append",
      "name": "追加选择",
      "type": "Boolean",
      "validForList": [
        "layer.select"
      ],
      "condition": "仅：layer.select",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "width",
      "name": "宽度",
      "type": "Number",
