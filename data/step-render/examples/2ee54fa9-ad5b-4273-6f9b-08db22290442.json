{
  "code": "2ee54fa9-ad5b-4273-6f9b-08db22290442",
  "title": "AI写诗",
  "description": "给出提示词，请AI写诗并输出到当前窗口",
  "author": "CL",
  "revision": 2,
  "source": "https://getquicker.net/sharedaction?code=2ee54fa9-ad5b-4273-6f9b-08db22290442",
  "pulledAt": "2026-08-11T21:28:52.699Z",
  "variables": [
    {
      "name": "text",
      "type": "Text",
      "remark": "默认的文本变量"
    },
    {
      "name": "apikey",
      "type": "Text"
    },
    {
      "name": "result",
      "type": "Text"
    },
    {
      "name": "isSuccess",
      "type": "Boolean"
    }
  ],
  "steps": [
    {
      "key": "sys:comment",
      "inputs": {
        "note": "获取选中文本，失败时手动输入"
      }
    },
    {
      "key": "sys:getSelectedText",
      "inputs": {
        "format": "UnicodeText",
        "waitMs": "250",
        "repeat": "0",
        "trim": "0",
        "useActionParam": "0",
        "stopIfFail": "0"
      },
      "outputs": {
        "isSuccess": "isSuccess",
        "output": "text"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "如果没有ApiKey，则提示用户输入"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$={apikey}.IsNullOrWhiteSpace()"
      },
      "ifSteps": [
        {
          "key": "sys:userInput",
          "inputs": {
            "type": "text",
            "prompt": "请输入API Key",
            "isRequired": "1",
            "restoreFocus": "1",
            "closeOnDeactivated": "0",
            "topMost": "0",
            "stopIfFail": "1",
            "fontsize": "14",
            "winLocation": "CenterScreen",
            "imeState": "NO_CONTROL"
          },
          "outputs": {
            "textValue": "apikey"
          }
        }
      ]
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "如果没有获取到文本，这里显示对话框请用户输入"
      }
    },
    {
      "key": "sys:if",
      "inputs": {
        "condition": "{isSuccess}"
      },
      "elseSteps": [
        {
          "key": "sys:userInput",
          "inputs": {
            "type": "text",
            "prompt": "请输入诗歌提示词：",
            "isRequired": "0",
            "restoreFocus": "1",
            "closeOnDeactivated": "0",
            "topMost": "0",
            "stopIfFail": "1",
            "fontsize": "14",
            "winLocation": "CenterScreen",
            "imeState": "NO_CONTROL"
          },
          "outputs": {
            "textValue": "text"
          }
        }
      ]
    },
    {
      "key": "sys:showText",
      "inputs": {
        "type": "NO_WAIT",
        "text": "翻译结果：\r\n",
        "title": "结果内容",
        "topMost": "false",
        "stopIfFail": "1",
        "autoCloseKey": "=",
        "winLocation": "CenterScreen",
        "fontsize": "14",
        "closeWhenLostFocus": "false",
        "showLineNum": "true",
        "autoWrap": "true",
        "showBuildInToolbar": "true",
        "copyWholeLine": "false",
        "caretPosition": "0",
        "updateIfExists": "0"
      },
      "disabled": true
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "恢复焦点"
      }
    },
    {
      "key": "sys:restoreActiveWindow"
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "发送标题"
      }
    },
    {
      "key": "sys:outputText",
      "inputs": {
        "content": "$$一首关于 {text} 的诗歌：\r\n",
        "method": "input",
        "delayBetweenChar": "0",
        "appendReturn": "0"
      }
    },
    {
      "key": "sys:ai",
      "inputs": {
        "endpoint": "chat",
        "model": "gpt-3.5-turbo",
        "systemPrompt": "你是一位诗人。",
        "prompt": "$$请根据下面的提示词写一首诗歌：\r\n{text}",
        "maxTokens": "0",
        "temperature": "0.6",
        "stopIfFail": "1",
        "apiKey": "{apikey}",
        "topP": "1",
        "n": "1",
        "stream": "1",
        "streamTo": "INPUT_TEXT",
        "expireSeconds": "30",
        "forceProxy": "1"
      },
      "outputs": {
        "result": "result"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "将最终结果写入剪贴板，避免中间切换窗口导致的输出中断"
      }
    },
    {
      "key": "sys:writeClipboard",
      "inputs": {
        "type": "auto",
        "input": "{result}",
        "successMsg": "生成结束，已复制到剪贴板。",
        "stopIfFail": "1"
      }
    },
    {
      "key": "sys:notify",
      "inputs": {
        "msg": "$$完成了\r\n{result}",
        "maxLines": "0",
        "type": "Success",
        "style": "Default"
      },
      "disabled": true
    }
  ]
}
