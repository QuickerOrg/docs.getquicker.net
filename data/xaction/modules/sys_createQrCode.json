{
  "key": "sys:createQrCode",
  "slug": "createqrcode",
  "legacySlug": "createqrcode",
  "ownsLegacyContent": true,
  "name": "生成二维码",
  "description": "将文本转换为二维码",
  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/createqrcode",
  "inputs": [
    {
      "key": "code",
      "name": "文本",
      "type": "Text",
      "description": "要转换为二维码的内容",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "pixelsPerModule",
      "name": "每模块像素数",
      "type": "Integer",
      "defaultValue": "4",
      "defaultValueRaw": 4,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "darkColor",
      "name": "暗色",
      "type": "Text",
      "description": "#AARRGGBB格式的颜色值",
      "defaultValue": "#FF000000",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "lightColor",
      "name": "亮色",
      "type": "Text",
      "description": "#AARRGGBB格式的颜色值",
      "defaultValue": "#FFFFFFFF",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "icon",
      "name": "图标",
      "type": "Image",
      "description": "图片变量或图标文件路径",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "iconPercent",
      "name": "图标占比",
      "type": "Integer",
      "description": "百分比数字（只填数字，不写百分号）",
      "defaultValue": "15",
      "defaultValueRaw": 15,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "iconBorderWidth",
      "name": "图标边框宽度",
      "type": "Integer",
      "description": "最小为1",
      "defaultValue": "6",
      "defaultValueRaw": 6,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "drawQuietZones",
      "name": "绘制外框",
      "type": "Boolean",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "saveToPdfPath",
      "name": "输出pdf文件",
      "type": "Text",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "img",
      "name": "二维码图片",
      "type": "Image",
      "description": "生成的二维码图片对象"
    },
    {
      "key": "svg",
      "name": "SVG格式结果",
      "type": "Text",
      "description": "Svg格式结果代码"
    },
    {
      "key": "ascii",
      "name": "Ascii格式结果",
      "type": "Text",
      "description": "Ascii字符格式结果代码"
    }
  ],
  "sourceFileName": "catalog.json"
}
