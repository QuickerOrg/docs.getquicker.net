{
  "key": "sys:MsgBox",
  "slug": "msgbox",
  "legacySlug": "msgbox",
  "ownsLegacyContent": true,
  "name": "弹窗提示或确认",
  "description": "弹窗显示提示或确认对话框",
  "category": "Basic",
  "categoryName": "基础",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/msgbox",
  "inputs": [
    {
      "key": "operation",
      "name": "模式",
      "type": "Enum",
      "defaultValue": "default",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "message",
      "name": "消息内容",
      "type": "Text",
      "description": "弹窗显示的消息内容。\"自定义\"模式时，也支持\"MD:Markdown内容\"。",
      "defaultValue": "Hello.",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "title",
      "name": "标题",
      "type": "Text",
      "description": "消息窗口标题。留空时自动使用动作名称。",
      "defaultValue": "Quicker",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "icon",
      "name": "图标",
      "type": "Enum",
      "description": "消息窗口图标",
      "validForList": [
        "default"
      ],
      "condition": "仅：default",
      "defaultValue": "Information",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "customIcon",
      "name": "图标",
      "type": "Text",
      "description": "消息窗口图标。",
      "validForList": [
        "custom"
      ],
      "condition": "仅：custom",
      "defaultValue": "Information",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "buttons",
      "name": "按钮",
      "type": "Enum",
      "description": "消息窗口图标",
      "validForList": [
        "default"
      ],
      "condition": "仅：default",
      "defaultValue": "OK",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "customButtons",
      "name": "按钮",
      "type": "Text",
      "description": "每行定义一个按钮，格式为 \"文本\" 或 \"[图标]显示文本(提示内容)|值\"。",
      "validForList": [
        "custom"
      ],
      "condition": "仅：custom",
      "defaultValue": "[fa:Regular_Check:#4caf50]是(_Y)|Yes\r\n[fa:Regular_Times:#dc3545]否(_N)|No\r\n[fa:Light_Undo:#444444]取消(_C)|Cancel",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "defaultButton",
      "name": "默认按钮",
      "type": "Text",
      "description": "指定默认按钮的值。默认按钮以高亮颜色显示，可直接回车选择。",
      "validForList": [
        "custom"
      ],
      "condition": "仅：custom",
      "defaultValue": "Yes",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "restoreFocus",
      "name": "恢复活动窗口",
      "type": "Boolean",
      "description": "关闭弹窗后，是否将焦点还原到之前的活动窗口",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "result",
      "name": "选择的按钮",
      "type": "Text",
      "description": "点击的按钮，标准模式下结果可能为OK,Cancel,Yes,No，自定义模式下为按钮的值。"
    },
    {
      "key": "okOrYes",
      "name": "是否确认",
      "type": "Boolean",
      "description": "选择的按钮是否为\"确定\"或\"是\"",
      "validForList": [
        "default"
      ],
      "condition": "仅：default"
    }
  ],
  "selections": {
    "operation": {
      "name": "模式",
      "items": [
        {
          "value": "default",
          "name": "标准"
        },
        {
          "value": "custom",
          "name": "自定义"
        }
      ]
    },
    "icon": {
      "name": "图标",
      "items": [
        {
          "value": "None",
          "name": "无"
        },
        {
          "value": "Information",
          "name": "信息"
        },
        {
          "value": "Question",
          "name": "疑问"
        },
        {
          "value": "Warning",
          "name": "警告"
        },
        {
          "value": "Error",
          "name": "错误"
        }
      ]
    },
    "customIcon": {
      "name": "图标",
      "items": [
        {
          "value": "",
          "name": "无"
        },
        {
          "value": "Information",
          "name": "信息"
        },
        {
          "value": "Question",
          "name": "疑问"
        },
        {
          "value": "Warning",
          "name": "警告"
        },
        {
          "value": "Error",
          "name": "错误"
        }
      ]
    },
    "buttons": {
      "name": "按钮",
      "items": [
        {
          "value": "OK",
          "name": "确定"
        },
        {
          "value": "OKCancel",
          "name": "确定/取消"
        },
        {
          "value": "YesNo",
          "name": "是/否"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
