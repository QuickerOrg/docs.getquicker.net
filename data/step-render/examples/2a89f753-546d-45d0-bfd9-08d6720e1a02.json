{
  "code": "2a89f753-546d-45d0-bfd9-08d6720e1a02",
  "title": "插入日期时间",
  "description": "在当前位置插入时间/日期",
  "author": "CL",
  "revision": 4,
  "source": "https://getquicker.net/sharedaction?code=2a89f753-546d-45d0-bfd9-08d6720e1a02",
  "pulledAt": "2026-08-11T21:28:46.045Z",
  "variables": [
    {
      "name": "context",
      "type": "Text",
      "remark": "默认的文本变量"
    },
    {
      "name": "img",
      "type": "Image",
      "remark": "默认的图片变量"
    },
    {
      "name": "time",
      "type": "DateTime"
    },
    {
      "name": "format",
      "type": "Text"
    },
    {
      "name": "formatList",
      "type": "Text"
    }
  ],
  "steps": [
    {
      "key": "sys:getCurrentTime",
      "inputs": {
        "useUtc": "0"
      },
      "outputs": {
        "output": "time"
      }
    },
    {
      "key": "sys:formatString",
      "inputs": {
        "formatString": "$${0:yyyy-MM-dd}\r\n{0:yyyy.MM.dd}\r\n{0:yyyy/MM/dd}\r\n{0:yyyy年MM月dd日}\r\n{0:yyyy-MM-dd HH:mm}\r\n{0:yyyy/MM/dd HH:mm}\r\n{0:yyyy年MM月dd日HH时mm分}\r\n{0:yyyy-MM-dd HH:mm:ss}\r\n{0:yyyy/MM/dd HH:mm:ss}\r\n{0:HH:mm}\r\n{0:HH:mm:ss}",
        "p0": "{time}"
      },
      "outputs": {
        "output": "formatList"
      }
    },
    {
      "key": "sys:select",
      "inputs": {
        "type": "single",
        "prompt": "请选择格式",
        "items": "{formatList}",
        "autoCloseSeconds": "0",
        "winLocation": "WithMouse1",
        "keepLastPos": "1",
        "noKeyboard": "0",
        "closeOnDeactivated": "0",
        "showFilter": "0",
        "restoreForeground": "1",
        "allowOkWhenEmpty": "0",
        "stopIfCancel": "1"
      },
      "outputs": {
        "textValue": "context"
      }
    },
    {
      "key": "sys:restoreActiveWindow"
    },
    {
      "key": "sys:outputText",
      "inputs": {
        "content": "{context}",
        "method": "paste"
      }
    }
  ]
}
