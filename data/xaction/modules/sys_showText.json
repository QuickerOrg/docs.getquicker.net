{
  "key": "sys:showText",
  "slug": "showtext",
  "legacySlug": "showtext",
  "ownsLegacyContent": true,
  "name": "文本窗口",
  "description": "在独立的窗口中显示文本。",
  "category": "Text",
  "categoryName": "文本处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/showtext",
  "inputs": [
    {
      "key": "type",
      "name": "操作类型",
      "type": "Enum",
      "description": "是否等待窗口关闭后继续",
      "defaultValue": "NO_WAIT",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "text",
      "name": "文本内容",
      "type": "Text",
      "description": "要显示的文本内容",
      "validForList": [
        "WAIT",
        "NO_WAIT",
        "APPEND_TEXT"
      ],
      "condition": "仅：WAIT, NO_WAIT, APPEND_TEXT",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "title",
      "name": "窗口标题",
      "type": "Text",
      "description": "窗口标题文字",
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "文本窗口",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "operations",
      "name": "工具栏操作",
      "type": "Text",
      "description": "用于显示在窗口工具栏。每行一个选项，格式为 \"文本\" 或 \"显示文本|值\"。",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "autoCloseKey",
      "name": "文本窗口标识",
      "type": "Text",
      "description": "可选。自动更新或关闭之前打开的具有此标识的文本窗口。使用'='表示当前动作id。",
      "validForList": [
        "WAIT",
        "NO_WAIT",
        "CLOSE_WINDOW",
        "GET_WIN_INFO",
        "APPEND_TEXT",
        "ACTIVATE_WINDOW",
        "WAIT_CLOSE"
      ],
      "condition": "仅：WAIT, NO_WAIT, CLOSE_WINDOW, GET_WIN_INFO, APPEND_TEXT, ACTIVATE_WINDOW, WAIT_CLOSE",
      "defaultValue": "=",
      "variableMode": "Input"
    },
    {
      "key": "winLocation",
      "name": "窗口位置类型",
      "type": "Enum",
      "description": "在哪里显示选择窗口",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "CenterScreen",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "winSize",
      "name": "窗口尺寸/位置",
      "type": "Text",
      "description": "宽度,高度：逻辑像素或屏幕工作区百分比；自定义位置填坐标。",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "rememberWindowPlacement",
      "name": "记住上次位置和大小",
      "type": "Boolean",
      "description": "关闭窗口后保存位置和大小，下次运行此动作时恢复。按文本窗口标识分别记忆；全屏或最大化的位置类型不使用记忆位置。",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "topMost",
      "name": "置顶显示",
      "type": "Boolean",
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "fontsize",
      "name": "字体大小",
      "type": "Number",
      "description": "默认的字体大小",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "14.0",
      "defaultValueRaw": 14,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "fontfamily",
      "name": "字体名称",
      "type": "Text",
      "description": "可选。设置字体名称。如有多个字体，使用逗号分隔。",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bgColor",
      "name": "背景颜色",
      "type": "Text",
      "description": "可选。格式为#RRGGBB",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "textColor",
      "name": "文字颜色",
      "type": "Text",
      "description": "可选。格式为#RRGGBB",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "highlight",
      "name": "语法高亮",
      "type": "Enum",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "autoSaveToState",
      "name": "自动保存到状态",
      "type": "Text",
      "description": "指定状态Key。文本内容将自动保存到状态中。",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "showLineNum",
      "name": "显示行号",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "autoWrap",
      "name": "自动换行显示",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "copyWholeLine",
      "name": "未选择内容时，复制或剪切整行",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "closeWhenLostFocus",
      "name": "失去焦点自动关闭",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "enableEscClose",
      "name": "Esc 键关闭窗口",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "updateIfExists",
      "name": "如果窗口存在，则直接更新窗口内容（而不是关闭后打开新窗口）",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "NO_WAIT"
      ],
      "condition": "仅：NO_WAIT",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "showBuildInToolbar",
      "name": "显示内置工具栏",
      "type": "Boolean",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "caretPosition",
      "name": "光标位置",
      "type": "Integer",
      "description": "0表示最前面，-1表示最后面，其它数字表示某个具体字符位置。",
      "isAdvanced": true,
      "validForList": [
        "WAIT",
        "NO_WAIT"
      ],
      "condition": "仅：WAIT, NO_WAIT",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "advancedSettings",
      "name": "高级设置",
      "type": "Text",
      "description": "请参考模块文档。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
