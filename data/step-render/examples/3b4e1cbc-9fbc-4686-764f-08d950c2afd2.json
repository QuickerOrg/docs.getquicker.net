      "type": "Boolean",
      "remark": "自动粘贴替换"
    },
    {
      "name": "resultText",
      "type": "Text"
    },
    {
      "name": "isSuccess",
      "type": "Boolean",
      "remark": "是否成功获取内容。"
    }
  ],
  "steps": [
    {
      "key": "sys:comment",
      "inputs": {
        "note": "动作设置菜单处理"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$= {quicker_in_param} == \"settings\""
      },
      "ifSteps": [
        {
          "key": "sys:form",
          "inputs": {
            "title": "动作设置",
            "formDef": "{\"Fields\":[{\"FieldKey\":\"vendor\",\"Label\":\"厂商类型\",\"HelpText\":\"\",\"HelpLink\":null,\"InputMethod\":3,\"SelectionItems\":\"百度|Baidu\\r\\n腾讯|Tencent\\r\\n有道|Youdao\\r\\n彩云|Caiyun\\r\\n阿里云|Aliyun\\r\\n讯飞(小牛引擎)|XunfeiNiutrans\\r\\n谷歌|Google\",\"IsRequired\":true,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"srcLang\",\"Label\":\"源语言\",\"HelpText\":\"自动：Auto，其他请参考所用厂商接口文档。\",\"HelpLink\":null,\"InputMethod\":11,\"SelectionItems\":\"Auto\\r\\nZhCn\\r\\nEn\\r\\nJa\\r\\nKo\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"dstLang\",\"Label\":\"目标语言\",\"HelpText\":\"自动为Auto，其他请参考厂商接口文档\",\"HelpLink\":null,\"InputMethod\":11,\"SelectionItems\":\"Auto\\r\\nZhCn\\r\\nEn\\r\\nJa\\r\\nKo\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"},{\"FieldKey\":\"autoPaste\",\"Label\":\"自动粘贴替换\",\"HelpText\":\"自动粘贴翻译结果，否则只复制到剪贴板。\",\"HelpLink\":null,\"InputMethod\":6,\"SelectionItems\":\"\",\"IsRequired\":false,\"MinValue\":\"\",\"MaxValue\":\"\",\"Pattern\":\"\",\"MaxLength\":0,\"ImeState\":null,\"TextTools\":\"\",\"VisibleExpression\":\"\"}]}",
            "titleColumnWidth": "100",
            "windowWidth": "500",
            "restoreFocus": "0",
            "topMost": "false",
            "stopIfFail": "1"
          }
        },
        {
          "key": "sys:stop",
          "inputs": {
            "method": "default",
            "isError": "0"
          }
        }
      ]
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "正常翻译处理"
      }
    },
    {
      "key": "sys:getSelectedText",
      "inputs": {
        "format": "UnicodeText",
        "repeat": "0",
        "useActionParam": "0",
        "stopIfFail": "0"
      },
      "outputs": {
        "output": "text",
        "isSuccess": "isSuccess"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$= String.IsNullOrEmpty({text})"
      },
      "ifSteps": [
        {
          "key": "sys:quickeroperations",
          "inputs": {
            "type": "StartSearchWithAction"
          }
        },
        {
          "key": "sys:stop",
          "inputs": {
            "method": "default",
            "isError": "0"
          }
        }
      ]
    },
    {
      "key": "sys:translation",
      "inputs": {
        "operation": "single",
        "text": "{text}",
        "srcLang": "{srcLang}",
        "dstLang": "{dstLang}",
        "vendor": "{vendor}",
        "stopIfFail": "1"
      },
      "outputs": {
        "resultText": "resultText"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "根据选项粘贴或仅复制"
      }
    },
    {
      "key": "sys:if",
      "inputs": {
        "condition": "{autoPaste}"
      },
      "ifSteps": [
        {
          "key": "sys:outputText",
          "inputs": {
            "content": "{resultText}",
            "method": "paste",
            "delayBeforePaste": "50",
            "delayAfterPaste": "10",
            "appendReturn": "0"
          }
        }
      ],
      "elseSteps": [
        {
          "key": "sys:writeClipboard",
          "inputs": {
            "type": "auto",
            "input": "{resultText}",
            "successMsg": "$$已写入剪贴板\r\n{resultText}",
            "stopIfFail": "1"
          }
        }
      ]
    }
  ]
}
