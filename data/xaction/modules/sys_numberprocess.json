      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "srcNumber",
      "name": "原始数字",
      "type": "Number",
      "validForList": [
        "toString",
        "toInteger"
      ],
      "condition": "仅：toString, toInteger",
      "defaultValue": "0.0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "decimalPlace",
      "name": "保留小数位",
      "type": "Integer",
      "validForList": [
        "toString"
      ],
      "condition": "仅：toString",
      "defaultValue": "2",
      "defaultValueRaw": 2,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "roundingMethod",
      "name": "舍入方式",
      "type": "Enum",
      "validForList": [
        "toString"
      ],
      "condition": "仅：toString",
      "defaultValue": "Round45",
      "variableMode": "Input"
    },
    {
      "key": "toIntegerMethod",
      "name": "取整方式",
      "type": "Enum",
      "validForList": [
        "toInteger"
      ],
      "condition": "仅：toInteger",
      "defaultValue": "Round45",
      "variableMode": "Input"
    },
    {
      "key": "srcNumberStr",
      "name": "原始数字(文本)",
      "type": "Text",
      "validForList": [
        "baseConversion"
      ],
      "condition": "仅：baseConversion",
      "defaultValue": "0",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "srcBase",
      "name": "原始数字进制",
      "type": "Integer",
      "description": "可选0/2/8/16。0为自动判断：全由0、1构成判断为二进制，0x开始或包含A-D判断为16进制，其它判断为10进制。",
      "validForList": [
        "baseConversion"
      ],
      "condition": "仅：baseConversion",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
