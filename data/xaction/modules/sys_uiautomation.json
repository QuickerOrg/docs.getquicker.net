{
  "key": "sys:uiautomation",
  "slug": "uiautomation",
  "legacySlug": "uiautomation",
  "ownsLegacyContent": true,
  "name": "窗口界面控制",
  "description": "触发Windows窗口的菜单/按钮等控件。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/uiautomation",
  "inputs": [
    {
      "key": "type",
      "name": "操作类型",
      "type": "Enum",
      "description": "操作类型。按下和抬起需要配对使用。",
      "defaultValue": "TriggerMenu",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "window",
      "name": "窗口句柄",
      "type": "Text",
      "description": "要操作哪个窗口的控件。不填写或填写0=使用前台窗口；或窗口句柄数字。",
      "validForList": [
        "TriggerMenu",
        "TriggerControl",
        "GetControlInfo"
      ],
      "condition": "仅：TriggerMenu, TriggerControl, GetControlInfo",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "menuPath",
      "name": "菜单路径",
      "type": "Text",
      "description": "菜单的展开路径。每行写一个级别的菜单名（需完全匹配）",
      "validForList": [
        "TriggerMenu"
      ],
      "condition": "仅：TriggerMenu",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "expandDelay",
      "name": "展开延时",
      "type": "Integer",
      "description": "等待下级菜单展开的时间(ms)",
      "validForList": [
        "TriggerMenu"
      ],
      "condition": "仅：TriggerMenu",
      "defaultValue": "200",
      "defaultValueRaw": 200,
      "variableMode": "Input"
    },
    {
      "key": "control",
      "name": "控件名",
      "type": "Text",
      "description": "控件名，请确保唯一性。",
      "validForList": [
        "TriggerControl",
        "GetControlInfo"
      ],
      "condition": "仅：TriggerControl, GetControlInfo",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "controlType",
      "name": "控件类型",
      "type": "Enum",
      "description": "可选。当有多个名称相同但类型不同的控件时区分。",
      "validForList": [
        "TriggerControl",
        "GetControlInfo"
      ],
      "condition": "仅：TriggerControl, GetControlInfo",
      "defaultValue": "0",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "controlOperation",
      "name": "动作",
      "type": "Enum",
      "description": "对控件执行的操作。",
      "validForList": [
        "TriggerControl"
      ],
      "condition": "仅：TriggerControl",
      "defaultValue": "Auto",
      "variableMode": "Input"
    },
    {
      "key": "noWait",
      "name": "不等待操作完成",
      "type": "Boolean",
      "description": "提交后立即执行后续步骤，不保证控件操作已完成。是否成功仅表示提交成功；后台失败只记录日志，不触发失败后停止。涉及鼠标、键盘或焦点的操作可能与后续步骤互相影响，请按需等待目标状态。",
      "validForList": [
        "TriggerControl"
      ],
      "condition": "仅：TriggerControl",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "value",
      "name": "值",
      "type": "Text",
      "description": "仅用于 \"设置值\" 操作。",
      "validForList": [
        "TriggerControl"
      ],
      "condition": "仅：TriggerControl",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "pointLocation",
      "name": "坐标位置",
      "type": "Text",
      "description": "指定要检查的控件的屏幕坐标位置，格式为\"x,y\"",
      "validForList": [
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfoByPosition",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "path",
      "name": "路径",
      "type": "Text",
      "description": "要更新的路径",
      "validForList": [
        "UpdateSaveAsDialogPath"
      ],
      "condition": "仅：UpdateSaveAsDialogPath",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "autoCreateDir",
      "name": "自动创建文件夹",
      "type": "Enum",
      "description": "如果目录不存在则自动创建。",
      "validForList": [
        "UpdateSaveAsDialogPath"
      ],
      "condition": "仅：UpdateSaveAsDialogPath",
      "defaultValue": "no",
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "value",
      "name": "值",
      "type": "Text",
      "description": "控件的值",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "controlText",
      "name": "文本",
      "type": "Text",
      "description": "获取控件上的文本。根据控件不同，可能从Value、Text、Name等信息获取。",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "rect",
      "name": "位置",
      "type": "Text",
      "description": "控件坐标位置",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "controlName",
      "name": "控件名称",
      "type": "Text",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "controlType",
      "name": "控件类型",
      "type": "Text",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "controlTypeId",
      "name": "控件类型ID",
      "type": "Integer",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "controlIsEnabled",
      "name": "是否启用",
      "type": "Boolean",
      "description": "控件未处于禁用状态",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "controlIsVisible",
      "name": "是否可见",
      "type": "Boolean",
      "description": "控件是否在屏幕上。",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    },
    {
      "key": "controlNativeWindowHandle",
      "name": "原始句柄",
      "type": "Integer",
      "description": "控件的原始窗口句柄(NativeWindowHandle)",
      "validForList": [
        "GetControlInfo",
        "GetCursorPointControlInfo",
        "GetFocusedControlInfo",
        "GetControlInfoByPosition"
      ],
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition"
    }
  ],
