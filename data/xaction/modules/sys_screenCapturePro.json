{
  "key": "sys:screenCapturePro",
  "slug": "screen-capture-pro",
  "legacySlug": "screen-capture-pro",
  "ownsLegacyContent": true,
  "name": "截图 Pro",
  "description": "渐进式选区截图：全屏 overlay，光标处初始选区，支持控件跟踪，双击确认。Esc 取消。",
  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "isRisky": false,
  "isProOnly": false,
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/screen-capture-pro",
  "inputs": [
    {
      "key": "delay",
      "name": "截图前延迟时间",
      "type": "Integer",
      "defaultValue": "0",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "",
      "description": "等待多少毫秒后开始截图"
    },
    {
      "key": "toClip",
      "name": "写入剪贴板",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "仅对默认确认（打勾 / 双击）生效：结束后把截图写入剪贴板。保存、复制、自定义工具栏 post.confirm 等其它出口不叠此设置，由各自工具自行处理。"
    },
    {
      "key": "pinImage",
      "name": "截图后贴图",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "仅对默认确认（打勾 / 双击）生效：结束后在选区位置贴图。其它工具栏出口（含自定义 post.confirm / post.pin）不叠此设置。"
    },
    {
      "key": "showToolbarAfterPin",
      "name": "贴图后显示工具栏",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "贴图窗口打开后是否自动显示标注工具栏。默认关闭（贴图前通常已标注）；需要时可按空格再显示。"
    },
    {
      "key": "autoAdsorb",
      "name": "自动吸附",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "开启后悬停自动吸附到控件元素；关闭时（默认）仅跟随窗口范围，滚轮再触发 UIA 精细选区。"
    },
    {
      "key": "toolbarScript",
      "name": "自定义工具栏",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "",
      "description": "可视化编辑严格 JSON 声明（挂子程序/动作）。可改用动作变量，变量内容为完整 JSON/JS。写成 JS（sp/act/run）后可视化禁用。整栏插值须以 $$ 开头，只替换 {变量名}；不要写 JS 对象简写 {foo}。推荐外置：toolbarScript → file: files/toolbar.js。留空则用默认工具栏。"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "defaultValue": "true",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "失败后是否停止动作"
    }
  ],
  "outputs": [
