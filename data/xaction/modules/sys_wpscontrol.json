{
  "key": "sys:wpscontrol",
  "slug": "wpscontrol",
  "legacySlug": "wpscontrol",
  "ownsLegacyContent": true,
  "name": "WPS Office控制",
  "description": "通过 WPS JavaScript 加载项调用文字、表格、演示、宏和脚本能力。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/wpscontrol",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "context.get",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "targetComponent",
      "name": "目标组件",
      "type": "Enum",
      "description": "同一 WPS 窗口同时承载文字、表格或演示时用于精确定位；组件专用命令会自动判断。",
      "defaultValue": "auto",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "filePath",
      "name": "文件路径",
      "type": "Text",
      "description": "文档另存为的绝对路径，扩展名应与当前 WPS 组件匹配。",
      "validForList": [
        "document.save_as"
      ],
      "condition": "仅：document.save_as",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "sheetName",
      "name": "工作表名称",
      "type": "Text",
      "validForList": [
        "sheet.activate"
      ],
      "condition": "仅：sheet.activate",
      "defaultValue": "Sheet1",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "rangeAddress",
      "name": "单元格区域",
      "type": "Text",
      "validForList": [
        "range.read",
        "range.clear",
        "range.write"
      ],
      "condition": "仅：range.read, range.clear, range.write",
      "defaultValue": "A1:C10",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "valuesJson",
      "name": "二维数据（JSON）",
      "type": "Text",
      "validForList": [
        "range.write"
      ],
      "condition": "仅：range.write",
      "defaultValue": "[[\"名称\",\"数量\"],[\"示例\",1]]",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "text",
      "name": "文字",
      "type": "Text",
      "validForList": [
        "text.insert"
      ],
      "condition": "仅：text.insert",
      "defaultValue": "来自 Quicker 的文字",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "findText",
      "name": "查找文字",
      "type": "Text",
      "validForList": [
        "text.replace"
      ],
      "condition": "仅：text.replace",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "replaceText",
      "name": "替换为",
      "type": "Text",
      "validForList": [
        "text.replace"
      ],
      "condition": "仅：text.replace",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "replaceAll",
      "name": "替换全部",
      "type": "Boolean",
      "validForList": [
        "text.replace"
      ],
      "condition": "仅：text.replace",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "slideIndex",
      "name": "幻灯片序号",
      "type": "Number",
      "validForList": [
        "slide.activate"
      ],
      "condition": "仅：slide.activate",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "slideLayout",
      "name": "版式 ID",
      "type": "Number",
      "validForList": [
        "slide.add"
      ],
      "condition": "仅：slide.add",
      "defaultValue": "12",
      "defaultValueRaw": 12,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "macroName",
      "name": "宏名称",
      "type": "Text",
      "validForList": [
        "macro.run"
      ],
      "condition": "仅：macro.run",
      "defaultValue": "模块名.函数名",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "macroArgumentsJson",
      "name": "宏参数（JSON 数组）",
      "type": "Text",
      "validForList": [
        "macro.run"
      ],
      "condition": "仅：macro.run",
      "defaultValue": "[]",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scriptCode",
      "name": "JavaScript 表达式",
      "type": "Text",
      "description": "在当前 WPS 加载项上下文执行，可直接访问 Application。",
      "validForList": [
        "script.evaluate"
      ],
      "condition": "仅：script.evaluate",
      "defaultValue": "({ app: Application.Name, version: Application.Version })",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandName",
      "name": "Bridge 命令名称",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "argumentsJson",
      "name": "参数（JSON 对象）",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitMs",
      "name": "最长等待时间(ms)",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "30000",
      "defaultValueRaw": 30000,
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "output",
      "name": "命令结果",
      "type": "Text",
      "description": "WPS 返回的 JSON 结果。"
    }
  ],
