{
  "key": "sys:aiExtract",
  "slug": "ai-extract",
  "legacySlug": "ai-extract",
  "ownsLegacyContent": true,
  "name": "AI 结构化提取",
  "description": "使用全局 AI 设置按 JSON Schema 从文本中提取结构化数据",
  "category": "Ai",
  "categoryName": "AI",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/ai-extract",
  "inputs": [
    {
      "key": "reasoningEffort",
      "name": "推理强度",
      "type": "Enum",
      "description": "跟随模型默认保持现有行为；自动不发送推理参数。其它档位覆盖模型默认值，须由实际模型支持；Extra/Max 可兼容映射，不支持且无法映射时执行失败。",
      "isAdvanced": true,
      "defaultValue": "model",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "text",
      "name": "文本",
      "type": "Text",
      "description": "要提取信息的原始文本，例如订单、邮件或日志。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "jsonSchema",
      "name": "JSON Schema",
      "type": "Text",
      "description": "定义输出对象的字段和类型；根类型必须为 object。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "instructions",
      "name": "提取要求",
      "type": "Text",
      "description": "补充字段含义或取值规则，例如“金额不包含货币符号”。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "useCaseId",
      "name": "AI 任务场景",
      "type": "Text",
      "description": "选择用于结构化提取的文本任务场景；所选模型必须明确支持结构化输出。",
      "defaultValue": "text.general",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "missingUseCaseBehavior",
      "name": "任务场景缺失时",
      "type": "Enum",
      "description": "自定义任务场景不存在时，使用内置文本任务场景或直接失败。",
      "isAdvanced": true,
      "defaultValue": "UseBaseUseCase",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxOutputTokens",
      "name": "最大输出 Token",
      "type": "Integer",
      "isAdvanced": true,
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "resultObject",
      "name": "结果对象",
      "type": "Object"
    },
    {
      "key": "resultJson",
      "name": "结果 JSON",
      "type": "Text"
    },
    {
      "key": "model",
      "name": "实际模型",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "inputTokens",
      "name": "输入 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "cachedInputTokens",
      "name": "缓存输入 Token",
      "type": "Integer",
      "description": "服务商报告的缓存命中输入 Token；未提供时为 0。",
      "isAdvanced": true
    },
    {
      "key": "outputTokens",
      "name": "输出 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "totalTokens",
      "name": "总 Token",
      "type": "Integer",
      "isAdvanced": true
    },
    {
      "key": "finishReason",
      "name": "结束原因",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "invocationId",
      "name": "调用标识",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "resolvedUseCaseId",
      "name": "实际任务场景",
      "type": "Text",
      "isAdvanced": true
    },
    {
      "key": "useCaseFallbackUsed",
      "name": "是否回退场景",
      "type": "Boolean",
      "isAdvanced": true
    }
  ],
  "selections": {
    "reasoningEffort": {
