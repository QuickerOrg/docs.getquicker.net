      "name": "图片",
      "type": "Image"
    },
    {
      "key": "rect",
      "name": "截图区域",
      "type": "Text",
      "description": "图片的截取区域(left,top,right,bottom)。"
    },
    {
      "key": "savedPath",
      "name": "保存路径",
      "type": "Text",
      "description": "保存后的路径；未保存时为空。"
    },
    {
      "key": "text",
      "name": "识别文本",
      "type": "Text",
      "validForList": [
        "ocr_copy"
      ],
      "condition": "仅：ocr_copy"
    }
  ],
