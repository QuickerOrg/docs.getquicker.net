      "variableMode": "Input",
      "condition": "",
      "description": "忽略内部步骤的错误，继续允许后续代码"
    },
    {
      "key": "skipWhenDebugging",
      "name": "调试运行时不输出调试内容",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "用以减少不必要的调试输出"
    },
    {
      "key": "useMultiThread",
      "name": "使用多线程",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "⚠通常不要选择! 请阅读文档详细了解后再使用。"
    },
    {
      "key": "waitAny",
      "name": "多线程使用WaitAny模式",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "任意一个线程结束即可。"
    },
    {
      "key": "cancelRemainingOnWaitAny",
      "name": "WaitAny模式下自动取消其它分支",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "启用WaitAny时，任一分支完成后请求取消其它未完成分支，并阻止其执行后续步骤。取消为协作式取消，不保证立即终止正在执行的步骤。"
