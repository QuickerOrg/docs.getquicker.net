{
  "key": "sys:uiautomation",
  "slug": "uiautomation",
  "legacySlug": "uiautomation",
  "ownsLegacyContent": true,
  "name": "窗口界面控制",
  "description": "触发Windows窗口的菜单/按钮等控件。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "isRisky": false,
  "isProOnly": false,
  "helpLink": "https://getquicker.net/KC/Help/Doc/uiautomation",
  "inputs": [
    {
      "key": "type",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "TriggerMenu",
      "required": true,
      "variableMode": "Input",
      "condition": "",
      "description": "操作类型。按下和抬起需要配对使用。"
    },
    {
      "key": "window",
      "name": "窗口句柄",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：TriggerMenu, TriggerControl, GetControlInfo",
      "description": "要操作哪个窗口的控件。不填写=使用前台窗口；或窗口句柄数字。"
    },
    {
      "key": "menuPath",
      "name": "菜单路径",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：TriggerMenu",
      "description": "菜单的展开路径。每行写一个级别的菜单名（需完全匹配）"
    },
    {
      "key": "expandDelay",
      "name": "展开延时",
      "type": "Integer",
      "defaultValue": "200",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：TriggerMenu",
      "description": "等待下级菜单展开的时间(ms)"
    },
    {
      "key": "control",
      "name": "控件名",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：TriggerControl, GetControlInfo",
      "description": "控件名，请确保唯一性。"
    },
    {
      "key": "controlType",
      "name": "控件类型",
      "type": "Enum",
      "defaultValue": "0",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：TriggerControl, GetControlInfo",
      "description": "可选。当有多个名称相同但类型不同的控件时区分。"
    },
    {
      "key": "controlOperation",
      "name": "动作",
      "type": "Enum",
      "defaultValue": "Auto",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：TriggerControl",
      "description": "对控件执行的操作。"
    },
    {
      "key": "value",
      "name": "值",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：TriggerControl",
      "description": "仅用于 \"设置值\" 操作。"
    },
    {
      "key": "pointLocation",
      "name": "坐标位置",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：GetControlInfoByPosition",
      "description": "指定要检查的控件的屏幕坐标位置，格式为\"x,y\""
    },
    {
      "key": "path",
      "name": "路径",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：UpdateSaveAsDialogPath",
      "description": "要更新的路径"
    },
    {
      "key": "autoCreateDir",
      "name": "自动创建文件夹",
      "type": "Enum",
      "defaultValue": "no",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：UpdateSaveAsDialogPath",
      "description": "如果目录不存在则自动创建。"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "defaultValue": "true",
      "required": false,
      "variableMode": "Input",
      "condition": "",
      "description": "失败后是否停止动作"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "condition": "",
      "description": "操作是否成功"
    },
    {
      "key": "value",
      "name": "值",
      "type": "Text",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": "控件的值"
    },
    {
      "key": "controlText",
      "name": "文本",
      "type": "Text",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": "获取控件上的文本。根据控件不同，可能从Value、Text、Name等信息获取。"
    },
    {
      "key": "rect",
      "name": "位置",
      "type": "Text",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": "控件坐标位置"
    },
    {
      "key": "controlName",
      "name": "控件名称",
      "type": "Text",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": ""
    },
    {
      "key": "controlType",
      "name": "控件类型",
      "type": "Text",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": ""
    },
    {
      "key": "controlTypeId",
      "name": "控件类型ID",
      "type": "Integer",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": ""
    },
    {
      "key": "controlIsEnabled",
      "name": "是否启用",
      "type": "Boolean",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": "控件未处于禁用状态"
    },
    {
      "key": "controlIsVisible",
      "name": "是否可见",
      "type": "Boolean",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": "控件是否在屏幕上。"
    },
    {
      "key": "controlNativeWindowHandle",
      "name": "原始句柄",
      "type": "Integer",
      "condition": "仅：GetControlInfo, GetCursorPointControlInfo, GetFocusedControlInfo, GetControlInfoByPosition",
      "description": "控件的原始窗口句柄(NativeWindowHandle)"
    }
  ],
