{
  "code": "318b29ef-4bba-4d0c-a918-08d7b30d7779",
  "title": "示例：正则提取",
  "description": "演示正则提取各个模块",
  "author": "CL",
  "revision": 1,
  "source": "https://getquicker.net/sharedaction?code=318b29ef-4bba-4d0c-a918-08d7b30d7779",
  "pulledAt": "2026-08-11T21:09:08.456Z",
  "variables": [
    {
      "name": "source",
      "type": "Text",
      "remark": "原始文本内容"
    },
    {
      "name": "allMatches",
      "type": "List",
      "remark": "所有匹配项的值列表"
    },
    {
      "name": "match1",
      "type": "Any",
      "remark": "匹配项1"
    },
    {
      "name": "match2",
      "type": "Text",
      "remark": "匹配项2"
    },
    {
      "name": "match3",
      "type": "Text",
      "remark": "匹配项3"
    },
    {
      "name": "match4",
      "type": "Text"
    },
    {
      "name": "match5",
      "type": "Text"
    },
    {
      "name": "matchCollection",
      "type": "Any",
      "remark": "Match对象集合"
    },
    {
      "name": "regExpression",
      "type": "Text",
      "remark": "正则表达式"
    },
    {
      "name": "matchObj",
      "type": "Any",
      "remark": "原始Match对象"
    }
  ],
  "steps": [
    {
      "key": "sys:subprogram",
      "inputs": {
        "subProgram": "Quicker版本验证",
        "stopIfFail": "1",
        "var:要求版本号": "1.4.19"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "提取各匹配项的值"
      }
    },
    {
      "key": "sys:regexExtract",
      "inputs": {
        "getGroup": "0",
        "data": "{source}",
        "pattern": "{regExpression}",
        "ignoreCase": "0",
        "singleLine": "0",
        "multiLine": "0",
        "stopIfFail": "1"
      },
      "outputs": {
        "matches": "allMatches",
        "match1": "match1",
        "match2": "match2",
        "match3": "match3",
        "match4": "match4",
        "match5": "match5"
      }
    },
    {
      "key": "sys:showText",
      "inputs": {
        "type": "WAIT",
        "text": "$$\r\n原始内容：{source}\r\n正则表达式：{regExpression}\r\n提取内容：各匹配项的值\r\n===================\r\n所有匹配项列表：\r\n{allMatches}\r\n===================\r\n匹配1:{match1}\r\n匹配2:{match2}\r\n匹配3:{match3}\r\n匹配4:{match4}\r\n匹配5:{match5}\r\n",
        "title": "结果内容",
        "winLocation": "CenterScreen",
        "fontsize": "14"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "提取首个匹配项的组"
      }
    },
    {
      "key": "sys:regexExtract",
      "inputs": {
        "getGroup": "1",
        "data": "{source}",
        "pattern": "{regExpression}",
        "ignoreCase": "0",
        "singleLine": "1",
        "multiLine": "0",
        "stopIfFail": "1"
      },
      "outputs": {
        "matches": "allMatches",
        "match1": "match1",
        "match2": "match2",
        "match3": "match3",
        "match4": "match4",
        "match5": "match5",
        "matchObj": "matchObj"
      }
    },
    {
      "key": "sys:showText",
      "inputs": {
        "type": "WAIT",
        "text": "$$\r\n原始内容：{source}\r\n正则表达式：{regExpression}\r\n提取内容：第一个匹配项的组\r\n===================\r\n所有匹配项列表：\r\n{allMatches}\r\n===================\r\n匹配1:{match1}\r\n匹配2:{match2}\r\n匹配3:{match3}\r\n匹配4:{match4}\r\n匹配5:{match5}\r\n",
        "title": "结果内容",
        "winLocation": "CenterScreen",
        "fontsize": "14"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "提取所有匹配项的组"
      }
    },
    {
      "key": "sys:regexExtract",
      "inputs": {
        "getGroup": "2",
        "data": "{source}",
        "pattern": "{regExpression}",
        "ignoreCase": "0",
        "singleLine": "1",
        "multiLine": "0",
        "rightToLeft": "false",
        "stopIfFail": "1"
      },
      "outputs": {
        "matches": "allMatches",
        "match1": "match1",
        "match2": "match2",
        "match3": "match3",
        "match4": "match4",
        "match5": "match5",
        "matchesCollection": "matchCollection"
      }
    },
    {
      "key": "sys:showText",
      "inputs": {
        "type": "WAIT",
        "text": "$$\r\n原始内容：{source}\r\n正则表达式：{regExpression}\r\n提取内容：所有匹配项的组\r\n===================\r\n所有匹配项列表：\r\n{allMatches}\r\n===================\r\n匹配1:{match1}\r\n匹配2:{match2}\r\n匹配3:{match3}\r\n匹配4:{match4}\r\n匹配5:{match5}\r\n",
        "title": "结果内容",
        "winLocation": "CenterScreen",
        "fontsize": "14"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "在表达式中使用原始c#对象。"
      }
    },
    {
      "key": "sys:notify",
      "inputs": {
        "msg": "$= \"MatchCollection中Match对象数量=\" + {matchCollection}.Count + \"\\n\" \r\n+ \"首个Match的值：\" + {matchCollection}[0].Value",
        "maxLines": "0",
        "type": "Info"
      }
    },
    {
      "key": "sys:notify",
      "inputs": {
        "msg": "$= \"Match对象的Groupshul =\" + {matchObj}.Groups.Count + \"\\n\" \r\n+ \"首个group的值：\" + {matchObj}.Groups[1].Value",
        "maxLines": "0",
        "type": "Info"
      }
    }
  ]
}
