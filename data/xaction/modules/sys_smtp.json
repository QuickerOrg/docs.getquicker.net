{
  "key": "sys:smtp",
  "slug": "smtp",
  "legacySlug": "smtp",
  "ownsLegacyContent": true,
  "name": "SMTP发送邮件",
  "description": "使用SMTP协议发送邮件",
  "category": "Network",
  "categoryName": "网络服务",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/smtp",
  "inputs": [
    {
      "key": "server",
      "name": "邮件服务器",
      "type": "Text",
      "description": "邮件服务器的域名或IP",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "port",
      "name": "端口",
      "type": "Integer",
      "description": "Smtp端口号",
      "defaultValue": "25",
      "defaultValueRaw": 25,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "useSsl",
      "name": "使用加密连接",
      "type": "Boolean",
      "description": "是否使用TLS加密连接。采用 STARTTLS（先明文连接再升级加密，通常为587端口，部分服务器为25端口）；不支持465端口的隐式SSL连接。",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "account",
      "name": "帐号",
      "type": "Text",
      "description": "发信帐号",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "password",
      "name": "密码",
      "type": "Text",
      "description": "发信帐号的密码",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "sender",
      "name": "发信邮箱",
      "type": "Text",
      "description": "发信帐号所对应的Email地址",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "senderName",
      "name": "发件人名称",
      "type": "Text",
      "description": "发件人的显示名称（可选）",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "to",
      "name": "收件人",
      "type": "Text",
      "description": "收件人Email地址，多个的话使用英文逗号（,）分隔，不支持分号或中文逗号。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "cc",
      "name": "抄送",
      "type": "Text",
      "description": "抄送给的Email地址列表，多个的话使用英文逗号（,）分隔，不支持分号或中文逗号。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bcc",
      "name": "密送",
      "type": "Text",
      "description": "密送给的Email地址列表，多个的话使用英文逗号（,）分隔，不支持分号或中文逗号。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "subject",
      "name": "邮件主题",
      "type": "Text",
      "description": "邮件的主题",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "content",
      "name": "邮件正文",
      "type": "Text",
      "description": "邮件正文内容",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "attachList",
      "name": "附件",
      "type": "Text",
      "description": "附件文件路径列表。多个时每行一个（按换行拆分），文件不存在时步骤失败。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "isHtml",
      "name": "内容为html",
      "type": "Boolean",
      "description": "邮件内容是否为HTML格式",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    }
  ],
  "sourceFileName": "catalog.json"
}
