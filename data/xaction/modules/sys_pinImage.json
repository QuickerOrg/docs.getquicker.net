            "operator": "In",
            "values": [
              "manual"
            ]
          }
        ]
      },
      "condition": "(operation 为 \"create\" 且 screenPlacement 为 \"manual\")",
      "defaultValue": "0,0",
      "variableMode": "UseVarOrInput"
    },
