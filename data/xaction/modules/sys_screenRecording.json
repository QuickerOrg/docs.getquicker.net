          "name": "暂停录屏"
        },
        {
          "value": "resume",
          "name": "继续录屏"
        },
        {
          "value": "stop",
          "name": "结束录屏"
        }
      ]
    },
    "regionType": {
      "name": "录制范围",
      "items": [
        {
          "value": "fixed_area",
          "name": "固定区域"
        },
