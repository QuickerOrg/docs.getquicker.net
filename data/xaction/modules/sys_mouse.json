{
  "key": "sys:mouse",
  "slug": "mouse",
  "legacySlug": "mouse",
  "ownsLegacyContent": true,
  "name": "鼠标输入",
  "description": "模拟鼠标输入",
  "category": "Basic",
  "categoryName": "基础",
  "stepType": "Action",
  "isRisky": false,
  "isProOnly": false,
  "helpLink": "https://getquicker.net/KC/Help/Doc/mouse",
  "inputs": [
    {
      "key": "type",
      "name": "类型",
      "type": "Enum",
      "defaultValue": "restore",
      "required": true,
      "variableMode": "Input",
      "condition": "",
      "description": "操作类型"
    },
    {
      "key": "hWnd",
      "name": "窗口句柄",
      "type": "Integer",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, moveToWinXy",
      "description": "目标窗口的句柄。留空或 0 表示操作前台窗口。"
    },
    {
      "key": "btn",
      "name": "按钮",
      "type": "Enum",
      "defaultValue": "left",
      "required": true,
      "variableMode": "Input",
      "condition": "仅：click, dbclick, down, up",
      "description": "操作哪个按钮"
    },
    {
      "key": "bmp",
      "name": "位图路径",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：locateByBitmap",
      "description": "需要在屏幕中查找的位图路径。位图必须和屏幕图像完全匹配，不能压缩。此时X、Y的值为相对于搜索位图的左上角的偏移。"
    },
    {
      "key": "bmpVar",
      "name": "位图变量",
      "type": "Image",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVar",
      "condition": "仅：locateByBitmapVar",
      "description": "需要在屏幕中查找的位图。位图必须和屏幕图像完全匹配，不能压缩。此时X、Y的值为相对于搜索位图的左上角的偏移。"
    },
    {
      "key": "bmpTargetType",
      "name": "查找范围",
      "type": "Enum",
      "defaultValue": "MainScreen",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "description": "位图查找范围"
    },
    {
      "key": "searchRect",
      "name": "查找坐标范围",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "description": "当\"查找范围\"为\"坐标范围\"时有效，格式为：left,top,right,bottom"
    },
    {
      "key": "bmpPosition",
      "name": "定位位置",
      "type": "Enum",
      "defaultValue": "Center",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "description": "查找到图片后，鼠标指针移动到的位置"
    },
    {
      "key": "bmpColorError",
      "name": "颜色容差",
      "type": "Integer",
      "defaultValue": "10",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "description": "匹配像素时允许每个颜色通道的偏差值0-100，0表示精确匹配，速度最快。"
    },
    {
      "key": "maxFindCount",
      "name": "最大匹配数量",
      "type": "Integer",
      "defaultValue": "1",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "description": "找图的最大匹配数量。将对每个查找到的目标执行附加动作。"
    },
    {
      "key": "retryCount",
      "name": "重试次数",
      "type": "Integer",
      "defaultValue": "1",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "description": "未找到位图时的重试次数。每次重试间隔300ms。"
    },
    {
      "key": "x",
      "name": "X",
      "type": "Integer",
      "defaultValue": "0",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：move, moveTo, scroll, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar",
      "description": "水平方向的坐标/坐标偏移/移动距离(像素) 或 滚动数量（clicks。正值向右，负值向左）"
    },
    {
      "key": "y",
      "name": "Y",
      "type": "Integer",
      "defaultValue": "0",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：move, moveTo, scroll, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar",
      "description": "垂直方向的坐标/坐标偏移/移动距离 或 滚动数量（clicks。正值向前，负值向后）"
    },
    {
      "key": "xy",
      "name": "坐标",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：moveToXy",
      "description": "格式为：x,y，如：100,200。也可以使用百分比表示，如：50%,50% 表示屏幕中心。"
    },
    {
      "key": "xyForWin",
      "name": "相对坐标",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：moveToWinXy",
      "description": "格式为：x,y，如：100,200（相对于窗口左上角向右100，向下200）。也可以使用百分比表示，如：50%,50% 表示窗口中心。"
    },
    {
      "key": "slowMove",
      "name": "逐渐移动到目标",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：move, moveTo, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar, moveToXy, moveToWinXy",
      "description": "逐渐移动而不是直接移动到目标位置。"
    },
    {
      "key": "extAction",
      "name": "移动后操作",
      "type": "Enum",
      "defaultValue": "none",
      "required": true,
      "variableMode": "Input",
      "condition": "仅：restore, move, moveTo, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar, moveToXy, moveToWinXy",
      "description": "移动位置后，需要执行的动作"
    },
    {
      "key": "restoreMousePos",
      "name": "操作完成后恢复鼠标位置",
      "type": "Boolean",
      "defaultValue": "false",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：move, moveTo, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar, moveToXy, moveToWinXy",
      "description": ""
    },
    {
      "key": "stopIfFail",
      "name": "失败后中止动作",
      "type": "Boolean",
      "defaultValue": "true",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "description": "获取位置失败后，是否停止后续动作的执行。"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "找图定位是否成功",
      "type": "Boolean",
