{
  "key": "sys:premierecontrol",
  "slug": "premierecontrol",
  "legacySlug": "premierecontrol",
  "ownsLegacyContent": true,
  "name": "Premiere Pro控制",
  "description": "通过 Premiere UXP 插件调用项目、序列、时间线、媒体、标记和脚本能力。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/premierecontrol",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "project.get_context",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "filePath",
      "name": "文件路径",
      "type": "Text",
      "description": "项目另存为的 .prproj 绝对路径。",
      "validForList": [
        "project.save_as"
      ],
      "condition": "仅：project.save_as",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "sequence",
      "name": "序列名称或 GUID",
      "type": "Text",
      "description": "名称重复时请使用 sequence.list 返回的 GUID。",
      "validForList": [
        "sequence.activate"
      ],
      "condition": "仅：sequence.activate",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "seconds",
      "name": "位置（秒）",
      "type": "Number",
      "validForList": [
        "timeline.set_playhead"
      ],
      "condition": "仅：timeline.set_playhead",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "inSeconds",
      "name": "入点（秒）",
      "type": "Number",
      "validForList": [
        "timeline.set_in_out"
      ],
      "condition": "仅：timeline.set_in_out",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "outSeconds",
      "name": "出点（秒）",
      "type": "Number",
      "validForList": [
        "timeline.set_in_out"
      ],
      "condition": "仅：timeline.set_in_out",
      "defaultValue": "10",
      "defaultValueRaw": 10,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "fileList",
      "name": "媒体文件列表",
      "type": "Text",
      "description": "每行一个媒体文件绝对路径。",
      "validForList": [
        "media.import_files"
      ],
      "condition": "仅：media.import_files",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "asNumberedStills",
      "name": "按编号静帧导入",
      "type": "Boolean",
      "validForList": [
        "media.import_files"
      ],
      "condition": "仅：media.import_files",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "binName",
      "name": "素材箱名称",
      "type": "Text",
      "validForList": [
        "media.create_bin"
      ],
      "condition": "仅：media.create_bin",
      "defaultValue": "Quicker 导入",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "markerName",
      "name": "标记名称",
      "type": "Text",
      "validForList": [
        "marker.add"
      ],
      "condition": "仅：marker.add",
      "defaultValue": "Quicker 标记",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "markerSeconds",
      "name": "标记位置（秒）",
      "type": "Number",
      "validForList": [
        "marker.add"
      ],
      "condition": "仅：marker.add",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "markerDurationSeconds",
      "name": "标记时长（秒）",
      "type": "Number",
      "validForList": [
        "marker.add"
      ],
      "condition": "仅：marker.add",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "markerComments",
      "name": "标记备注",
      "type": "Text",
      "validForList": [
        "marker.add"
      ],
      "condition": "仅：marker.add",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scriptCode",
      "name": "JavaScript 表达式",
      "type": "Text",
      "description": "可直接使用 ppro；返回 Promise 时会自动等待。",
      "validForList": [
        "script.evaluate"
      ],
      "condition": "仅：script.evaluate",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandName",
      "name": "Bridge 命令名称",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "argumentsJson",
      "name": "参数（JSON 对象）",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitMs",
      "name": "最长等待时间(ms)",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "30000",
      "defaultValueRaw": 30000,
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "output",
      "name": "命令结果",
      "type": "Text",
      "description": "Premiere 返回的 JSON 结果。"
    }
