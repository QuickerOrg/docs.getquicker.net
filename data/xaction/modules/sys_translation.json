{
  "key": "sys:translation",
  "slug": "translation",
  "legacySlug": "translation",
  "ownsLegacyContent": true,
  "name": "机器翻译/词典",
  "description": "调用第三方服务翻译文字到指定的语言。此功能需要单独付费使用，详情请参考文档。",
  "category": "Network",
  "categoryName": "网络服务",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/translation",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "single",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "text",
      "name": "待翻译文本内容或单词。",
      "type": "Text",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "srcLang",
      "name": "源语言",
      "type": "Text",
      "description": "待翻译内容的语言",
      "validForList": [
        "single",
        "multiple"
      ],
      "condition": "仅：single, multiple",
      "defaultValue": "Auto",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "dstLang",
      "name": "目标语言",
      "type": "Text",
      "description": "翻译的结果语言",
      "validForList": [
        "single",
        "multiple"
      ],
      "condition": "仅：single, multiple",
      "defaultValue": "Auto",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "vendor",
      "name": "厂商",
      "type": "Enum",
      "description": "不同厂商价格不同，详情请参考文档。",
      "validForList": [
        "single"
      ],
      "condition": "仅：single",
      "defaultValue": "Youdao",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "vendorList",
      "name": "厂商列表",
      "type": "Enum",
      "description": "用逗号分割的厂商标识，详细信息请参考文档。",
      "validForList": [
        "multiple"
      ],
      "condition": "仅：multiple",
      "defaultValue": "Youdao,Baidu,Tencent,Caiyun",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "resultText",
      "name": "结果文本",
      "type": "Text",
      "description": "翻译结果文本。多厂商翻译时自动组合各厂商结果"
    },
    {
      "key": "rawData",
      "name": "原始响应",
      "type": "Text",
      "description": "厂商接口返回的原始内容，通常为json格式。",
      "validForList": [
        "single",
        "en2zh_dict"
      ],
      "condition": "仅：single, en2zh_dict"
    },
    {
      "key": "vendorResult",
      "name": "各厂商翻译结果",
      "type": "Dict",
      "description": "各厂商的翻译结果（词典）。key为厂商标识，value为翻译结果。",
      "validForList": [
        "multiple"
      ],
      "condition": "仅：multiple"
    },
    {
      "key": "vendorRawData",
      "name": "各厂商原始响应",
      "type": "Dict",
      "description": "各厂商的原始响应内容（词典）。key为厂商标识，value为厂商原始响应。",
      "validForList": [
        "multiple"
      ],
      "condition": "仅：multiple"
    },
    {
      "key": "costPoints",
      "name": "消耗点数",
      "type": "Integer",
      "description": "此次翻译消耗的点数,单位为0.0001 Q豆。",
      "validForList": [
        "single",
        "multiple"
      ],
      "condition": "仅：single, multiple"
    }
  ],
