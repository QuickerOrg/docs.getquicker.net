{
  "key": "sys:htmlExtract",
  "slug": "htmlextract",
  "legacySlug": "htmlextract",
  "ownsLegacyContent": true,
  "name": "提取HTML内容",
  "description": "从HTML代码中提取内容",
  "category": "Network",
  "categoryName": "网络服务",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/htmlextract",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "extractText",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "source",
      "name": "源HTML",
      "type": "Text",
      "description": "原始HTML内容，或网址，或根节点对象",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "encoding",
      "name": "网页编码类型",
      "type": "Text",
      "description": "通过网址加载内容时，使用指定的编码。留空时默认为UTF8。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "xpath",
      "name": "节点XPath",
      "type": "Text",
      "description": "内容的XPath，详细说明请参考文档",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "selectTarget",
      "name": "提取方式",
      "type": "Enum",
      "description": "提取单个节点还是符合条件的所有节点。",
      "defaultValue": "single",
      "variableMode": "Input"
    },
    {
      "key": "returnType",
      "name": "提取内容类型",
      "type": "Enum",
      "description": "要提取的节点信息。",
      "defaultValue": "InnerHtml",
      "variableMode": "Input"
    },
    {
      "key": "attribute",
      "name": "属性名称",
      "type": "Text",
      "description": "仅在提取节点属性时有效。指定属性的名称。",
      "visibleWhen": {
        "kind": "Field",
        "fieldKey": "returnType",
        "operator": "In",
        "values": [
          "Attribute"
        ]
      },
      "condition": "returnType 为 \"Attribute\"",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "writeToSheet",
      "name": "写入工作表对象",
      "type": "Object",
      "description": "将提取到的表格内容写入工作表对象中。",
      "defaultValue": "",
      "variableMode": "UseVarOnly"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止动作",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "步骤执行是否成功",
      "type": "Boolean",
      "description": "步骤执行是否成功"
    },
    {
      "key": "value",
      "name": "提取值",
      "type": "Any",
      "description": "提取的内容。请确保结果类型和变量类型匹配。"
    },
    {
      "key": "rootNode",
      "name": "根节点",
      "type": "Any",
      "description": "整个HTML源内容对应的HtmlNode节点对象，可用于后续处理使用。"
    }
  ],
  "selections": {
    "operation": {
      "name": "操作类型",
      "items": [
        {
          "value": "extractText",
          "name": "提取文本内容"
        },
        {
          "value": "extractTable",
          "name": "提取表格内容"
        }
      ]
    },
    "encoding": {
      "name": "网页编码类型",
      "items": [
        {
          "value": "auto",
          "name": "自动检测 (加载两次)"
        },
        {
          "value": "gb2312",
          "name": "GB2312编码"
        },
        {
          "value": "utf-8",
          "name": "UTF8编码"
        }
      ]
    },
    "selectTarget": {
      "name": "提取方式",
      "items": [
        {
          "value": "single",
          "name": "第一个符合条件的节点"
        },
        {
          "value": "all",
          "name": "所有符合条件的节点"
        }
      ]
    },
    "returnType": {
      "name": "提取内容类型",
      "items": [
        {
          "value": "InnerHtml",
          "name": "innerHtml 内部HTML"
        },
        {
          "value": "InnerText",
          "name": "innerText 内部文本"
        },
        {
          "value": "OuterHtml",
          "name": "outerHTML 节点全部HTML"
        },
        {
          "value": "Attribute",
          "name": "Attribute 节点的某个属性"
        },
        {
          "value": "Node",
          "name": "节点对象"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
