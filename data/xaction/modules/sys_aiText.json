      "name": "操作",
      "type": "Enum",
      "defaultValue": "summarize",
      "required": true,
      "variableMode": "Input",
      "condition": "",
      "description": "选择预定义文本任务；选择“自定义”时只使用完整系统提示词。"
    },
    {
      "key": "text",
      "name": "文本",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "",
