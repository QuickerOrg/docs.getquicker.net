{
  "code": "85f82b64-b24c-4e46-ba2c-08d6db3483c9",
  "title": "搜索Everything",
  "description": "搜索选中文本、文件或剪贴板，否则打开everything",
  "author": "CL",
  "revision": 6,
  "source": "https://getquicker.net/sharedaction?code=85f82b64-b24c-4e46-ba2c-08d6db3483c9",
  "pulledAt": "2026-08-11T21:42:32.653Z",
  "variables": [
    {
      "name": "selectedText",
      "type": "Text",
      "remark": "选中的文本内容"
    },
    {
      "name": "img",
      "type": "Image",
      "remark": "默认的图片变量"
    },
    {
      "name": "successGetText",
      "type": "Boolean"
    },
    {
      "name": "everythingPath",
      "type": "Text",
      "remark": "everything的完整路径"
    },
    {
      "name": "isExists",
      "type": "Boolean",
      "remark": "路经是否存在并且是文件"
    },
    {
      "name": "successGetPath",
      "type": "Boolean",
      "remark": "成功获取Everything路径"
    }
  ],
  "steps": [
    {
      "key": "sys:getSelectedText",
      "inputs": {
        "format": "UnicodeText",
        "repeat": "0",
        "useActionParam": "1",
        "stopIfFail": "0"
      },
      "outputs": {
        "output": "selectedText",
        "isSuccess": "successGetText"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "如果未选择文本，则尝试获取选择的文件名"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$=!{successGetText}"
      },
      "ifSteps": [
        {
          "key": "sys:getSelectedFiles",
          "inputs": {
            "operation": "getSelection",
            "waitMs": "100",
            "sortType": "Default",
            "stopIfFail": "0"
          },
          "outputs": {
            "isSuccess": "successGetText",
            "firstFileName": "selectedText"
          }
        }
      ]
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "如果也没有获取到文件，则尝试获取剪贴板文本"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$=!{successGetText}"
      },
      "ifSteps": [
        {
          "key": "sys:getClipboardText",
          "inputs": {
            "format": "UnicodeText",
            "waitMs": "400",
            "stopIfFail": "0"
          },
          "outputs": {
            "isSuccess": "successGetText",
            "output": "selectedText"
          }
        }
      ]
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "确定everything的路径"
      }
    },
    {
      "key": "sys:checkPathExists",
      "inputs": {
        "path": "{everythingPath}"
      },
      "outputs": {
        "isFile": "isExists"
      },
      "note": "检查everything是否存在"
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$= ! {isExists}"
      },
      "note": "如果路径不存在",
      "ifSteps": [
        {
          "key": "sys:comment",
          "inputs": {
            "note": "如果当前启动了everything，则根据进程获取路径。否则请用户输入路径。"
          }
        },
        {
          "key": "sys:checkProcessExists",
          "inputs": {
            "process": "everything",
            "stopIfFail": "0"
          },
          "outputs": {
            "isExists": "successGetPath",
            "path": "everythingPath"
          }
        },
        {
          "key": "sys:assign",
          "inputs": {
            "input": "$= return (!String.IsNullOrEmpty({everythingPath}))\r\n? {everythingPath}\r\n: Process.GetProcessesByName(\"everything\").Last().MainModule.FileName;",
            "stopIfFail": "0"
          },
          "outputs": {
            "output": "everythingPath"
          },
          "note": "如果没有取到everything 进程路径，可能是服务进程权限高。这时候尝试取后面的进程。"
        },
        {
          "key": "sys:simpleIf",
          "inputs": {
            "condition": "$= String.IsNullOrEmpty({everythingPath}) ||  !{successGetPath}"
          },
          "note": "如果没有得到路径，请用户选择路径",
          "ifSteps": [
            {
              "key": "sys:userInput",
              "inputs": {
                "type": "text",
                "prompt": "请选择Everything.exe的路径",
                "texttools": "SelectSingleFile,SelectProcessPath",
                "isRequired": "0",
                "winLocation": "CenterScreen",
                "imeState": "NO_CONTROL",
                "restoreFocus": "1",
                "closeOnDeactivated": "0",
                "stopIfFail": "1"
              },
              "outputs": {
                "textValue": "everythingPath"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "根据是否选择了文本，进行搜索或打开everything"
      }
    },
    {
      "key": "sys:if",
      "inputs": {
        "condition": "{successGetText}"
      },
      "ifSteps": [
        {
          "key": "sys:run",
          "inputs": {
            "path": "{everythingPath}",
            "arg": "$$-s \"{selectedText}\"",
            "windowStyle": "0",
            "runas": "0",
            "waitExit": "0"
          }
        }
      ],
      "elseSteps": [
        {
          "key": "sys:run",
          "inputs": {
            "path": "{everythingPath}",
            "windowStyle": "0",
            "runas": "0",
            "waitExit": "0"
          }
        }
      ]
    }
  ]
}
