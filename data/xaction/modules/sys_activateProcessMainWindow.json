{
  "key": "sys:activateProcessMainWindow",
  "slug": "activateprocessmainwindow",
  "legacySlug": "activateprocessmainwindow",
  "ownsLegacyContent": true,
  "name": "激活进程主窗口",
  "description": "找到指定进程的主窗口并使其显示在前台。",
  "category": "System",
  "categoryName": "Windows系统",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/activateprocessmainwindow",
  "inputs": [
    {
      "key": "process",
      "name": "进程名称/pid",
      "type": "Text",
      "description": "请输入当前登录会话中的进程名、PID或完整exe路径。进程名可带.exe后缀。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "hotkey",
      "name": "热键",
      "type": "Text",
      "description": "选填。软件最小化到托盘时，使用指定的全局热键激活窗口。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "className",
      "name": "窗口类名",
      "type": "Text",
      "description": "选填。按类名筛选窗口，支持正则；热键和已有前台窗口也必须满足条件。隐藏窗口必须唯一。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowTitle",
      "name": "窗口标题",
      "type": "Text",
      "description": "选填。按标题筛选窗口，支持正则；所有成功路径均验证此条件和真实前台状态。",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "path",
      "name": "程序路径",
      "type": "Text",
      "description": "选填。如果进程不存在，可以根据此路径启动程序。",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "是否成功激活了进程主窗口"
    },
    {
      "key": "pid",
      "name": "PID",
      "type": "Integer",
      "description": "进程ID"
    },
    {
      "key": "mainWinHandle",
      "name": "主窗口句柄",
      "type": "Integer",
      "description": "进程的主窗口句柄"
    },
    {
      "key": "mainWinTitle",
      "name": "主窗口标题",
      "type": "Text"
    }
  ],
  "sourceFileName": "catalog.json"
}
