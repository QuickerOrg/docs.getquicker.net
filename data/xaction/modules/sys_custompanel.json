      "validForList": [
        "show_fixed_panel",
        "show_fixed_panel_wait_close"
      ],
      "condition": "仅：show_fixed_panel, show_fixed_panel_wait_close",
      "defaultValue": "CenterScreen",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "winSize",
      "name": "窗口尺寸/位置",
      "type": "Text",
      "description": "宽度,高度：逻辑像素或屏幕工作区百分比；自定义位置填坐标。",
      "isAdvanced": true,
      "validForList": [
        "show_fixed_panel",
