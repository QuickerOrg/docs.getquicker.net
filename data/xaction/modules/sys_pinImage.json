{
  "key": "sys:pinImage",
  "slug": "pinimage",
  "legacySlug": "pinimage",
  "ownsLegacyContent": true,
  "name": "贴图",
  "description": "创建贴图，或控制贴图显隐、恢复及分组。创建时按来源自动识别图片、HTML、公式、OCR 原始结果或文本。",
  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/pinimage",
  "inputs": [
    {
      "key": "operation",
      "name": "操作",
      "type": "Enum",
      "defaultValue": "create",
      "required": true,
      "variableMode": "UseVarOrInput",
      "isControlField": true
    },
    {
      "key": "groupId",
      "name": "贴图组 ID",
      "type": "Text",
      "description": "稳定的贴图组 ID；重命名不影响绑定。切换并显示与重复点击切换显隐是不同操作。",
      "validForList": [
        "groupSwitch",
        "groupToggle"
      ],
      "condition": "仅：groupSwitch, groupToggle",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "mode",
      "name": "内容来源",
      "type": "Enum",
      "description": "变量和剪贴板自动识别图片、HTML、公式、OCR 结果或文本。「纯文本」直接显示输入文字，可设置字体与字号。HTML 仅静态渲染，禁止网络访问。",
      "validForList": [
        "create"
      ],
      "condition": "仅：create",
      "defaultValue": "variable",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "content",
      "name": "内容",
      "type": "Any",
      "description": "图片变量、图片路径，或文本（HTML / LaTeX / $公式$ / OCR 原始结果 / 纯文本）。自动判断类型并渲染；HTML 使用自身静态样式，禁用来源脚本和网络访问。",
      "validForList": [
        "variable"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "create"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "mode",
            "operator": "In",
            "values": [
              "variable"
            ]
          }
        ]
      },
      "condition": "(operation 为 \"create\" 且 mode 为 \"variable\")",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "text",
      "name": "文本",
      "type": "Text",
      "description": "要贴图的多行文字。支持变量；纯文本模式直接显示文字。",
      "validForList": [
        "text",
        "plainText"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "create"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "mode",
            "operator": "In",
            "values": [
              "text",
              "plainText"
            ]
          }
        ]
      },
      "condition": "(operation 为 \"create\" 且 mode 为 \"text\"、\"plainText\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "screenPlacement",
      "name": "屏幕位置",
      "type": "Enum",
      "description": "「自动」：剪贴板有 QuickerPinData / PixPinData 时贴回截图原位置，否则屏幕中间。其余预设相对鼠标所在显示器工作区定位（图片左上角）。「截图原位置」没有元数据时落到当前光标。来源为剪贴板且本项为「自定义坐标」且坐标为默认 0,0 时，有位置元数据也按原位置。未保存过此参数的旧动作仍是「自定义坐标」；新建步骤默认「自动」。",
      "validForList": [
        "create"
      ],
      "condition": "仅：create",
      "defaultValue": "manual",
      "newStepDefaultValue": "auto",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "rect",
      "name": "自定义坐标",
      "type": "Text",
      "description": "仅当「屏幕位置」为自定义时有效。图片内容左上角的屏幕像素坐标：left,top 或 left,top,right,bottom（四元组时仅取 left、top）。",
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "operation",
            "operator": "In",
            "values": [
              "create"
            ]
          },
