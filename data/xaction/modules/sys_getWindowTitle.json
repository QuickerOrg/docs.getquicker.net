{
  "key": "sys:getWindowTitle",
  "slug": "getwindowtitle",
  "legacySlug": "getwindowtitle",
  "ownsLegacyContent": true,
  "name": "获取窗口信息/查找窗口",
  "description": "获取指定窗口的标题等信息。",
  "category": "System",
  "categoryName": "Windows系统",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/getwindowtitle",
  "inputs": [
    {
      "key": "which",
      "name": "目标窗口",
      "type": "Enum",
      "description": "判断哪个窗口的信息",
      "defaultValue": "foreground",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "hWnd",
      "name": "窗口句柄hWnd",
      "type": "Integer",
      "description": "未指定时使用前台窗口句柄",
      "validForList": [
        "fromHwnd",
        "findChildWindow",
        "child_windows"
      ],
      "condition": "仅：fromHwnd, findChildWindow, child_windows",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "className",
      "name": "窗口类名",
      "type": "Text",
      "description": "要查找窗口的类名（ClassName），为空时不检查此项。",
      "validForList": [
        "findWindow",
        "top_windows",
        "findChildWindow",
        "child_windows"
      ],
      "condition": "仅：findWindow, top_windows, findChildWindow, child_windows",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "windowName",
      "name": "窗口名称",
      "type": "Text",
      "description": "要查找窗口的标题，为空时不检查此项。",
      "validForList": [
        "findWindow",
        "top_windows",
        "findChildWindow",
        "child_windows"
      ],
      "condition": "仅：findWindow, top_windows, findChildWindow, child_windows",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "procIdOrName",
      "name": "进程名/pid",
      "type": "Text",
      "description": "要查找窗口所属的进程名或pid，为空时不检查此项。进程名通常为程序文件名去掉.exe后缀。",
      "validForList": [
        "findWindow",
        "top_windows"
      ],
      "condition": "仅：findWindow, top_windows",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "onlyVisible",
      "name": "仅可见窗口",
      "type": "Enum",
      "validForList": [
        "findWindow",
        "top_windows"
      ],
      "condition": "仅：findWindow, top_windows",
      "defaultValue": "default",
      "variableMode": "Input"
    },
    {
      "key": "requireTitle",
      "name": "仅名称(标题)不为空的窗口",
      "type": "Boolean",
      "validForList": [
        "findWindow",
        "top_windows"
      ],
      "condition": "仅：findWindow, top_windows",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "useRegex",
      "name": "使用正则匹配窗口类名和标题",
      "type": "Boolean",
      "validForList": [
        "findWindow",
        "top_windows",
        "child_windows"
      ],
      "condition": "仅：findWindow, top_windows, child_windows",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "winRectIncludeInvisibleBorder",
      "name": "窗口位置包含不可见边框（阴影区域）",
      "type": "Boolean",
      "validForList": [
        "foreground",
        "selectWindow",
        "pointing",
        "pointing_root",
        "pointing_now",
        "pointing_now_root",
        "fromHwnd",
        "findWindow"
      ],
      "condition": "仅：foreground, selectWindow, pointing, pointing_root, pointing_now, pointing_now_root, fromHwnd, findWindow",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
