    {
      "key": "buttonItem",
      "name": "按钮操作项",
      "type": "Object",
      "condition": "仅：show_fixed_panel_wait_close",
      "description": "点击的是按钮的菜单时，所对应按钮的CommonOperationItem对象"
    },
    {
      "key": "winHandle",
      "name": "窗口句柄",
      "type": "Integer",
      "condition": "仅：show_fixed_panel, get_panel_info",
      "description": "操作窗的窗口句柄"
