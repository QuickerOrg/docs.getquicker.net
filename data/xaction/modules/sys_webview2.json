{
  "key": "sys:webview2",
  "slug": "webview2",
  "legacySlug": "webview2",
  "ownsLegacyContent": true,
  "name": "WebView2浏览器窗口",
  "description": "基于微软Edge浏览器内核的组件，需要安装Edge最新预览版方可使用。",
  "category": "Ui",
  "categoryName": "界面组件",
  "stepType": "Action",
  "isRisky": false,
  "isProOnly": false,
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/webview2",
  "inputs": [
    {
      "key": "type",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "OpenUrl",
      "required": true,
      "variableMode": "Input",
      "condition": "",
      "description": ""
    },
    {
      "key": "url",
      "name": "网址或HTML内容",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：OpenUrl, OpenAndWaitLoad, OpenUrlAndWaitClose",
      "description": "网页地址/文件路径或html代码内容"
    },
    {
      "key": "urlList",
      "name": "网址列表",
      "type": "List",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：MultiTab_OpenUrl, MultiColumn_OpenUrl",
      "description": "每行一个：网址，或\"标题|网址\"，或\"[图标]标题|网址\"格式。"
    },
    {
      "key": "additionalBrowserArguments",
      "name": "附加的浏览器参数",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：OpenUrl, OpenAndWaitLoad, OpenUrlAndWaitClose",
      "description": "用于设置代理等用途"
    },
    {
      "key": "virtualHostToFolder",
      "name": "虚拟主机映射",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：OpenUrl, OpenAndWaitLoad, OpenUrlAndWaitClose",
      "description": "将文件夹映射为虚拟主机名。格式：主机名|文件夹路径。多个时，每行一个。\n在html中可以使用https://servername/path/to/file.png的格式访问文件。"
    },
    {
      "key": "userAgent",
      "name": "User Agent",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：OpenUrl, OpenAndWaitLoad, OpenUrlAndWaitClose, MultiTab_OpenUrl, MultiColumn_OpenUrl",
      "description": "可选。自定义UserAgent"
    },
    {
      "key": "title",
      "name": "窗口标题",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
      "condition": "仅：OpenUrl, OpenAndWaitLoad, OpenUrlAndWaitClose, MultiTab_OpenUrl, MultiColumn_OpenUrl",
      "description": "窗口标题文字。未设置时，自动使用网页标题。"
    },
    {
      "key": "icon",
      "name": "窗口图标",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：OpenUrl, OpenAndWaitLoad, OpenUrlAndWaitClose",
      "description": "显示在窗口左上角的图标。支持fa:内置图报名:#RRGGBB或图标网址。"
    },
    {
      "key": "defaultBgColor",
      "name": "默认背景色",
      "type": "Text",
      "defaultValue": "",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "仅：OpenUrl, OpenAndWaitLoad, OpenUrlAndWaitClose",
      "description": "可选。设置窗口的默认背景色。"
    },
    {
      "key": "autoCloseKey",
      "name": "窗口标识",
      "type": "Text",
      "defaultValue": "=",
      "required": false,
      "variableMode": "UseVarOrInput",
      "condition": "排除：CheckInstalled",
      "description": "(仅必要时使用)用于关闭之前打开的具有此标识的WebView2窗口。使用=表示当前动作ID。"
    },
    {
      "key": "modeForExists",
      "name": "如果窗口已存在",
      "type": "Enum",
      "defaultValue": "SkipThisStep",
      "required": false,
      "variableMode": "Input",
      "condition": "仅：OpenUrl, OpenAndWaitLoad",
      "description": ""
    },
    {
      "key": "script",
      "name": "JS脚本",
      "type": "Text",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput",
