        "image.resize"
      ],
      "condition": "仅：image.resize",
      "defaultValue": "1920",
      "defaultValueRaw": 1920,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "height",
      "name": "高度",
      "type": "Number",
      "validForList": [
        "image.resize"
      ],
      "condition": "仅：image.resize",
      "defaultValue": "1080",
      "defaultValueRaw": 1080,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "angle",
      "name": "旋转角度",
      "type": "Number",
      "validForList": [
        "image.rotate"
      ],
      "condition": "仅：image.rotate",
      "defaultValue": "90",
      "defaultValueRaw": 90,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scriptCode",
      "name": "JavaScript 表达式",
      "type": "Text",
      "validForList": [
        "script.evaluate"
      ],
      "condition": "仅：script.evaluate",
      "defaultValue": "photoshop.app.activeDocument.title",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "batchPlayJson",
      "name": "BatchPlay 命令（JSON 数组）",
      "type": "Text",
      "validForList": [
        "batch_play.execute"
      ],
      "condition": "仅：batch_play.execute",
      "defaultValue": "[]",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandName",
      "name": "Bridge 命令名称",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "argumentsJson",
      "name": "参数（JSON 对象）",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitMs",
      "name": "最长等待时间(ms)",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "30000",
      "defaultValueRaw": 30000,
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
