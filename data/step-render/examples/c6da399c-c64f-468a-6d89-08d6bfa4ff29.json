{
  "code": "c6da399c-c64f-468a-6d89-08d6bfa4ff29",
  "title": "示例：用户输入",
  "description": "演示用户输入模块",
  "author": "CL",
  "revision": 0,
  "source": "https://getquicker.net/sharedaction?code=c6da399c-c64f-468a-6d89-08d6bfa4ff29",
  "pulledAt": "2026-08-11T20:56:31.363Z",
  "variables": [
    {
      "name": "输入的内容",
      "type": "Text"
    },
    {
      "name": "输入的数字",
      "type": "Number"
    },
    {
      "name": "是否为空",
      "type": "Boolean"
    }
  ],
  "steps": [
    {
      "key": "sys:userInput",
      "inputs": {
        "prompt": "输入简单（单行）文本",
        "type": "text",
        "defaultValue": "预先输入的文字",
        "restoreFocus": "0"
      },
      "outputs": {
        "textValue": "输入的内容",
        "isEmpty": "是否为空"
      }
    },
    {
      "key": "sys:MsgBox",
      "inputs": {
        "message": "$$是否为空: {是否为空}\r\n{输入的内容}",
        "title": "输入的内容",
        "buttons": "OK"
      }
    },
    {
      "key": "sys:userInput",
      "inputs": {
        "prompt": "输入一个数字",
        "type": "number",
        "defaultValue": "80",
        "restoreFocus": "0"
      },
      "outputs": {
        "textValue": "输入的内容",
        "numberValue": "输入的数字",
        "isEmpty": "是否为空"
      },
      "note": "输入数字"
    },
    {
      "key": "sys:MsgBox",
      "inputs": {
        "message": "$$是否为空: {是否为空}\r\n{输入的内容}",
        "title": "输入的内容",
        "buttons": "OK"
      }
    },
    {
      "key": "sys:userInput",
      "inputs": {
        "prompt": "输入一个Email地址",
        "type": "text",
        "defaultValue": "80",
        "pattern": "^([A-Za-z0-9_\\-\\.])+\\@([A-Za-z0-9_\\-\\.])+\\.([A-Za-z]{2,4})$",
        "restoreFocus": "0"
      },
      "outputs": {
        "textValue": "输入的内容",
        "isEmpty": "是否为空"
      },
      "note": "输入Email（输入格式验证）"
    },
    {
      "key": "sys:MsgBox",
      "inputs": {
        "message": "$$是否为空: {是否为空}\r\n{输入的内容}",
        "title": "输入的内容",
        "buttons": "OK"
      }
    },
    {
      "key": "sys:userInput",
      "inputs": {
        "prompt": "输入多行文本",
        "type": "multiline",
        "defaultValue": "80",
        "restoreFocus": "0"
      },
      "outputs": {
        "textValue": "输入的内容",
        "isEmpty": "是否为空"
      },
      "note": "输入Email（输入格式验证）"
    },
    {
      "key": "sys:MsgBox",
      "inputs": {
        "message": "$$是否为空: {是否为空}\r\n{输入的内容}",
        "title": "输入的内容",
        "buttons": "OK"
      }
    }
  ]
}
