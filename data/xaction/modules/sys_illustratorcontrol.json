{
  "key": "sys:illustratorcontrol",
  "slug": "illustratorcontrol",
  "legacySlug": "illustratorcontrol",
  "ownsLegacyContent": true,
  "name": "Illustrator控制",
  "description": "通过 Illustrator CEP 扩展调用文档、选择、图层、画板、文本和 ExtendScript 能力。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/illustratorcontrol",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "document.get_context",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "filePath",
      "name": "文件路径",
      "type": "Text",
      "validForList": [
        "document.open",
        "document.save_as",
        "document.export"
      ],
      "condition": "仅：document.open, document.save_as, document.export",
      "defaultValue": "T:\\TEMP\\Quicker-Illustrator.png",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "format",
      "name": "格式",
      "type": "Text",
      "validForList": [
        "document.save_as",
        "document.export"
      ],
      "condition": "仅：document.save_as, document.export",
      "defaultValue": "png",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "width",
      "name": "宽度（点）",
      "type": "Number",
      "validForList": [
        "document.new"
      ],
      "condition": "仅：document.new",
      "defaultValue": "1920",
      "defaultValueRaw": 1920,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "height",
      "name": "高度（点）",
      "type": "Number",
      "validForList": [
        "document.new"
      ],
      "condition": "仅：document.new",
      "defaultValue": "1080",
      "defaultValueRaw": 1080,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "colorSpace",
      "name": "颜色空间（rgb/cmyk）",
      "type": "Text",
      "validForList": [
        "document.new"
      ],
      "condition": "仅：document.new",
      "defaultValue": "rgb",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scale",
      "name": "导出缩放百分比",
      "type": "Number",
      "validForList": [
        "document.export"
      ],
      "condition": "仅：document.export",
      "defaultValue": "100",
      "defaultValueRaw": 100,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "quality",
      "name": "JPEG 质量",
      "type": "Number",
      "validForList": [
        "document.export"
      ],
      "condition": "仅：document.export",
      "defaultValue": "80",
      "defaultValueRaw": 80,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "artboardClipping",
      "name": "裁剪到画板",
      "type": "Boolean",
      "validForList": [
        "document.export"
      ],
      "condition": "仅：document.export",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "boolValue",
      "name": "启用",
      "type": "Boolean",
      "validForList": [
        "object.set_hidden",
        "object.set_locked",
        "layer.set_visible",
        "layer.set_locked"
      ],
      "condition": "仅：object.set_hidden, object.set_locked, layer.set_visible, layer.set_locked",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "deltaX",
      "name": "水平移动（点）",
      "type": "Number",
      "validForList": [
        "object.translate"
      ],
      "condition": "仅：object.translate",
      "defaultValue": "10",
      "defaultValueRaw": 10,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "deltaY",
      "name": "垂直移动（点）",
      "type": "Number",
      "validForList": [
        "object.translate"
      ],
      "condition": "仅：object.translate",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "angle",
      "name": "旋转角度",
      "type": "Number",
      "validForList": [
        "object.rotate"
      ],
      "condition": "仅：object.rotate",
      "defaultValue": "15",
      "defaultValueRaw": 15,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scaleX",
      "name": "水平缩放百分比",
      "type": "Number",
      "validForList": [
        "object.resize"
      ],
      "condition": "仅：object.resize",
      "defaultValue": "120",
      "defaultValueRaw": 120,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scaleY",
      "name": "垂直缩放百分比",
      "type": "Number",
      "validForList": [
        "object.resize"
      ],
      "condition": "仅：object.resize",
      "defaultValue": "120",
      "defaultValueRaw": 120,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "changeLineWidths",
      "name": "线宽缩放百分比",
      "type": "Number",
      "validForList": [
        "object.resize"
      ],
      "condition": "仅：object.resize",
      "defaultValue": "120",
      "defaultValueRaw": 120,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "opacity",
      "name": "透明度（0~100）",
      "type": "Number",
      "validForList": [
        "object.set_opacity"
      ],
      "condition": "仅：object.set_opacity",
      "defaultValue": "50",
      "defaultValueRaw": 50,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "index",
      "name": "图层/画板序号（从 0 开始）",
      "type": "Number",
      "validForList": [
        "layer.activate",
        "layer.rename",
        "layer.set_visible",
        "layer.set_locked",
        "artboard.activate",
        "artboard.fit_selection"
      ],
      "condition": "仅：layer.activate, layer.rename, layer.set_visible, layer.set_locked, artboard.activate, artboard.fit_selection",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "name",
      "name": "名称",
      "type": "Text",
      "validForList": [
        "layer.create",
        "layer.rename"
      ],
      "condition": "仅：layer.create, layer.rename",
      "defaultValue": "Quicker 图层",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "text",
      "name": "文本",
      "type": "Text",
      "validForList": [
        "text.create"
      ],
      "condition": "仅：text.create",
      "defaultValue": "Quicker 文本",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "positionJson",
      "name": "位置（JSON）",
      "type": "Text",
      "validForList": [
        "text.create"
      ],
      "condition": "仅：text.create",
      "defaultValue": "[100,100]",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "fontSize",
      "name": "字号",
      "type": "Number",
      "validForList": [
        "text.create"
      ],
      "condition": "仅：text.create",
      "defaultValue": "24",
      "defaultValueRaw": 24,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "findText",
      "name": "查找文本",
      "type": "Text",
      "validForList": [
        "text.replace"
      ],
      "condition": "仅：text.replace",
      "defaultValue": "旧文字",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "replaceText",
      "name": "替换为",
      "type": "Text",
      "validForList": [
        "text.replace"
      ],
      "condition": "仅：text.replace",
      "defaultValue": "新文字",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "menuCommand",
      "name": "菜单命令字符串",
      "type": "Text",
      "validForList": [
        "menu.execute"
      ],
      "condition": "仅：menu.execute",
      "defaultValue": "Fit Artboard to selected Art",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scriptCode",
      "name": "ExtendScript 代码",
      "type": "Text",
      "validForList": [
        "script.evaluate"
      ],
      "condition": "仅：script.evaluate",
      "defaultValue": "app.documents.length",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "scriptFilePath",
      "name": "JSX 文件路径",
      "type": "Text",
      "validForList": [
        "script.run_file"
      ],
      "condition": "仅：script.run_file",
      "defaultValue": "T:\\TEMP\\illustrator-script.jsx",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandName",
      "name": "Bridge 命令名称",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "argumentsJson",
      "name": "参数（JSON 对象）",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitMs",
      "name": "最长等待时间(ms)",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "30000",
      "defaultValueRaw": 30000,
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "output",
      "name": "命令结果",
      "type": "Text"
    }
  ],
