{
  "key": "sys:numberprocess",
  "slug": "numberprocess",
  "legacySlug": "numberprocess",
  "ownsLegacyContent": true,
  "name": "数字转换与处理",
  "description": "数字转换为文本等相关处理",
  "category": "Compute",
