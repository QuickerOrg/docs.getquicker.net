{
  "key": "sys:whiteboard",
  "slug": "whiteboard",
  "legacySlug": "whiteboard",
  "ownsLegacyContent": true,
  "name": "手写板",
  "description": "手写内容，生成图片对象。",
  "category": "Image",
  "categoryName": "图片处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/whiteboard",
  "inputs": [
    {
      "key": "winPosition",
      "name": "窗口位置",
      "type": "Text",
      "description": "可选。指定显示位置，格式为：left,top,right,bottom。支持像素数值或屏幕宽高百分比。",
      "defaultValue": "15%,30%,85%,70%",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bgColor",
      "name": "绘图区背景颜色",
      "type": "Text",
      "description": "绘图窗口的背景颜色。格式为#AARRGGBB",
      "defaultValue": "#FFFFFFFF",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "penColor",
      "name": "画笔颜色",
      "type": "Text",
      "description": "画笔颜色。格式为#AARRGGBB",
      "defaultValue": "#FFFF0000",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "enableTransparent",
      "name": "使用透明无边框窗口",
      "type": "Boolean",
      "description": "不显示窗口标题栏，绘图区透明，可以看到底层窗口内容。",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "imageWithBackground",
      "name": "图片包含背景内容",
      "type": "Boolean",
      "description": "使用透明窗口时，结果图片是否包含背景内容。",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "取消后停止动作",
      "type": "Boolean",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "result",
      "name": "结果图片",
      "type": "Image"
    }
  ],
  "sourceFileName": "catalog.json"
}
