{
  "key": "sys:openUrl",
  "slug": "openurl",
  "legacySlug": "openurl",
  "ownsLegacyContent": true,
  "name": "打开网址",
  "description": "打开指定的网址",
  "category": "Basic",
  "categoryName": "基础",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/openurl",
  "inputs": [
    {
      "key": "url",
      "name": "网址",
      "type": "Text",
      "description": "要打开的网页地址",
      "defaultValue": "https://",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "browser",
      "name": "浏览器",
      "type": "Enum",
      "description": "使用什么浏览器打开网址",
      "defaultValue": "default",
      "required": true,
      "variableMode": "UseVarOrInput",
      "isControlField": true
    },
    {
      "key": "exePath",
      "name": "浏览器程序路径",
      "type": "Text",
      "description": "浏览器exe程序路径",
      "validForList": [
        "custom"
      ],
      "condition": "仅：custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    }
  ],
  "selections": {
    "browser": {
      "name": "浏览器",
      "items": [
        {
          "value": "default",
          "name": "(系统默认浏览器)"
        },
        {
          "value": "iexplore.exe",
          "name": "IE浏览器"
        },
        {
          "value": "microsoft-edge:",
          "name": "Edge"
        },
        {
          "value": "msedgeApp",
          "name": "Edge App模式"
        },
        {
          "value": "msedgeIncognito",
          "name": "Edge InPrivate窗口"
        },
        {
          "value": "chrome",
          "name": "Chrome"
        },
        {
          "value": "chromeApp",
          "name": "Chrome App模式"
        },
        {
          "value": "chromeIncognito",
          "name": "Chrome 无痕窗口"
        },
        {
          "value": "local",
          "name": "本地浏览器窗口"
        },
        {
          "value": "custom",
          "name": "*自定义浏览器程序*"
        },
        {
          "value": "current",
          "name": "*前台浏览器程序*"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
