{
  "code": "3dfd19f5-7e33-4864-5286-08da4e691004",
  "title": "参数传递CAD命令",
  "description": "从参数传递要执行的命令，方便在轮盘等触发方式中使用",
  "author": "CL",
  "revision": 1,
  "source": "https://getquicker.net/sharedaction?code=3dfd19f5-7e33-4864-5286-08da4e691004",
  "pulledAt": "2026-08-11T21:27:56.433Z",
  "variables": [
    {
      "name": "text",
      "type": "Text",
      "remark": "默认的文本变量"
    }
  ],
  "steps": [
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$= string.IsNullOrEmpty({quicker_in_param})"
      },
      "ifSteps": [
        {
          "key": "sys:stop",
          "inputs": {
            "method": "default",
            "isError": "0",
            "showMessage": "请运行动作并将CAD命令作为参数传入"
          }
        }
      ]
    },
    {
      "key": "sys:autocadcontrol",
      "inputs": {
        "operation": "SendCommand",
        "command": "{quicker_in_param}",
        "waitResp": "true",
        "stopIfFail": "1"
      }
    },
    {
      "key": "sys:notify",
      "inputs": {
        "msg": "done",
        "maxLines": "0",
        "type": "Info",
        "style": "Default"
      },
      "disabled": true
    }
  ]
}
