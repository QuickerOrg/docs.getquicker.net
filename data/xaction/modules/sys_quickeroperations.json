{
  "key": "sys:quickeroperations",
  "slug": "quickeroperations",
  "legacySlug": "quickeroperations",
  "ownsLegacyContent": true,
  "name": "Quicker操作",
  "description": "调用Quicker的某个功能",
  "category": "System",
  "categoryName": "Windows系统",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/quickeroperations",
  "inputs": [
    {
      "key": "type",
      "name": "类型",
      "type": "Enum",
      "description": "操作类型",
      "defaultValue": "showPanel",
      "required": true,
      "variableMode": "UseVarOrInput",
      "isControlField": true
    },
    {
      "key": "profileId",
      "name": "动作页ID",
      "type": "Text",
      "description": "请在场景与动作管理中，查看动作页信息获取ID。",
      "validForList": [
        "loadProfile"
      ],
      "condition": "仅：loadProfile",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "actionId",
      "name": "动作ID或名称",
      "type": "Text",
      "description": "在动作上点右键->信息可以查看动作信息。使用名称时不能有重名动作。获取动作信息时仅可填写动作Id。编辑动作时，使用%%id或%%name格式，可用于编辑公共子程序。",
      "validForList": [
        "editAction",
        "SearchWithCertainAction",
        "FloatAction",
        "GetActionInfo"
      ],
      "condition": "仅：editAction, SearchWithCertainAction, FloatAction, GetActionInfo",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "position",
      "name": "位置",
      "type": "Text",
      "description": "坐标，格式为：left,top",
      "validForList": [
        "FloatAction"
      ],
      "condition": "仅：FloatAction",
      "defaultValue": "200,200",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "exe",
      "name": "场景标识",
      "type": "Text",
      "description": "场景关联的exe文件名。请参考场景与动作管理窗口左侧应用列表；打开轮盘或场景管理时可填写 _curr 表示当前程序场景。",
      "validForList": [
        "showCircleMenu",
        "showDashboardWindow",
        "showExeSettingWindow",
        "loadExeProfiles",
        "loadExeProfilesNoLock",
        "GetActionList"
      ],
      "condition": "仅：showCircleMenu, showDashboardWindow, showExeSettingWindow, loadExeProfiles, loadExeProfilesNoLock, GetActionList",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "sceneGroup",
      "name": "切换到分组",
      "type": "Text",
      "description": "加载场景后，在新版面板中自动切换到此分组。留空时按场景默认逻辑显示；填写“未分组”可切换到未分组。",
      "validForList": [
        "loadExeProfiles",
        "loadExeProfilesNoLock"
      ],
      "condition": "仅：loadExeProfiles, loadExeProfilesNoLock",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "activatePointWindow",
      "name": "自动激活鼠标位置窗口",
      "type": "Boolean",
      "validForList": [
        "showPanel"
      ],
      "condition": "仅：showPanel",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "followMousePosition",
      "name": "跟随鼠标位置",
      "type": "Boolean",
      "validForList": [
        "showPanel"
      ],
      "condition": "仅：showPanel",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "searchText",
      "name": "预置的搜索内容",
      "type": "Text",
      "description": "预先放入搜索框的内容",
      "validForList": [
        "showSearch",
        "StartSearchWithAction",
        "SearchWithCertainAction"
      ],
      "condition": "仅：showSearch, StartSearchWithAction, SearchWithCertainAction",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "skinId",
      "name": "外观ID",
      "type": "Text",
      "description": "请在外观网页中复制外观ID",
      "validForList": [
        "LoadSkin"
      ],
      "condition": "仅：LoadSkin",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "theme",
      "name": "主题模式",
      "type": "Enum",
      "description": "可选切换为浅色或暗色模式",
      "validForList": [
        "LoadSkin"
      ],
      "condition": "仅：LoadSkin",
      "defaultValue": "",
      "variableMode": "Input"
    },
    {
      "key": "viewMode",
      "name": "显示状态",
      "type": "Enum",
      "validForList": [
        "ToggleFloatButtons"
      ],
      "condition": "仅：ToggleFloatButtons",
      "defaultValue": "ByProcess",
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "步骤是否成功",
      "type": "Boolean",
      "description": "步骤是否成功完成"
    },
    {
      "key": "actionList",
      "name": "动作列表",
      "type": "List",
      "validForList": [
        "GetActionList"
      ],
      "condition": "仅：GetActionList"
    },
    {
      "key": "actionTitle",
      "name": "动作标题",
      "type": "Text",
      "validForList": [
        "GetActionInfo"
      ],
      "condition": "仅：GetActionInfo"
    },
    {
      "key": "actionIcon",
      "name": "动作图标",
      "type": "Text",
      "validForList": [
        "GetActionInfo"
      ],
      "condition": "仅：GetActionInfo"
    },
    {
      "key": "actionDescription",
      "name": "动作描述",
      "type": "Text",
      "validForList": [
        "GetActionInfo"
      ],
      "condition": "仅：GetActionInfo"
    },
    {
      "key": "windowHandle",
      "name": "窗口句柄",
      "type": "Integer",
      "validForList": [
        "FloatAction"
      ],
      "condition": "仅：FloatAction"
    },
    {
      "key": "contextMenuData",
      "name": "右键菜单数据",
      "type": "Text",
      "description": "动作配置中的右键菜单原始文本；未配置时输出空文本。",
      "validForList": [
        "GetActionInfo"
      ],
      "condition": "仅：GetActionInfo"
    }
  ],
