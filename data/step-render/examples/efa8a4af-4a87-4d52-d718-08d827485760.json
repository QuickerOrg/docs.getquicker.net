{
  "code": "efa8a4af-4a87-4d52-d718-08d827485760",
  "title": "用Excel打开",
  "description": "选择一个或多个excel文件使用Quicker的excel模块打开，从而可以在Quicker中控制该文件。不选择",
  "author": "CL",
  "revision": 0,
  "source": "https://getquicker.net/sharedaction?code=efa8a4af-4a87-4d52-d718-08d827485760",
  "pulledAt": "2026-08-11T21:27:56.133Z",
  "variables": [
    {
      "name": "filePath",
      "type": "Text",
      "remark": "一个文件的路径"
    },
    {
      "name": "isSuccess",
      "type": "Boolean"
    },
    {
      "name": "files",
      "type": "List",
      "remark": "选择的文件列表"
    },
    {
      "name": "isOpened",
      "type": "Boolean",
      "remark": "是否打开了文件"
    }
  ],
  "steps": [
    {
      "key": "sys:getSelectedFiles",
      "inputs": {
        "stopIfFail": "0"
      },
      "outputs": {
        "files": "files",
        "firstFile": "filePath",
        "isSuccess": "isSuccess"
      }
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "获取选择的文件，如果有的话，依次打开"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "{isSuccess}"
      },
      "ifSteps": [
        {
          "key": "sys:each",
          "inputs": {
            "input": "{files}",
            "useMultiThread": "0",
            "threadDelay": "5"
          },
          "outputs": {
            "item": "filePath"
          },
          "ifSteps": [
            {
              "key": "sys:simpleIf",
              "inputs": {
                "condition": "$= {filePath}.ToLower().EndsWith(\".xlsx\") || {filePath}.ToLower().EndsWith(\".xls\")"
              },
              "ifSteps": [
                {
                  "key": "sys:excelObjects",
                  "inputs": {
                    "operation": "OpenFile",
                    "path": "{filePath}",
                    "stopIfFail": "1"
                  }
                },
                {
                  "key": "sys:assign",
                  "inputs": {
                    "input": "true"
                  },
                  "outputs": {
                    "output": "isOpened"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "sys:comment",
      "inputs": {
        "note": "如果没有打开任何文件，则创建一个"
      }
    },
    {
      "key": "sys:simpleIf",
      "inputs": {
        "condition": "$= !{isOpened}"
      },
      "ifSteps": [
        {
          "key": "sys:excelObjects",
          "inputs": {
            "operation": "CreateWorkbook",
            "stopIfFail": "1"
          }
        }
      ]
    }
  ]
}
