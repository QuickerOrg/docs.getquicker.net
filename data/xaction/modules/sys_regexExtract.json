{
  "key": "sys:regexExtract",
  "slug": "regexextract",
  "legacySlug": "regexextract",
  "ownsLegacyContent": true,
  "name": "正则提取",
  "description": "使用正则表达式提取指定内容",
  "category": "Text",
  "categoryName": "文本处理",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/regexextract",
  "inputs": [
    {
      "key": "getGroup",
      "name": "提取方式",
      "type": "Enum",
      "description": "输出的内容根据提取内容有所不同，请参考模块文档。",
      "defaultValue": "0",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "data",
      "name": "输入",
      "type": "Text",
      "description": "要提取内容的文本",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "pattern",
      "name": "正则表达式",
      "type": "Text",
      "description": "用于提取内容的正则表达式",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "ignoreCase",
      "name": "忽略大小写",
      "type": "Boolean",
      "description": "不区分英文大小写",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "singleLine",
      "name": "单行模式",
      "type": "Boolean",
      "description": "此模式下\".\"能匹配任意字符，包括换行符。(否则匹配除了\\n外的任意字符)",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "multiLine",
      "name": "多行模式",
      "type": "Boolean",
      "description": "此模式下^和$可以分别匹配行首和行尾。(否则匹配输入内容的开始和结束)",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "rightToLeft",
      "name": "从右向左",
      "type": "Boolean",
      "description": "从右向左查找匹配内容",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "stopIfFail",
      "name": "失败后中止动作",
      "type": "Boolean",
      "description": "操作失败后，是否停止后续动作的执行。",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "是否匹配成功"
    },
    {
      "key": "matches",
      "name": "所有匹配列表",
      "type": "List",
      "description": "返回所有的匹配项"
    },
    {
      "key": "match1 ",
      "name": "匹配1",
      "type": "Any",
      "description": "第1个匹配项的值"
    },
    {
      "key": "match2 ",
      "name": "匹配2",
      "type": "Any",
      "description": "第2个匹配项的值"
    },
    {
      "key": "match3 ",
      "name": "匹配3",
      "type": "Any",
      "description": "第3个匹配项的值"
    },
    {
      "key": "match4 ",
      "name": "匹配4",
      "type": "Any",
      "description": "第4个匹配项的值"
    },
    {
      "key": "match5 ",
      "name": "匹配5",
      "type": "Any",
      "description": "第5个匹配项的值"
    },
    {
      "key": "matchObj",
      "name": "Match对象",
      "type": "Object",
      "description": "首个匹配的原始的C#语言Match对象，可以在表达式中使用",
      "validForList": [
        "1"
      ],
      "condition": "仅：1"
    },
    {
      "key": "matchesCollection",
      "name": "Matches集合",
      "type": "Object",
      "description": "所有匹配的原始Match对象集合(MatchCollection)，可以在表达式中使用",
      "validForList": [
        "0",
        "2"
      ],
      "condition": "仅：0, 2"
    }
  ],
  "selections": {
    "getGroup": {
      "name": "提取方式",
      "items": [
        {
          "value": "0",
          "name": "各匹配项的值"
        },
        {
          "value": "1",
          "name": "第一个匹配项的组"
        },
        {
          "value": "2",
          "name": "各匹配项的组"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
