    {
      "key": "caretPosition",
      "name": "光标位置",
      "type": "Integer",
      "description": "插入符所在字符序号",
      "validForList": [
        "WAIT",
        "CLOSE_WINDOW",
        "GET_WIN_INFO"
      ],
      "condition": "仅：WAIT, CLOSE_WINDOW, GET_WIN_INFO"
    },
    {
      "key": "windowPosition",
      "name": "窗口位置",
      "type": "Text",
      "description": "窗口的最终显示位置",
      "validForList": [
        "WAIT",
        "CLOSE_WINDOW",
        "GET_WIN_INFO"
      ],
      "condition": "仅：WAIT, CLOSE_WINDOW, GET_WIN_INFO"
    },
    {
      "key": "isWindowExists",
      "name": "窗口是否存在",
      "type": "Boolean",
      "validForList": [
        "GET_WIN_INFO"
      ],
      "condition": "仅：GET_WIN_INFO"
    },
    {
      "key": "allWindows",
      "name": "所有窗口",
      "type": "Dict",
      "description": "词典类型，key为窗口的句柄，value为窗口的标识。获取全部窗口时，为了安全，仅限自己开发的动作使用。",
      "validForList": [
        "GET_ALL_WINDOWS",
        "GET_ACTION_WINDOWS"
      ],
      "condition": "仅：GET_ALL_WINDOWS, GET_ACTION_WINDOWS"
    }
