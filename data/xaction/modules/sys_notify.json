{
  "key": "sys:notify",
  "slug": "notify",
  "legacySlug": "notify",
  "ownsLegacyContent": true,
  "name": "提示消息",
  "description": "显示可以自动消失的消息提示。",
  "category": "Basic",
  "categoryName": "基础",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/notify",
  "inputs": [
    {
      "key": "type",
      "name": "类型",
      "type": "Enum",
      "description": "消息的类型",
      "defaultValue": "Info",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "msg",
      "name": "消息内容",
      "type": "Text",
      "description": "显示的消息内容",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "title",
      "name": "标题",
      "type": "Text",
      "description": "留空使用动作名称，填写 - 不显示标题，其他内容原样显示",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "placement",
      "name": "显示位置",
      "type": "Enum",
      "validForList": [
        "Success",
        "Info",
        "Warning",
        "Error"
      ],
      "condition": "仅：Success, Info, Warning, Error",
      "defaultValue": "BottomCenter",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxLines",
      "name": "最大行数",
      "type": "Integer",
      "description": "显示内容的最大行数，0表示不限",
      "isAdvanced": true,
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "durationSeconds",
      "name": "保持秒数",
      "type": "Integer",
      "description": "0 使用默认时长，-1 持续显示，或填写 1 到 30 秒",
      "isAdvanced": true,
      "validForList": [
        "Success",
        "Info",
        "Warning",
        "Error"
      ],
      "condition": "仅：Success, Info, Warning, Error",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "showTime",
      "name": "显示时间",
      "type": "Boolean",
      "description": "有标题时，在通知右上方显示消息发出时间；无标题的紧凑通知不显示时间。",
      "isAdvanced": true,
      "validForList": [
        "Success",
        "Info",
        "Warning",
        "Error"
      ],
      "condition": "仅：Success, Info, Warning, Error",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "duplicate",
      "name": "重复控制",
      "type": "Text",
      "description": "留空时每次显示新通知。填写标识可复用同一通知：replace:标识 替换内容，count:标识 累计次数，ignore:标识 忽略后续重复；省略模式时按 replace 处理。",
      "isAdvanced": true,
      "validForList": [
        "Success",
        "Info",
        "Warning",
        "Error"
      ],
      "condition": "仅：Success, Info, Warning, Error",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "clickAction",
      "name": "点击操作",
      "type": "Text",
      "description": "普通文本表示整卡点击命令；以 @button 或 @buttons 独立首行开头时定义一到两个按钮。留空时点击复制正文。",
      "isAdvanced": true,
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    }
  ],
