{
  "key": "sys:mouse",
  "slug": "mouse",
  "legacySlug": "mouse",
  "ownsLegacyContent": true,
  "name": "鼠标输入",
  "description": "模拟鼠标输入",
  "category": "Basic",
  "categoryName": "基础",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/mouse",
  "inputs": [
    {
      "key": "type",
      "name": "类型",
      "type": "Enum",
      "description": "操作类型",
      "defaultValue": "restore",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "hWnd",
      "name": "窗口句柄",
      "type": "Integer",
      "description": "目标窗口的句柄。留空或 0 表示操作前台窗口。",
      "validForList": [
        "toWinTL",
        "toWinTR",
        "toWinBL",
        "toWinBR",
        "toWinCenter",
        "moveToWinXy"
      ],
      "condition": "仅：toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, moveToWinXy",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "btn",
      "name": "按钮",
      "type": "Enum",
      "description": "操作哪个按钮",
      "validForList": [
        "click",
        "dbclick",
        "down",
        "up"
      ],
      "condition": "仅：click, dbclick, down, up",
      "defaultValue": "left",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "bmp",
      "name": "位图路径",
      "type": "Text",
      "description": "需要在屏幕中查找的位图路径。位图必须和屏幕图像完全匹配，不能压缩。此时X、Y的值为相对于搜索位图的左上角的偏移。",
      "validForList": [
        "locateByBitmap"
      ],
      "condition": "仅：locateByBitmap",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bmpVar",
      "name": "位图变量",
      "type": "Image",
      "description": "需要在屏幕中查找的位图。位图必须和屏幕图像完全匹配，不能压缩。此时X、Y的值为相对于搜索位图的左上角的偏移。",
      "validForList": [
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmapVar",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVar"
    },
    {
      "key": "bmpTargetType",
      "name": "查找范围",
      "type": "Enum",
      "description": "位图查找范围",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "defaultValue": "MainScreen",
      "variableMode": "Input"
    },
    {
      "key": "searchRect",
      "name": "查找坐标范围",
      "type": "Text",
      "description": "当\"查找范围\"为\"坐标范围\"时有效，格式为：left,top,right,bottom",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "visibleWhen": {
        "kind": "All",
        "conditions": [
          {
            "kind": "Field",
            "fieldKey": "type",
            "operator": "In",
            "values": [
              "locateByBitmap",
              "locateByBitmapVar"
            ]
          },
          {
            "kind": "Field",
            "fieldKey": "bmpTargetType",
            "operator": "In",
            "values": [
              "Rect"
            ]
          }
        ]
      },
      "condition": "(type 为 \"locateByBitmap\"、\"locateByBitmapVar\" 且 bmpTargetType 为 \"Rect\")",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "bmpPosition",
      "name": "定位位置",
      "type": "Enum",
      "description": "查找到图片后，鼠标指针移动到的位置",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "defaultValue": "Center",
      "variableMode": "Input"
    },
    {
      "key": "bmpColorError",
      "name": "颜色容差",
      "type": "Integer",
      "description": "匹配像素时允许每个颜色通道的偏差值0-100，0表示精确匹配，速度最快。",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "defaultValue": "10",
      "defaultValueRaw": 10,
      "variableMode": "Input"
    },
    {
      "key": "maxFindCount",
      "name": "最大匹配数量",
      "type": "Integer",
      "description": "找图的最大匹配数量。将对每个查找到的目标执行附加动作。",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "Input"
    },
    {
      "key": "retryCount",
      "name": "重试次数",
      "type": "Integer",
      "description": "未找到位图时的重试次数。每次重试间隔300ms。",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "defaultValue": "1",
      "defaultValueRaw": 1,
      "variableMode": "Input"
    },
    {
      "key": "x",
      "name": "X",
      "type": "Integer",
      "description": "水平方向的坐标/坐标偏移/移动距离(像素) 或 滚动数量（clicks。正值向右，负值向左）",
      "validForList": [
        "move",
        "moveTo",
        "scroll",
        "toWinTL",
        "toWinTR",
        "toWinBL",
        "toWinBR",
        "toWinCenter",
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：move, moveTo, scroll, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "y",
      "name": "Y",
      "type": "Integer",
      "description": "垂直方向的坐标/坐标偏移/移动距离 或 滚动数量（clicks。正值向前，负值向后）",
      "validForList": [
        "move",
        "moveTo",
        "scroll",
        "toWinTL",
        "toWinTR",
        "toWinBL",
        "toWinBR",
        "toWinCenter",
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：move, moveTo, scroll, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar",
      "defaultValue": "0",
      "defaultValueRaw": 0,
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "xy",
      "name": "坐标",
      "type": "Text",
      "description": "格式为：x,y，如：100,200。也可以使用百分比表示，如：50%,50% 表示屏幕中心。",
      "validForList": [
        "moveToXy"
      ],
      "condition": "仅：moveToXy",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "xyForWin",
      "name": "相对坐标",
      "type": "Text",
      "description": "格式为：x,y，如：100,200（相对于窗口左上角向右100，向下200）。也可以使用百分比表示，如：50%,50% 表示窗口中心。",
      "validForList": [
        "moveToWinXy"
      ],
      "condition": "仅：moveToWinXy",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "slowMove",
      "name": "逐渐移动到目标",
      "type": "Boolean",
      "description": "逐渐移动而不是直接移动到目标位置。",
      "validForList": [
        "move",
        "moveTo",
        "toWinTL",
        "toWinTR",
        "toWinBL",
        "toWinBR",
        "toWinCenter",
        "locateByBitmap",
        "locateByBitmapVar",
        "moveToXy",
        "moveToWinXy"
      ],
      "condition": "仅：move, moveTo, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar, moveToXy, moveToWinXy",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "extAction",
      "name": "移动后操作",
      "type": "Enum",
      "description": "移动位置后，需要执行的动作",
      "validForList": [
        "restore",
        "move",
        "moveTo",
        "toWinTL",
        "toWinTR",
        "toWinBL",
        "toWinBR",
        "toWinCenter",
        "locateByBitmap",
        "locateByBitmapVar",
        "moveToXy",
        "moveToWinXy"
      ],
      "condition": "仅：restore, move, moveTo, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar, moveToXy, moveToWinXy",
      "defaultValue": "none",
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "restoreMousePos",
      "name": "操作完成后恢复鼠标位置",
      "type": "Boolean",
      "validForList": [
        "move",
        "moveTo",
        "toWinTL",
        "toWinTR",
        "toWinBL",
        "toWinBR",
        "toWinCenter",
        "locateByBitmap",
        "locateByBitmapVar",
        "moveToXy",
        "moveToWinXy"
      ],
      "condition": "仅：move, moveTo, toWinTL, toWinTR, toWinBL, toWinBR, toWinCenter, locateByBitmap, locateByBitmapVar, moveToXy, moveToWinXy",
      "defaultValue": "false",
      "defaultValueRaw": false,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后中止动作",
      "type": "Boolean",
      "description": "获取位置失败后，是否停止后续动作的执行。",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmap, locateByBitmapVar",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "找图定位是否成功",
      "type": "Boolean",
      "description": "操作是否成功",
      "validForList": [
        "locateByBitmap",
        "locateByBitmapVar"
      ],
      "condition": "仅：locateByBitmap, locateByBitmapVar"
    },
    {
      "key": "mouseLocation",
      "name": "鼠标位置",
      "type": "Text",
      "description": "格式为X,Y的文本",
      "validForList": [
        "getMouseCurrentPosition",
        "getMouseOriginPosition"
      ],
      "condition": "仅：getMouseCurrentPosition, getMouseOriginPosition"
    },
    {
      "key": "mouseX",
      "name": "鼠标位置X",
      "type": "Integer",
      "description": "鼠标位置X坐标",
      "validForList": [
        "getMouseCurrentPosition",
        "getMouseOriginPosition"
      ],
      "condition": "仅：getMouseCurrentPosition, getMouseOriginPosition"
    },
    {
      "key": "mouseY",
      "name": "鼠标位置Y",
      "type": "Integer",
      "description": "鼠标位置Y坐标",
      "validForList": [
        "getMouseCurrentPosition",
        "getMouseOriginPosition"
      ],
      "condition": "仅：getMouseCurrentPosition, getMouseOriginPosition"
    },
    {
      "key": "cursorType",
      "name": "光标类型",
      "type": "Text",
      "description": "当前的鼠标指针形状类型",
      "validForList": [
        "getMouseCurrentPosition"
      ],
      "condition": "仅：getMouseCurrentPosition"
    }
  ],
