{
  "key": "sys:blendercontrol",
  "slug": "blendercontrol",
  "legacySlug": "blendercontrol",
  "ownsLegacyContent": true,
  "name": "Blender控制",
  "description": "通过 Blender Python Extension 发送命令；仅有一个在线连接时直接使用，多个连接时按动作触发窗口定位。",
  "category": "SoftInteraction",
  "categoryName": "第三方软件交互",
  "stepType": "Action",
  "helpLink": "https://docs.getquicker.net/v2/xaction/modules/blendercontrol",
  "inputs": [
    {
      "key": "operation",
      "name": "操作类型",
      "type": "Enum",
      "defaultValue": "model.get_context",
      "required": true,
      "variableMode": "Input",
      "isControlField": true
    },
    {
      "key": "includeDetails",
      "name": "返回对象变换与集合信息",
      "type": "Boolean",
      "validForList": [
        "selection.get_info"
      ],
      "condition": "仅：selection.get_info",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    },
    {
      "key": "operatorQuery",
      "name": "搜索内容",
      "type": "Text",
      "description": "按 Operator ID 或本地标题筛选；留空返回前若干项。",
      "validForList": [
        "operator.list"
      ],
      "condition": "仅：operator.list",
      "defaultValue": "",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "maxCount",
      "name": "最多返回数量",
      "type": "Integer",
      "validForList": [
        "operator.list"
      ],
      "condition": "仅：operator.list",
      "defaultValue": "100",
      "defaultValueRaw": 100,
      "variableMode": "Input"
    },
    {
      "key": "operatorId",
      "name": "Operator ID",
      "type": "Text",
      "description": "例如 object.select_all；也可填写第三方插件注册的 Operator。",
      "validForList": [
        "operator.invoke"
      ],
      "condition": "仅：operator.invoke",
      "defaultValue": "object.select_all",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "executionContext",
      "name": "执行上下文",
      "type": "Text",
      "description": "通常使用 EXEC_DEFAULT；需要交互操作时可改为 INVOKE_DEFAULT。",
      "validForList": [
        "operator.invoke"
      ],
      "condition": "仅：operator.invoke",
      "defaultValue": "EXEC_DEFAULT",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "operatorAreaType",
      "name": "界面区域类型",
      "type": "Text",
      "description": "为依赖界面上下文的 Operator 提供区域，例如 VIEW_3D、NODE_EDITOR；留空仅提供窗口上下文。",
      "validForList": [
        "operator.invoke"
      ],
      "condition": "仅：operator.invoke",
      "defaultValue": "VIEW_3D",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "operatorPropertiesJson",
      "name": "Operator 参数(JSON 对象)",
      "type": "Text",
      "validForList": [
        "operator.invoke"
      ],
      "condition": "仅：operator.invoke",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "pythonCode",
      "name": "Python 代码",
      "type": "Text",
      "description": "表达式直接返回值；脚本可把返回值赋给 result。",
      "validForList": [
        "python.evaluate",
        "python.execute"
      ],
      "condition": "仅：python.evaluate, python.execute",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "filePath",
      "name": "文件路径",
      "type": "Text",
      "description": "Python 文件或要导入的模型文件绝对路径。",
      "validForList": [
        "python.run_file",
        "model.import_file"
      ],
      "condition": "仅：python.run_file, model.import_file",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "commandName",
      "name": "Bridge 命令名称",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "",
      "required": true,
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "argumentsJson",
      "name": "参数(JSON 对象)",
      "type": "Text",
      "validForList": [
        "command.custom"
      ],
      "condition": "仅：command.custom",
      "defaultValue": "{}",
      "variableMode": "UseVarOrInput"
    },
    {
      "key": "waitMs",
      "name": "最长等待时间(ms)",
      "type": "Number",
      "isAdvanced": true,
      "defaultValue": "30000",
      "defaultValueRaw": 30000,
      "required": true,
      "variableMode": "Input"
    },
    {
      "key": "stopIfFail",
      "name": "失败后停止",
      "type": "Boolean",
      "description": "失败后是否停止动作",
      "defaultValue": "true",
      "defaultValueRaw": true,
      "variableMode": "Input"
    }
  ],
  "outputs": [
    {
      "key": "isSuccess",
      "name": "是否成功",
      "type": "Boolean",
      "description": "操作是否成功"
    },
    {
      "key": "output",
      "name": "命令结果",
      "type": "Text",
      "description": "Blender 返回的 JSON 结果。"
    }
  ],
  "selections": {
    "operation": {
      "name": "操作类型",
      "items": [
        {
          "value": "bridge.ping",
          "name": "[Bridge] 测试连接"
        },
        {
          "value": "model.get_context",
          "name": "[工程] 读取当前工程上下文"
        },
        {
          "value": "selection.get_info",
          "name": "[选择] 读取选择详情"
        },
        {
          "value": "selection.select_all",
          "name": "[选择] 全选对象"
        },
        {
          "value": "selection.clear",
          "name": "[选择] 清空选择"
        },
        {
          "value": "operator.list",
          "name": "[操作器] 搜索 Blender Operator"
        },
        {
          "value": "operator.invoke",
          "name": "[操作器] 调用任意 Blender Operator"
        },
        {
          "value": "python.evaluate",
          "name": "[脚本] 计算任意 Python 表达式"
        },
        {
          "value": "python.execute",
          "name": "[脚本] 执行任意 Python 脚本"
        },
        {
          "value": "python.run_file",
          "name": "[脚本] 运行 Python 文件"
        },
        {
          "value": "model.import_file",
          "name": "[文件] 导入模型文件"
        },
        {
          "value": "command.custom",
          "name": "[高级] 发送自定义 Bridge 命令"
        }
      ]
    }
  },
  "sourceFileName": "catalog.json"
}
