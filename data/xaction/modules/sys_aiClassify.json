        },
        {
          "value": "low",
          "name": "Low · 低"
        },
        {
          "value": "medium",
          "name": "Medium · 中"
        },
        {
          "value": "high",
          "name": "High · 高"
        },
        {
          "value": "xhigh",
          "name": "Extra · 极高"
        },
        {
          "value": "max",
          "name": "Max · 最强"
        }
      ]
    },
    "useCaseId": {
      "name": "AI 任务场景",
      "items": [
        {
          "value": "text.general",
          "name": "日常文本处理与翻译"
        }
      ]
    },
    "missingUseCaseBehavior": {
      "name": "任务场景缺失时",
      "items": [
        {
          "value": "UseBaseUseCase",
